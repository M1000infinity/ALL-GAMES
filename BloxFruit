        local aH = "Teleporting"

        local aI = {}
        do
            local aJ = {}
            ac.SetNoclipObjects(aJ)
            local aK = function(inst)
                if inst ~= aC and aE(inst, "BasePart") and inst.CanCollide then
                    table.insert(aI, inst)
                    aJ[inst] = true
