			Border = rgb("#2A2D33"), BorderSoft = rgb("#1E2126"),
			Text = rgb("#FFFFFF"), Dim = rgb("#A1A6B0"), Muted = rgb("#6B7078"),
			Good = rgb("#34D399"), Warn = rgb("#FBBF24"), Bad = rgb("#FB7185"),
		},
	}

	local Theme = {}
	Theme.__index = Theme
	Theme.Themes = THEMES
	Theme.ThemeNames = {"Purple", "Midnight", "Cyan", "Rose", "Emerald", "Mono"}

	local function copy(source)
		local out = {}
		for key, value in pairs(source) do out[key] = value end
		-- chaves derivadas (existem em todos os temas)
		out.Off = out.Off or out.CardHover
		out.White = out.White or Color3.new(1, 1, 1)
		out.Transparency = out.Transparency or 0
		return out
	end

	function Theme.new(defaultName)
		local palette = copy(THEMES[defaultName or "Purple"] or THEMES.Purple)
		local self = setmetatable({
			_name = THEMES[defaultName] and defaultName or "Purple",
			_palette = palette,
			_changed = Signal.new(),
			Transparency = 0,
			AnimSpeed = 1,
		}, Theme)
		return self
	end

	function Theme:Get()
		return self._palette
	end

	function Theme:Name()
		return self._name
	end

	function Theme:Names()
		return Theme.ThemeNames
	end

	function Theme:Set(name)
		local base = THEMES[name]
		if not base then return false end
		-- preserva transparência e velocidade configuradas
		self._palette = copy(base)
		self._palette.Transparency = self.Transparency
		self._name = name
		self._changed:Fire(self._palette, name)
		return true
	end

	function Theme:SetAccent(color)
		if typeof and typeof(color) ~= "Color3" then return false end
		if type(color) ~= "userdata" and type(color) ~= "table" then return false end
		self._palette.Accent = color
		-- deriva os tons sem depender de Color3:Lerp (existe, mas é lento)
		local r, g, b = color.R, color.G, color.B
		self._palette.AccentDeep = Color3.new(r * 0.55, g * 0.55, b * 0.55)
		self._palette.AccentSoft = Color3.new(r * 0.72, g * 0.72, b * 0.72)
		self._palette.AccentGlow = Color3.new(math.min(1, r * 1.15), math.min(1, g * 1.15), math.min(1, b * 1.15))
		self._changed:Fire(self._palette, self._name)
		return true
	end

	function Theme:SetTransparency(value)
		self.Transparency = Env.Util.Clamp(tonumber(value) or 0, 0, 0.9)
		self._palette.Transparency = self.Transparency
		self._changed:Fire(self._palette, self._name)
	end

	function Theme:SetAnimSpeed(value)
		self.AnimSpeed = math.max(0, tonumber(value) or 1)
		Env.Util.AnimSpeed = self.AnimSpeed
	end

	function Theme:OnChanged(fn)
		return self._changed:Connect(fn)
	end

	return Theme
end

