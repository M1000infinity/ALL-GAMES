local SearchController = nil

local function BuildSearchController(containersHolder, searchBox)
    local resultsFrame = NewInstance("ScrollingFrame", "SearchResults", containersHolder, {
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 1),
        AnchorPoint = Vector2.new(0, 1),
        ScrollBarThickness = 2,
        BackgroundTransparency = 1,
        ScrollBarImageTransparency = 0.25,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        Visible = false,
        ThemeTag = {
            ScrollBarImageColor3 = "Colors.ScrollBar"
        },
        Elements = {
            Padding = {
                PaddingLeft   = UDim.new(0, 12),
                PaddingRight  = UDim.new(0, 12),
                PaddingTop    = UDim.new(0, 12),
                PaddingBottom = UDim.new(0, 12)
            },
            ListLayout = {
                Padding = UDim.new(0, 6)
            }
        }
    })

    local emptyLabel = NewInstance("TextLabel", resultsFrame, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 40),
        Text = "No results found.",
        TextSize = 12,
        Visible = false,
        ThemeTag = {
            TextColor3 = "Colors.Text.Darker",
            Font = "Font.Medium"
        }
    })

    local searching = false

    local function flashRow(row)
        local stroke = row:FindFirstChildOfClass("UIStroke")
        if not stroke then return end
        local highlight = ThemePath(Library.CurrentTheme, "Colors.Border.Holding")
        local normal = ThemePath(Library.CurrentTheme, "Colors.Border.Default")
        for _ = 1, 2 do
            stroke.Color = highlight
            task.wait(0.18)
            stroke.Color = normal
            task.wait(0.12)
        end
    end

    local function scrollToEntry(entry)
        local container = TabVisuals[entry.Tab].Container
        local row = entry.Row
        if not (container and row and row.Parent) then return end
        local offsetY = row.AbsolutePosition.Y - container.AbsolutePosition.Y + container.CanvasPosition.Y - 24
        container.CanvasPosition = Vector2.new(0, math.max(0, offsetY))
        task.spawn(flashRow, row)
    end

    local function exitSearchMode()
        searching = false
        resultsFrame.Visible = false
        if SelectedTab then
            TabVisuals[SelectedTab].Container.Visible = true
        end
    end

    local function enterResult(entry)
        exitSearchMode()
        searchBox.Text = ""
        entry.Tab:Select()
        task.defer(scrollToEntry, entry)
    end

    local function buildResultRow(entry)
        local row = NewInstance("TextButton", resultsFrame, {
            Size = UDim2.new(1, 0, 0, 40),
            AutoButtonColor = false,
            Text = "",
            Elements = {
                Corner = UDim.new(0, 8),
                Stroke = { ThemeTag = { Color = "Colors.Border.Default" } }
            },
            ThemeTag = {
                BackgroundColor3 = "Colors.Buttons.Default"
            },
            Childs = {
                NewInstance("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -90, 0, 16),
                    Position = UDim2.new(0, 12, 0, 5),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextSize = 11,
                    Text = entry.Title,
                    ThemeTag = {
                        TextColor3 = "Colors.Text.Default",
                        Font = "Font.Medium"
                    }
                }),
                NewInstance("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -90, 0, 13),
                    Position = UDim2.new(0, 12, 0, 21),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextSize = 9,
                    Text = (entry.Tab and entry.Tab.Title or "?") .. "  •  " .. entry.Kind,
                    ThemeTag = {
                        TextColor3 = "Colors.Text.Darker",
                        Font = "Font.Normal"
                    }
                }),
                NewInstance("ImageLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 12, 0, 12),
                    Position = UDim2.new(1, -14, 0.5, 0),
                    AnchorPoint = Vector2.new(1, 0.5),
                    Image = "rbxassetid://10734943674",
                    ImageTransparency = 0.4,
                    ThemeTag = {
                        ImageColor3 = "Colors.Icons"
                    }
                })
            }
        })

        Connect(row.MouseEnter, function()
            Tween(row, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.Buttons.Holding"), 0.12):Play()
        end)
        Connect(row.MouseLeave, function()
            Tween(row, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.Buttons.Default"), 0.16):Play()
        end)
        Connect(row.Activated, function()
            enterResult(entry)
        end)

        return entry
    end

    local function runSearch()
        local query = SanitizeSearchText(searchBox.Text)

        if #query == 0 then
            if searching then
                exitSearchMode()
            end
            return
        end

        searching = true

        for _, child in ipairs(resultsFrame:GetChildren()) do
            if child:IsA("GuiObject") and child ~= emptyLabel then
                child:Destroy()
            end
        end

        local results = 0
        for _, entry in ipairs(OptionIndex) do
            if entry.Row.Parent and (entry.SearchText:find(query, 1, true) or entry.SearchDesc:find(query, 1, true)) then
                buildResultRow(entry)
                results = results + 1
                if results >= 50 then break end
            end
        end

        emptyLabel.Visible = results == 0
        resultsFrame.CanvasPosition = Vector2.new(0, 0)
        resultsFrame.Visible = true

        if SelectedTab then
            TabVisuals[SelectedTab].Container.Visible = false
        end
    end

    Connect(searchBox:GetPropertyChangedSignal("Text"), runSearch)

    SearchController = {
        IsSearching = function() return searching end,
        Reset = exitSearchMode
    }
    return SearchController
end

