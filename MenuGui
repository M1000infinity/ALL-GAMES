		}), Button)

		comp.Callback = config.Callback
		comp.Style = config.Style or "ghost"
		comp.Disabled = config.Disabled == true

		local row = Support.Row(section.Content, hasDesc and 58 or 46, {Hover = false})
		comp.Row = row

		local surface = U.New("TextButton", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = Env.Theme:Get().Card,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		U.Corner(surface, 8)
		local surfaceStroke = U.Stroke(surface, Env.Theme:Get().Border, 1, 0.1)
		comp.Surface = surface

		local title = U.Label(surface, config.Name or "Botão", {
			Font = Enum.Font.GothamBold,
			Size = 12,
			Color = Env.Theme:Get().Text,
			Align = Enum.TextXAlignment.Center,
		})
		title.Size = UDim2.new(1, -20, 0, hasDesc and 16 or 0)
		title.Position = UDim2.new(0, 10, 0.5, hasDesc and -8 or 0)
		title.AnchorPoint = Vector2.new(0, 0.5)
		comp.Title = title

		local desc = nil
		if hasDesc then
			desc = U.Label(surface, config.Description, {
				Font = Enum.Font.Gotham,
				Size = 9,
				Color = Env.Theme:Get().Muted,
				Align = Enum.TextXAlignment.Center,
			})
			desc.Size = UDim2.new(1, -20, 0, 12)
			desc.Position = UDim2.new(0, 10, 0.5, 7)
			comp.Desc = desc
		end

		local icon = nil
		if config.Icon then
			icon = Env.Icons(config.Icon, Env.Theme:Get().AccentGlow, 14)
			icon.Position = UDim2.new(0.5, -title.TextBounds.X / 2 - 20, 0.5, -7)
			icon.Parent = surface
			comp.Icon = icon
		end

		-- posiciona o ícone à esquerda do texto centralizado
		local function placeIcon()
			if not icon then return end
			local width = title.TextBounds and title.TextBounds.X or 0
			icon.Position = UDim2.new(0.5, -(width / 2) - 22, 0.5, -7)
		end

		function comp:Paint(palette)
			if self.Style == "primary" then
				surface.BackgroundColor3 = palette.Accent
				surface.BackgroundTransparency = U.Alpha(palette, self.Disabled and 0.6 or 0)
				surfaceStroke.Color = palette.AccentGlow
				surfaceStroke.Transparency = 0.35
				title.TextColor3 = Color3.new(1, 1, 1)
				if desc then desc.TextColor3 = Color3.new(0.86, 0.84, 1) end
			else
				surface.BackgroundColor3 = palette.Card
				surface.BackgroundTransparency = U.Alpha(palette, self.Disabled and 0.5 or 0)
				surfaceStroke.Color = self.Hovered and palette.AccentSoft or palette.Border
				surfaceStroke.Transparency = self.Disabled and 0.7 or 0.1
				title.TextColor3 = self.Disabled and palette.Muted or palette.Text
				if desc then desc.TextColor3 = palette.Muted end
			end
		end

		function comp:OnClick()
			if self.Disabled or self.Enabled == false or self.Destroyed then return end
			if type(self.Callback) == "function" then
				U.SafeCall("Button(" .. tostring(self.Name) .. ")", self.Callback)
			end
		end

		function comp:Click()
			self:OnClick()
		end

		function comp:SetText(text)
			title.Text = tostring(text or "")
			placeIcon()
		end

		function comp:SetDisabled(value)
			self.Disabled = value == true
			self.Enabled = not self.Disabled
			surface.Active = not self.Disabled
			self:Paint(Env.Theme:Get())
		end

		-- mesma API dos outros componentes
		function comp:SetEnabled(value)
			self:SetDisabled(value == false)
			return self.Enabled
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		comp.Maid:Add(surface.MouseEnter:Connect(function()
			comp.Hovered = true
			comp:Paint(Env.Theme:Get())
			U.Tween(surface, 0.12, {BackgroundTransparency = U.Alpha(Env.Theme:Get(), comp.Disabled and 0.5 or 0)})
		end))
		comp.Maid:Add(surface.MouseLeave:Connect(function()
			comp.Hovered = false
			comp:Paint(Env.Theme:Get())
		end))
		surface.MouseButton1Click:Connect(function() comp:OnClick() end)
		comp.Maid:Add(surface.MouseButton1Click)

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		placeIcon()
		if config.Enabled == false then comp:SetDisabled(true) end
		section:_register(comp)
		return comp
	end

	return Button
end

