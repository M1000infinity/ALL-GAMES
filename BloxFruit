        if al(targetPart) >= 60 then return end
        local tool = C.Character and C.Character:FindFirstChildOfClass("Tool")
        if tool then
            local toolLvl = tool:GetAttribute("Level") or 0
            local reqs = au[tool.Name]
            if reqs == nil and tool:FindFirstChild("Data") then
                local ok, dataTbl = pcall(require, tool.Data)
                if ok and type(dataTbl) == "table" then
                    au[tool.Name] = dataTbl.Lvl or false
                else
                    au[tool.Name] = false
                end
                reqs = au[tool.Name]
            end

            for keyName, enabled in pairs(skillsTable) do
                if enabled then
                    local canUse = not reqs or (reqs[keyName] and toolLvl >= reqs[keyName])
                    if canUse then
                        local lastUse = at[keyName]
                        if (tick() - (lastUse or 0)) >= 0 then
                            g:SendKeyEvent(true, keyName, false, game)
                            g:SendKeyEvent(false, keyName, false, game)
                            at[keyName] = tick() + ad.SKILL_COOLDOWN
                        end
                    end
                end
            end
        end
    end

