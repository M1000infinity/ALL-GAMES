    if type(options[1]) == "table" then options = options[1] end
    for _, option in ipairs(options) do
        self.ADD_DROPDOWN_OPTION(option)
    end
end

function DropdownClass.new(parent, row, titleLabel, descLabel, callbacks)
    return setmetatable({
        CALLBACKS = callbacks,
        DESTROY_ELEMENT = row,
        VISIBLE_ELEMENT = row,
        TITLE_LABEL = titleLabel,
        DESCRIPTION_LABEL = descLabel,
        Description = descLabel.Text,
        Title = titleLabel.Text,
        Parent = parent,
        Kind = "Dropdown"
    }, DropdownClass)
end

