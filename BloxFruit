                    end
                end
            end
        end)

        ax("Translator", function(windowObj, transDict)
            local origMakeTab = windowObj.MakeTab
            local origMethods = {}
            local wrappedMethods = {}
            local warnPrefix = "⚠️ "

            local translateOption = function(optObj)
                if not optObj or not optObj.Title then return optObj end
                local title = optObj.Title
                local hasWarn = false
                if title:sub(1, #warnPrefix) == warnPrefix then
                    title = title:sub(#warnPrefix + 1, -1)
                    hasWarn = true
                end
                local trans = transDict[title]
                if trans then
                    if type(trans) == "string" then
                        optObj:SetTitle((hasWarn and warnPrefix or "") .. trans)
                        return optObj
                    end
                    if trans[1] ~= nil then
                        optObj:SetTitle((hasWarn and warnPrefix or "") .. trans[1])
                    end
                    if trans[2] ~= nil then
                        optObj:SetDesc(trans[2])
                    end
                end
                return optObj
            end

            local methodNames = { "AddSection", "AddParagraph", "AddToggle", "AddDropdown", "AddSlider", "AddButton", "AddTextBox" }

            windowObj.MakeTab = function(selfWin, tabCfg)
                local tabName = tabCfg[1] or tabCfg.Name or tabCfg.Title
                if transDict[tabName] then
                    tabCfg[1] = transDict[tabName]
                end
                local tabObj = origMakeTab(selfWin, tabCfg)
                for _, mName in ipairs(methodNames) do
                    local origMethod = tabObj[mName]
                    if type(origMethod) == "function" then
                        tabObj[mName] = function(selfTab, ...)
                            return translateOption(origMethod(selfTab, ...))
                        end
                    end
                end
                return tabObj
            end
        end)

        ax("OptionsPlugin", function(enabledOptions, optionsMap)
            local plugin = {}
            function plugin.Toggle(tabObj, cfg, flagName)
