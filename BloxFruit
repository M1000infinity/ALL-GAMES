    function window:MakeTab(tabConfig)
        local tabTitle = tabConfig[1] or tabConfig.Name or tabConfig.Title
        local tabIcon = tabConfig[2] or tabConfig.Icon or tabConfig.Image

        assert(type(tabTitle) == "string", ("\"Tab.Title\" 'string' expected, got " .. tostring(typeof(tabTitle))))
        assert(tabIcon == nil or type(tabIcon) == "string", ("\"Tab.Icon\" 'string' expected, got " .. tostring(typeof(tabIcon))))

        local tab = setmetatable({
            Selected = self.SelectedTab == #AllTabs + 1,
            Icon = Library:GetIconByName(tabIcon),
            Title = tabTitle,
            Parent = self,
            IS_A_TAB = true
        }, TabClass)

        local button, container, indicator, iconImage =
            MakeTabButton(tabsScroll, tab)
        TabIconRegistry[{ Image = iconImage, IconName = tabIcon }] = true

        local ANIM_TIME = 0.22
        local growIn = Tween(container, "Size", UDim2.new(1, 0, 1, 0), ANIM_TIME)
        local hidden = UDim2.new(1, 0, 1, 150)

        local INDICATOR_TIME = 0.24
        local selectTweens = {
            Tween(indicator, "BackgroundTransparency", 0, INDICATOR_TIME),
            Tween(indicator, "Size", UDim2.fromOffset(4, 16), INDICATOR_TIME)
        }
        local deselectTweens = {
            Tween(indicator, "BackgroundTransparency", 1, INDICATOR_TIME),
            Tween(indicator, "Size", UDim2.fromOffset(4, 5), INDICATOR_TIME)
        }

        local contentPop = NewInstance("UIScale", container, { Scale = 1 })

        local tabScope = GlobalThemeScope:new()
        TabScopes[tab] = tabScope

        local function playAll(tweens)
            for index = 1, #tweens do
                tweens[index]:Play()
            end
        end

        local function selectSelf()
            playAll(selectTweens)
            Tween(button, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.OnPrimary"), INDICATOR_TIME):Play()
            Tween(button.Title, "TextTransparency", 0, INDICATOR_TIME):Play()
            tab.Selected = true
            tabScope:changeRendering(true)
            tabScope:update()
            container.Parent = contentHolder
            container.Size = hidden
            growIn:Play()
            if Motion.Enabled then
                contentPop.Scale = 0.985
                Tween(contentPop, "Scale", 1, 0.18):Play()
            end
        end

        local function deselectSelf()
            playAll(deselectTweens)
            Tween(button, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.Buttons.Default"), INDICATOR_TIME):Play()
            Tween(button.Title, "TextTransparency", 0.3, INDICATOR_TIME):Play()
            tab.Selected = false
            container.Parent = nil
            tabScope:changeRendering(false)
        end

        TabActions[tab] = table.freeze({
            Unselect = deselectSelf,
            Select = selectSelf
        })

        TabVisuals[tab] = table.freeze({
            SelectTabButton = button,
            Container = container,
            ContentPop = contentPop
        })

        TabButtonRegistry[button] = true
        table.insert(AllTabs, tab)

        Connect(button.MouseEnter, function()
            local target = tab.Selected and "Colors.OnPrimary" or "Colors.Buttons.Holding"
            Tween(button, "BackgroundColor3", ThemePath(Library.CurrentTheme, target), 0.12):Play()
            Tween(button.Title, "TextTransparency", 0, 0.12):Play()
        end)
        Connect(button.MouseLeave, function()
            local target = tab.Selected and "Colors.OnPrimary" or "Colors.Buttons.Default"
            Tween(button, "BackgroundColor3", ThemePath(Library.CurrentTheme, target), 0.16):Play()
            Tween(button.Title, "TextTransparency", tab.Selected and 0 or 0.3, 0.16):Play()
        end)

        Connect(button.Activated, function()
            if search and search.IsSearching() then
                search.Reset()
                searchBox.Text = ""
            end
            tab:Select()
        end)

        if tab.Selected then
            tab:Select()
        end

        return tab
    end

