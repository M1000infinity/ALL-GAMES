        ax("InitializeQuests", function(questsTable, config)
            local getTasks = config.GetQuestTasks
            local lookup = config.QuestsLookup
            local questsList = config.Quests

            local bounds = ({ { 0, 700 }, { 700, 1500 }, { 1500, math.huge } })[ar.Sea] or { 0, math.huge }
            local ignored = aa({ "BartiloQuest", "MarineQuest", "CitizenQuest" }, true)

            for questGroupName, questGroup in pairs(questsTable) do
                if not ignored[questGroupName] and type(questGroup) == "table" then
                    for questIdx, questData in pairs(questGroup) do
                        local lvlReq = questData.LevelReq
