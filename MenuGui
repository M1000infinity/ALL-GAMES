-- ═══════════════════════════════════════════════════════════════════════
MODULES["ThemeManager"] = function(Env)
	local Signal = Env.Signal

	local function rgb(hex)
		return Color3.fromHex(hex)
	end

	local THEMES = {
		Purple = {
			Accent = rgb("#6A3DF5"), AccentSoft = rgb("#4C2A8F"), AccentDeep = rgb("#361BB0"),
			AccentGlow = rgb("#7B4BFF"),
			Bg = rgb("#05070F"), Panel = rgb("#080D18"), Card = rgb("#0A1020"), CardHover = rgb("#101830"),
			Border = rgb("#1F1B42"), BorderSoft = rgb("#14122E"),
