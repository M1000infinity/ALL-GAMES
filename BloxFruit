local Motion = {
    Enabled        = true,   -- master switch (UI keeps working when false)
    Speed          = 1,      -- global duration multiplier
    ReduceEffects  = false,  -- low-end mode: instant tweens + fewer gradients
    DefaultStyle   = Enum.EasingStyle.Quint
}

-- Tween(instance, property, goal, duration, easingDirection?)
-- duration==0 / animations disabled => property is applied immediately.
local function Tween(instance, property, goal, duration, ...)
    duration = (duration or 0.15) / (Motion.Speed > 0 and Motion.Speed or 1)
    if (not Motion.Enabled) or Motion.ReduceEffects or duration <= 0 then
        instance[property] = goal
        -- return a dummy tween-like object so callers can :Play() safely
        return {
            Play = function() end,
            Cancel = function() end,
            Pause = function() end,
            Completed = { Wait = function() end, Connect = function(_, f)
                if type(f) == "function" then task.defer(f) end
                return { Disconnect = function() end }
            end },
            PlaybackState = Enum.PlaybackState.Completed
        }
    end
    return TweenService:Create(instance, TweenInfo.new(duration, Motion.DefaultStyle, ...), { [property] = goal })
end

