-- NOTIFICATIONS — toasts empilhados no canto superior direito
--   local notifier = Notifications.new(parentFrame, theme)
--   notifier:Push({Title = "...", Content = "...", Duration = 4, Type = "info"})
--   notifier:Clear()
-- Tipos: info | success | warn | error
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Notifications"] = function(Env)
	local U = Env.Util

	local Notifications = {}
	Notifications.__index = Notifications

	local TYPE_COLOR = function(palette, kind)
		if kind == "success" then return palette.Good end
		if kind == "warn" then return palette.Warn end
		if kind == "error" then return palette.Bad end
		return palette.Accent
	end

	function Notifications.new(parent, width)
		local palette = Env.Theme:Get()
		local holder = U.New("Frame", {
			Name = "Notifications",
			Size = UDim2.fromOffset(width or 300, 420),
			Position = UDim2.new(1, -16, 0, 76),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = false,
			ZIndex = 400,
			Parent = parent,
		})
		U.List(holder, {Padding = 8, Align = Enum.HorizontalAlignment.Right})
		local self = setmetatable({
			Holder = holder,
			Width = width or 300,
			Maid = Env.Maid.new(),
			Items = {},
			Order = 0,
			Palette = palette,
		}, Notifications)

		-- notificações visíveis acompanham a troca de tema
		self.Maid:Add(Env.Theme:OnChanged(function(nextPalette)
			for _, item in ipairs(self.Items) do
				if item.Paint then pcall(item.Paint, nextPalette) end
			end
		end))

		return self
	end

	function Notifications:Push(config)
		config = config or {}
		local theme = Env.Theme:Get()
		local duration = tonumber(config.Duration) or 4
		self.Order = self.Order + 1

		local card = U.New("Frame", {
			Size = UDim2.new(0, self.Width, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = theme.Card,
			BackgroundTransparency = U.Alpha(theme, 0),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			LayoutOrder = self.Order,
			ZIndex = 401,
			Parent = self.Holder,
		})
		U.Corner(card, 10)
		local stroke = U.Stroke(card, theme.Border, 1, 0.1)
		U.Padding(card, 12, 12, 12, 16)

		local accent = U.New("Frame", {
			Size = UDim2.new(0, 3, 1, -16),
			Position = UDim2.fromOffset(7, 8),
			BackgroundColor3 = TYPE_COLOR(theme, config.Type),
			BorderSizePixel = 0,
			ZIndex = 402,
			Parent = card,
		})
		U.Corner(accent, 2)

		local title = U.Label(card, config.Title or "Aviso", {
			Font = Enum.Font.GothamBold,
			Size = 12,
			Color = theme.Text,
		})
		title.Size = UDim2.new(1, 0, 0, 16)
		title.ZIndex = 402

		local body = U.Label(card, config.Content or "", {
			Font = Enum.Font.Gotham,
			Size = 10,
			Color = theme.Dim,
			Wrap = true,
			Truncate = Enum.TextTruncate.None,
		})
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.ZIndex = 402

		local spacing = U.New("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			Parent = card,
		})
		spacing.AutomaticSize = Enum.AutomaticSize.Y
		spacing.ZIndex = 402
		U.List(spacing, {Padding = 2})
		title.Parent = spacing
		body.Parent = spacing

		local item = {Card = card, Closed = false}
		item.Paint = function(palette)
			if item.Closed then return end
			card.BackgroundColor3 = palette.Card
			stroke.Color = palette.Border
			title.TextColor3 = palette.Text
			body.TextColor3 = palette.Dim
			accent.BackgroundColor3 = TYPE_COLOR(palette, config.Type)
		end
		table.insert(self.Items, item)

		local function close()
			if item.Closed then return end
			item.Closed = true
			U.Tween(card, 0.16, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			U.Tween(spacing, 0.16, {Position = UDim2.fromOffset(12, 0)})
			U.Delay(0.18, function()
				if card then card:Destroy() end
				for index = #self.Items, 1, -1 do
					if self.Items[index] == item then table.remove(self.Items, index) end
				end
			end)
		end
		item.Close = close

		card.BackgroundTransparency = 1
		card.Position = UDim2.fromOffset(self.Width, 0)
		U.Tween(card, 0.22, {
			BackgroundTransparency = 0,
			Position = UDim2.fromOffset(0, 0),
		})

		-- fechar ao clicar no cartão
		local closeArea = U.New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 405,
			Parent = card,
		})
		closeArea.MouseButton1Click:Connect(close)

		if duration > 0 then
			U.Delay(duration, close)
		end

		-- limite de 5 visíveis
		while #self.Items > 5 do
			local oldest = table.remove(self.Items, 1)
			if oldest and oldest.Close then oldest.Close() end
		end

		return item
	end

	function Notifications:Clear()
		local items = self.Items
		self.Items = {}
		for _, item in ipairs(items) do
			if item.Close then item.Close() end
		end
	end

	function Notifications:Destroy()
		self:Clear()
		if self.Holder then self.Holder:Destroy() end
		self.Maid:Clean()
	end

	return Notifications
end

