function WindowClass:WriteFile(fileName, content)
    assert(type(fileName) == "string", ("\"Window.WriteFile[param 1]\". 'string' expected, got " .. tostring(typeof(fileName))))
    fileName = (tostring(self.ScriptFolder) .. "/" .. tostring(fileName))

    if content ~= nil and type(content) ~= "string" then
        error(("\"Window.WriteFile[param 2]\". 'string', or 'nil' expected, got " .. tostring(typeof(content))), 2)
    end

    if content == nil then
        if deleteFileFn ~= nil then
            deleteFileFn((tostring(self.ScriptFolder) .. "/" .. tostring(fileName)))
            return true
        end
    else
        if writeFileFn ~= nil then
            SafeWriteFile((tostring(self.ScriptFolder) .. "/" .. tostring(fileName)), content)
            return true
        end
    end

    return false
end

-- write helper that guarantees the folder chain exists (legacy helper `z`)
function SafeWriteFile(path, content)
    if makeFolderFn then
        local parts = path:split("/")
        parts[#parts] = nil
        local folder = table.concat(parts, "/")
        if folder ~= "" and (isfolder == nil or not isfolder(folder)) then
            makeFolderFn(folder)
        end
    end
    writeFileFn(path, content)
end

