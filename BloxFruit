        local aK = function(char)
            local upperTorso = aF(char, "UpperTorso")
            local hum = aF(char, "Humanoid")
            local bv = f.tween_bodyvelocity
            local targetParent = (f.OnFarm and upperTorso and hum and hum.Health > 0) and upperTorso or nil
            if aA(bv, "Parent") ~= targetParent then
