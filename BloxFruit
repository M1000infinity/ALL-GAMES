-- Insert helper: stores every event connection so Library:Destroy()
-- can release all of them at once (no leaked connections).
local LibraryConnections = {}
local function Connect(object, handler)
    table.insert(LibraryConnections, object:Connect(handler))
end

-- Callback normalizer: accepts function | nil | { table, key } sugar.
local function PackCallback(callback)
    if callback == nil then
        return { n = 0 }
    end
    if type(callback) ~= "function" and type(callback) ~= "table" then
        error(("Failed to get Callback: 'function', or 'table' expected, got " .. tostring(typeof(callback))), 2)
    end
    if type(callback) ~= "function" then
        local targetTable, targetKey = callback[1], callback[2]
        callback = function(value) targetTable[targetKey] = value end
    end
    return table.pack(callback)
end

-- Fire a packed callback list asynchronously (never blocks the UI thread).
local function FireCallbacks(packed, ...)
    for index = 1, #packed do
        task.spawn(packed[index], ...)
    end
end

-- Text sanitizer used by dropdown search and GetIconByName.
local InvalidSearchChars do
    local set = {}
    for _, ch in ipairs(string.split("\n\t,_:;()[]#&=!. \"'*^<>$")) do
        set[ch] = true
    end
    InvalidSearchChars = set
end

local function SanitizeSearchText(text)
    return string.gsub(text:lower(), ".", function(ch)
        return InvalidSearchChars[ch] and "" or ch
    end)
end

local function FormatNumberWithCommas(value)
    local str, result, counter = tostring(value), "", 0
    for index = #str, 1, -1 do
        result = str:sub(index, index) .. result
        counter = counter + 1
        if index > 1 and counter % 3 == 0 then
            result = "," .. result
        end
    end
    return result
end

local function IsAssetId(text)
    return text:sub(1, 13) == "rbxassetid://"
end

local ViewportSize = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(1366, 768)

local function ProportionalScale(scale)
    return (ViewportSize.Y / 450) * scale
end

local function FormatCountdown(seconds)
    local minutes = math.floor(seconds / 60)
    local hours   = math.floor(seconds / 60 / 60)
    seconds = math.floor((seconds - (minutes * 60)) * 10) / 10
    minutes = minutes - (hours * 60)
    if hours > 0 then
        return (tostring(hours) .. "h " .. tostring(minutes) .. "m " .. tostring(math.floor(seconds)) .. "s")
    elseif minutes > 0 then
        return (tostring(minutes) .. "m " .. tostring(math.floor(seconds)) .. "s")
    else
        return tostring(seconds)
    end
end

-- Deep copy used to spawn a *mutable* runtime theme out of a frozen preset.
local function DeepCopyTable(source)
    local copy = {}
    for key, value in pairs(source) do
        if type(value) == "table" then
            copy[key] = DeepCopyTable(value)
        else
            copy[key] = value
        end
    end
    return copy
end

local function ThemePath(root, dottedPath)
    for segment in dottedPath:gmatch("[^%.]+") do
        root = root[segment]
    end
    return root
end

