                Text = text or ""
            })
        end,
        Gradient = function(color)
            return NewInstance("UIGradient", { Color = color })
        end
    }
}

function ElementBuilders:Create(parent, elementName, ...)
    local builder = self.ElementsTable[elementName]
    if builder then
        local element = builder(...)
        element.Parent = parent
        return element
    end
end

function PropertyAppliers:Childs(children)
    for index = 1, #children do
        children[index].Parent = self
    end
end

function PropertyAppliers:Elements(elements)
    for name, props in pairs(elements) do
        if type(props) == "table" then
            local element = ElementBuilders:Create(self, name)
            if element then
                SetProperties(element, props)
            end
        else
            ElementBuilders:Create(self, name, props)
        end
    end
end

-- ThemeTag is wired in section [6] (assigned later to avoid forward refs).

function SetProperties(instance, props)
    for key, value in pairs(props) do
        if PropertyAppliers[key] then
            PropertyAppliers[key](instance, value)
        else
            instance[key] = value
        end
    end
end

function ApplyValues(instance, ...)
    for _, value in pairs({ ... }) do
        local valueType = typeof(value)
        if valueType == "table" then
            SetProperties(instance, value)
        else
            instance[valueType == "string" and "Name" or "Parent"] = value
        end
    end
    return instance
end

-- Draggable(frame, scaleRef, lerpFactor, transform?)
-- Smooth drag with scale compensation, shared busy-flag with sliders and
-- a 1s idle auto-release guard (matches the legacy behavior).
local function MakeDraggable(frame, scaleRef, lerpFactor, transform)
    local dragStart, frameStart
    local smoothing = lerpFactor or 0.28
    local lastMoveTick = 0
    local endDrag

    local function applyInput(input)
        local delta = input.Position - dragStart
        local goal
        lastMoveTick = tick()
        if transform then
            goal = transform(
                frameStart.X.Scale, frameStart.X.Offset + delta.X / scaleRef.Scale,
                frameStart.Y.Scale, frameStart.Y.Offset + delta.Y / scaleRef.Scale
            )
        else
            goal = UDim2.new(
                frameStart.X.Scale, frameStart.X.Offset + delta.X / scaleRef.Scale,
                frameStart.Y.Scale, frameStart.Y.Offset + delta.Y / scaleRef.Scale
            )
        end
        frame.Position = frame.Position:Lerp(goal, smoothing)
    end

    local function watchIdle()
        while CurrentDragTarget == frame do
            if (tick() - lastMoveTick) >= 1 then
                endDrag()
                break
            end
            task.wait()
        end
    end

    local BeginInput = {
        [Enum.UserInputType.MouseButton1] = true,
        [Enum.UserInputType.Touch] = true
    }
    local MoveInput = {
        [Enum.UserInputType.MouseMovement] = true,
        [Enum.UserInputType.Touch] = true
    }

    Connect(frame.InputBegan, function(input)
        if SharedDragBusy == false and CurrentDragTarget == nil and BeginInput[input.UserInputType] then
            dragStart = input.Position
            frameStart = frame.Position
            CurrentDragTarget = frame
            lastMoveTick = tick()
            SharedDragBusy = true

            local stateConnection
            function endDrag()
                SharedDragBusy = false
                CurrentDragTarget = nil
                stateConnection:Disconnect()
            end

            task.spawn(watchIdle)

            stateConnection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    endDrag()
                end
            end)
        end
    end)

    Connect(UserInputService.InputChanged, function(input)
        if CurrentDragTarget == frame and MoveInput[input.UserInputType] then
            applyInput(input)
        end
    end)
end

--============================================================================
-- [6] THEME BINDING (ThemeTag scopes — same semantics as the legacy system)
--============================================================================

local Library -- forward declaration (filled in section [12])

local function ApplyThemeProperty(instance, property, themeKey, scope)
    local theme = Library and Library.CurrentTheme
    if theme then
        local resolved = type(themeKey) == "function" and themeKey() or themeKey
        if type(resolved) == "string" then
            -- dotted path into the theme table (legacy contract)
            resolved = ThemePath(theme, resolved)
        end
        -- non-string results (functions returning Color3/ColorSequence/Font)
        -- are applied directly
        instance[property] = resolved
    end
end

local function ApplyThemeTag(scope, instance, tag)
    for property, themeKey in pairs(tag) do
        if property ~= "OBJECTS" then
            ApplyThemeProperty(instance, property, themeKey, scope)
        end
    end
end

local ThemeScope = {}
ThemeScope.__index = ThemeScope

function ThemeScope:add(instance, tag)
    self.Descendants[instance] = tag
    if self.IS_RENDERING then
        ApplyThemeTag(self, instance, tag)
    end
end

function ThemeScope:update()
    if self.IS_RENDERING and not self.UPDATED_OBJECTS then
        self.UPDATED_OBJECTS = true
        for target, tag in pairs(self.Descendants) do
            if typeof(target) == "table" then
                target:update()
            else
                ApplyThemeTag(self, target, tag)
            end
        end
    end
end

function ThemeScope:destroy()
    local indexInParent = self.Parent and table.find(self.Parent.Descendants, self)
    if indexInParent then
        table.remove(self.Parent.Descendants, indexInParent)
    end
    table.clear(self.Descendants)
    setmetatable(self, nil)
end

function ThemeScope:changeRendering(rendering)
    if self.IS_RENDERING ~= rendering then
        self.IS_RENDERING = rendering
        self.UPDATED_OBJECTS = false
    end
end

function ThemeScope:new()
    local scope = setmetatable({
        IS_RENDERING = true,
        UPDATED_OBJECTS = false,
        Descendants = {},
        Parent = self.Descendants ~= nil and self or nil
    }, ThemeScope)
    if self.Descendants then
        table.insert(self.Descendants, scope)
    end
    return scope
end

local GlobalThemeScope = ThemeScope:new()

-- wire the ThemeTag applier now that the scope system exists
function PropertyAppliers:ThemeTag(tag)
    local scope = tag.OBJECTS
    tag.OBJECTS = nil
    return (scope or GlobalThemeScope):add(self, tag)
end

