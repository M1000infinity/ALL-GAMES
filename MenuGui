-- ═══════════════════════════════════════════════════════════════════════
-- KEYBIND
--   Section:CreateKeybind({Name, Description, Default, Callback})
--   :SetValue(keyCode) · :GetValue() · :SetEnabled(bool) · :Destroy()
-- Clique no chip e pressione uma tecla (Esc cancela). O interruptor ao
-- lado desativa só o atalho, sem perder a tecla escolhida.
-- Nada aqui dispara teclas sozinho: só reage ao que o usuário aperta.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Keybind"] = function(Env)
	local U = Env.Util
	local Support = Env.Components.Support

	local Keybind = {}
	Keybind.__index = Keybind
	Keybind.__typename = "Keybind"

	function Keybind.new(section, config)
		config = config or {}
		local comp = setmetatable(Support.MakeComponent({
			kind = "Keybind",
			name = config.Name or "Keybind",
			description = config.Description,
			row = nil,
		}), Keybind)

		comp.Callback = config.Callback
		comp.Value = config.Default or nil
		comp.Enabled = true
		comp.Listening = false

		local row = Support.Row(section.Content, 52)
		comp.Row = row

		local title, desc, paintText = Support.Title(row, comp.Name, config.Description, 132, config.Description and 7 or 12)

		local chip = U.New("TextButton", {
			Size = UDim2.fromOffset(64, 24),
			Position = UDim2.new(1, -56, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = Env.Theme:Get().CardHover,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		U.Corner(chip, 6)
		local chipStroke = U.Stroke(chip, Env.Theme:Get().Border, 1, 0.1)
		local chipLabel = U.Label(chip, "—", {
			Font = Enum.Font.GothamBold, Size = 10, Color = Env.Theme:Get().Text,
			Align = Enum.TextXAlignment.Center,
		})
		chipLabel.Size = UDim2.fromScale(1, 1)

		-- interruptor pequeno (liga/desliga o atalho)
		local switch = U.New("TextButton", {
			Size = UDim2.fromOffset(36, 20),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = Env.Theme:Get().Accent,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		U.Corner(switch, 10)
		local knob = U.New("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(comp.Enabled and 19 or 3, 3),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = switch,
		})
		U.Corner(knob, 7)

		local function keyName()
			if comp.Listening then return "..." end
			if comp.Value then
				return tostring(comp.Value.Name or comp.Value)
			end
			return "—"
		end

		local function paint()
			chipLabel.Text = keyName()
			chip.BackgroundColor3 = comp.Listening and Env.Theme:Get().AccentSoft or Env.Theme:Get().CardHover
			switch.BackgroundColor3 = comp.Enabled and Env.Theme:Get().Accent or Env.Theme:Get().Off
			knob.Position = UDim2.fromOffset(comp.Enabled and 19 or 3, 3)
		end

		function comp:Paint(palette)
			paintText(palette)
			chip.BackgroundColor3 = self.Listening and palette.AccentSoft or palette.CardHover
			chip.BackgroundTransparency = U.Alpha(palette, 0)
			chipStroke.Color = self.Listening and palette.Accent or palette.Border
			chipLabel.TextColor3 = self.Listening and palette.AccentGlow or palette.Text
			switch.BackgroundColor3 = self.Enabled and palette.Accent or palette.Off
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
		end

		function comp:SetValue(keyCode, silent)
			if keyCode ~= nil then
				local valid = type(keyCode) == "userdata"
					or (type(keyCode) == "table" and type(keyCode.Name) == "string")
				if not valid then
					warn("[Expander] Keybind:SetValue espera um Enum.KeyCode (ou nil)")
					return self:GetValue()
				end
			end
			self.Value = keyCode
			paint()
			if not silent and type(self.Callback) == "function" then
				U.SafeCall("Keybind(" .. tostring(self.Name) .. ").Bind", self.Callback, keyCode)
			end
			return keyCode
		end

		function comp:GetValue()
			return self.Value
		end

		function comp:SetEnabled(value)
			self.Enabled = value ~= false
			paint()
		end

		function comp:IsEnabled()
			return self.Enabled
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		comp.Maid:Add(chip.MouseButton1Click:Connect(function()
			comp.Listening = not comp.Listening
			comp:Paint(Env.Theme:Get())
		end))
		comp.Maid:Add(switch.MouseButton1Click:Connect(function()
			comp.Enabled = not comp.Enabled
			comp:Paint(Env.Theme:Get())
		end))

		if U.UserInput then
			comp.Maid:Add(U.UserInput.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				if comp.Listening then
					if input.KeyCode == Enum.KeyCode.Escape then
						comp.Listening = false
						comp:Paint(Env.Theme:Get())
						return
					end
					comp.Listening = false
					comp:SetValue(input.KeyCode)
					comp:Paint(Env.Theme:Get())
					return
				end
				if comp.Enabled and comp.Value and input.KeyCode == comp.Value then
					if type(comp.Callback) == "function" then
						U.SafeCall("Keybind(" .. tostring(comp.Name) .. ")", comp.Callback, comp.Value)
					end
				end
			end))
		else
			chip.Active = false
			chipLabel.Text = "sem teclado"
		end

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		paint()
		section:_register(comp)
		return comp
	end

	return Keybind
end

-- ── módulo: ColorPicker (src/Components/ColorPicker.lua) ─────────────────
-- ═══════════════════════════════════════════════════════════════════════
-- COLOR PICKER
--   Section:CreateColorPicker({Name, Default = Color3, Callback})
--   :SetValue(color) · :GetValue() · :Destroy()
--
-- Três trilhos (matiz, saturação, brilho) + prévia. Devolve sempre um
-- Color3 novo. A conversão é feita aqui dentro (não depende de
-- Color3.toHSV/fromHSV do Luau, então funciona também em 5.1).
-- ═══════════════════════════════════════════════════════════════════════
MODULES["ColorPicker"] = function(Env)
	local U = Env.Util
	local Support = Env.Components.Support

	local ColorPicker = {}
	ColorPicker.__index = ColorPicker
	ColorPicker.__typename = "ColorPicker"

	-- HSV (0..1) -> Color3
	local function hsvToColor(h, s, v)
		if s <= 0 then
			return Color3.new(v, v, v)
		end
		h = (h % 1) * 6
		local sector = math.floor(h)
		local fraction = h - sector
		local p = v * (1 - s)
		local q = v * (1 - s * fraction)
		local t = v * (1 - s * (1 - fraction))
		if sector == 0 then return Color3.new(v, t, p) end
		if sector == 1 then return Color3.new(q, v, p) end
		if sector == 2 then return Color3.new(p, v, t) end
		if sector == 3 then return Color3.new(p, q, v) end
		if sector == 4 then return Color3.new(t, p, v) end
		return Color3.new(v, p, q)
	end

	-- Color3 -> h, s, v
	local function colorToHsv(color)
		local r, g, b = color.R, color.G, color.B
		local maximum = math.max(r, g, b)
		local minimum = math.min(r, g, b)
		local delta = maximum - minimum
		local h = 0
		if delta > 0 then
			if maximum == r then
				h = ((g - b) / delta) % 6
			elseif maximum == g then
				h = (b - r) / delta + 2
			else
				h = (r - g) / delta + 4
			end
			h = h / 6
		end
		local s = 0
		if maximum > 0 then s = delta / maximum end
		return h, s, maximum
	end

	function ColorPicker.new(section, config)
		config = config or {}
		local comp = setmetatable(Support.MakeComponent({
			kind = "ColorPicker",
			name = config.Name or "Cor",
			row = nil,
		}), ColorPicker)

		comp.Callback = config.Callback
		local default = config.Default or Color3.fromRGB(106, 61, 245)
		comp.H, comp.S, comp.V = colorToHsv(default)

		local row = Support.Row(section.Content, 120, {Hover = false})
		comp.Row = row

		local title = U.Label(row, comp.Name, {
			Font = Enum.Font.GothamMedium, Size = 12, Color = Env.Theme:Get().Text,
		})
		title.Size = UDim2.new(1, -110, 0, 16)
		title.Position = UDim2.fromOffset(10, 9)

		local preview = U.New("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(1, -92, 0, 8),
			BackgroundColor3 = default,
			BorderSizePixel = 0,
			Parent = row,
		})
		U.Corner(preview, 5)
		U.Stroke(preview, Color3.new(1, 1, 1), 1, 0.7)
		comp:AddDim(preview)

		local hexLabel = U.Label(row, U.Hex(default), {
			Font = Enum.Font.Code, Size = 10, Color = Env.Theme:Get().Dim,
			Align = Enum.TextXAlignment.Right,
		})
		hexLabel.Size = UDim2.fromOffset(62, 18)
		hexLabel.Position = UDim2.new(1, -70, 0, 8)

		-- ── três trilhos ───────────────────────────────────────────────
		local tracks = {}

		local function buildTrack(labelText, index, y, getRatio, onDrag)
			local label = U.Label(row, labelText, {
				Font = Enum.Font.Gotham, Size = 9, Color = Env.Theme:Get().Muted,
			})
			label.Size = UDim2.fromOffset(14, 14)
			label.Position = UDim2.fromOffset(10, y + 2)

			local track = U.New("Frame", {
				Size = UDim2.new(1, -44, 0, 5),
				Position = UDim2.fromOffset(28, y + 6),
				BackgroundColor3 = Env.Theme:Get().Off,
				BorderSizePixel = 0,
				Parent = row,
			})
			U.Corner(track, 3)

			local fill = U.New("Frame", {
				Size = UDim2.new(getRatio(), 0, 1, 0),
				BackgroundColor3 = Env.Theme:Get().Accent,
				BorderSizePixel = 0,
				Parent = track,
			})
			U.Corner(fill, 3)

			local knob = U.New("Frame", {
				Size = UDim2.fromOffset(11, 11),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(getRatio(), 0, 0.5, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = track,
			})
			U.Corner(knob, 6)

			local hit = U.New("TextButton", {
				Size = UDim2.new(1, -34, 0, 18),
				Position = UDim2.fromOffset(23, y - 2),
				BackgroundTransparency = 1,
				Text = "",
				Parent = row,
			})

			tracks[index] = {Track = track, Fill = fill, Knob = knob, GetRatio = getRatio}
			comp:AddDim(track)
			comp:AddDim(fill)
			comp:AddDim(knob)

			local dragging = false
			local function apply(absoluteX)
				local left = track.AbsolutePosition.X
				local width = math.max(track.AbsoluteSize.X, 1)
				onDrag(U.Clamp((absoluteX - left) / width, 0, 1))
			end
			comp.Maid:Add(hit.InputBegan:Connect(function(input)
				if not comp.Enabled or comp.Destroyed then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					apply(input.Position.X)
				end
			end))
			if U.UserInput then
				comp.Maid:Add(U.UserInput.InputChanged:Connect(function(input)
					if not dragging then return end
					if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
						apply(input.Position.X)
					end
				end))
				comp.Maid:Add(U.UserInput.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end))
			end
			return track
		end

		local function currentColor()
			return hsvToColor(comp.H, comp.S, comp.V)
		end

		local function refreshTracks()
			local values = {comp.H, comp.S, comp.V}
			for index, entry in ipairs(tracks) do
				local ratio = U.Clamp(values[index], 0, 1)
				entry.Fill.Size = UDim2.new(ratio, 0, 1, 0)
				entry.Knob.Position = UDim2.new(ratio, 0, 0.5, 0)
			end
		end

		local function refreshPreview()
			local color = currentColor()
			preview.BackgroundColor3 = color
			hexLabel.Text = U.Hex(color)
			return color
		end

		local function changed(silent)
			refreshTracks()
			local color = refreshPreview()
			if not silent and type(comp.Callback) == "function" then
				U.SafeCall("ColorPicker(" .. tostring(comp.Name) .. ")", comp.Callback, color)
			end
			return color
		end

		buildTrack("H", 1, 34, function() return comp.H end, function(ratio)
			comp.H = ratio
			changed(false)
		end)
		buildTrack("S", 2, 56, function() return comp.S end, function(ratio)
			comp.S = ratio
			changed(false)
		end)
		buildTrack("V", 3, 78, function() return comp.V end, function(ratio)
			comp.V = ratio
			changed(false)
		end)

		function comp:Paint(palette)
			title.TextColor3 = palette.Text
			hexLabel.TextColor3 = palette.Dim
			for _, entry in ipairs(tracks) do
				entry.Track.BackgroundColor3 = palette.Off
				entry.Fill.BackgroundColor3 = palette.Accent
				entry.Knob.BackgroundColor3 = Color3.new(1, 1, 1)
			end
		end

		function comp:SetValue(color, silent)
			if typeof and typeof(color) ~= "Color3" then
				warn("[Expander] ColorPicker:SetValue espera um Color3")
				return self:GetValue()
			end
			self.H, self.S, self.V = colorToHsv(color)
			return changed(silent)
		end

		function comp:GetValue()
			return currentColor()
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		refreshTracks()
		refreshPreview()
		section:_register(comp)
		if config.Enabled == false then comp:SetEnabled(false) end
		return comp
	end

	return ColorPicker
end

