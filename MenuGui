-- ═══════════════════════════════════════════════════════════════════════
-- INPUT — campo de texto
--   Section:CreateInput({Name, Placeholder, Default, Callback, Validate})
--   :SetValue(text) · :GetValue() · :Destroy()
-- Callback roda ao apertar Enter ou ao sair do campo; Validate devolve
-- (true) para aceitar ou (false, "motivo") para recusar.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Input"] = function(Env)
	local U = Env.Util
	local Support = Env.Components.Support

	local Input = {}
	Input.__index = Input
	Input.__typename = "Input"

	function Input.new(section, config)
		config = config or {}
		local comp = setmetatable(Support.MakeComponent({
			kind = "Input",
			name = config.Name or "Campo",
			description = config.Description,
			row = nil,
		}), Input)
		comp.Callback = config.Callback
		comp.Validate = config.Validate

		local row = Support.Row(section.Content, 58, {Hover = false})
		comp.Row = row

		local title = U.Label(row, comp.Name, {
			Font = Enum.Font.GothamMedium, Size = 11, Color = Env.Theme:Get().Dim,
		})
		title.Size = UDim2.new(1, -20, 0, 14)
		title.Position = UDim2.fromOffset(10, 7)

		local box = U.New("Frame", {
			Size = UDim2.new(1, -20, 0, 26),
			Position = UDim2.fromOffset(10, 24),
			BackgroundColor3 = Env.Theme:Get().CardHover,
			BorderSizePixel = 0,
			Parent = row,
		})
		U.Corner(box, 6)
		local boxStroke = U.Stroke(box, Env.Theme:Get().Border, 1, 0.15)
		comp.Box = box

		local textBox = U.New("TextBox", {
			Size = UDim2.new(1, -16, 1, 0),
			Position = UDim2.fromOffset(8, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = Env.Theme:Get().Text,
			PlaceholderText = config.Placeholder or "digite...",
			PlaceholderColor3 = Env.Theme:Get().Muted,
			Text = tostring(config.Default or ""),
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			TextEditable = true,
			Parent = box,
		})
		comp.TextBox = textBox
		comp:AddDim(box)
		comp:AddDim(textBox)
		comp.Value = textBox.Text

		local function commit()
			local value = textBox.Text
			if type(comp.Validate) == "function" then
				local ok, accepted, reason = pcall(comp.Validate, value)
				if ok and accepted == false then
					textBox.Text = comp.Value
					if U.OnError == nil then
						warn("[Expander] entrada recusada: " .. tostring(reason or "valor inválido"))
					end
					return
				end
			end
			comp.Value = value
			if type(comp.Callback) == "function" then
				U.SafeCall("Input(" .. tostring(comp.Name) .. ")", comp.Callback, value)
			end
		end

		function comp:Paint(palette)
			title.TextColor3 = palette.Dim
			box.BackgroundColor3 = palette.CardHover
			box.BackgroundTransparency = U.Alpha(palette, 0)
			boxStroke.Color = self.Focused and palette.Accent or palette.Border
			textBox.TextColor3 = palette.Text
			textBox.PlaceholderColor3 = palette.Muted
		end

		function comp:ApplyEnabled(value)
			if textBox then textBox.TextEditable = value end
			if not value then
				comp.Focused = false
				if textBox then pcall(function() textBox:ReleaseFocus() end) end
			end
		end

		function comp:SetValue(value, silent)
			value = tostring(value or "")
			self.Value = value
			textBox.Text = value
			if not silent and type(self.Callback) == "function" then
				U.SafeCall("Input(" .. tostring(self.Name) .. ")", self.Callback, value)
			end
		end

		function comp:GetValue()
			return textBox.Text
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		comp.Maid:Add(textBox.Focused:Connect(function()
			if not comp.Enabled or comp.Destroyed then
				pcall(function() textBox:ReleaseFocus() end)
				return
			end
			comp.Focused = true
			comp:Paint(Env.Theme:Get())
			U.Tween(boxStroke, 0.12, {Transparency = 0})
		end))
		comp.Maid:Add(textBox.FocusLost:Connect(function(enterPressed)
			comp.Focused = false
			comp:Paint(Env.Theme:Get())
			if enterPressed then commit() end
		end))

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		section:_register(comp)
		if config.Enabled == false then comp:SetEnabled(false) end
		return comp
	end

	return Input
end

