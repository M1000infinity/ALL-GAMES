function Library:GetThemes()
    local themes = {}
    for name in pairs(self.Themes) do
        table.insert(themes, name)
    end
    table.sort(themes)
    return themes
end

function Library:GetTheme(name)
    assert(name == nil or type(name) == "string", ("\"Library.GetTheme\". 'string' expected, got " .. tostring(typeof(name))))
