function WindowClass:Dialog(config)
    if self.Minimized then
        while not self:MinimizeButton() do task.wait() end
    end

    if CurrentDialog then
        CurrentDialog:Close(true)
    end

    local title = tostring(config.Title or config.Name or "Dialog")
    local content = tostring(config.Content or config.Description or config.Text or "")
    local options = config.Options or {}
    assert(type(options) == "table", ("\"Window.Dialog.Options\". 'table' expected, got " .. tostring(typeof(options))))
    assert(#options > 0, "\"Window.Dialog.Options\". requires one or more options.")

    local function presentDialog()
        local template = DialogRefs.Template
        local descLabel = template.Description
        local titleLabel = template.Title

        local originalSize = template:GetAttribute("OriginalSize")
        local shrinkSize = UDim2.new(originalSize.X.Scale * 1.2, originalSize.X.Offset, originalSize.Y.Scale * 1.2, originalSize.Y.Offset)

        template.Size = shrinkSize
        DialogRefs.OutBox.Parent = WindowMainFrame
        descLabel.Text = content
        titleLabel.Text = title

        Tween(template, "Size", originalSize, 0.22):Play()

        local dialog = DialogClass.new(descLabel, titleLabel)
        dialog.NEW_SIZE = shrinkSize
        dialog.TEMPLATE = template

        for _, child in pairs(template.Options:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end

        for index = #options, 1, -1 do
            dialog:NewOption(options[index])
        end

        return dialog
    end

    CurrentDialog = presentDialog()
    return CurrentDialog
end

