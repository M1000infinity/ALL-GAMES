    assert(name, ("\"Library.GetIconByName\". 'string' expected, got " .. tostring(typeof(name))))

    if IsAssetId(name) or #name == 0 then
        return name
    end

    local sanitized = SanitizeSearchText(name)

    if self.Icons[sanitized] then
        return "rbxassetid://" .. self.Icons[sanitized]
    end

    for iconName, iconId in pairs(self.Icons) do
        if iconName:find(sanitized, 1, true) then
            return "rbxassetid://" .. iconId
        end
    end
