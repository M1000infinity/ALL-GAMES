function TabClass:AddDropdown(config)
    local title, desc = ValidateOptionConfig("Dropdown", config)
    local flag = ValidateFlag("Dropdown", config[5] or config.Flag)

    local optionsList = config[2] or config.Options
    local default     = config[3] or config.Default
    if type(default) == "boolean" then default = nil end
    local callbacks   = PackCallback(config[4] or config.Callback)
    local multiSelect = config.MultiSelect

    if default ~= nil and type(default) ~= "table" and type(default) ~= "string" then
        error(("\"Tab.AddDropdown.Default\". 'string', 'table', or 'nil' expected, got " .. tostring(typeof(default))), 2)
    end
    if optionsList ~= nil and type(optionsList) ~= "table" then
        error(("\"Tab.AddDropdown.Options\". 'table', or 'nil' expected, got " .. tostring(typeof(optionsList))), 2)
    end
    if multiSelect ~= nil and type(multiSelect) ~= "boolean" then
        error(("\"Tab.AddDropdown.MultiSelect\". 'boolean', or 'nil' expected, got " .. tostring(typeof(multiSelect))), 2)
    end

    if flag and type(WindowFlags[flag]) == (multiSelect and "table" or "string") then
        default = WindowFlags[flag]
    end

    local row, titleLabel, descLabel = MakeOptionRow(self, title, desc, UDim2.new(1, -182, 0, 0))

    local holder = NewInstance("Frame", row, {
        Size = UDim2.new(0, 168, 0, 28),
        Position = UDim2.new(1, -12, 0.5),
        AnchorPoint = Vector2.new(1, 0.5),
        Elements = {
            Corner = UDim.new(0, 6),
            Stroke = { Thickness = 1, ThemeTag = { OBJECTS = TabScopes[self], Color = "Colors.Border.Default" } }
        },
        ThemeTag = {
            OBJECTS = TabScopes[self],
            BackgroundColor3 = "Colors.Stroke"
        }
    })

    local valueLabel = NewInstance("TextLabel", holder, {
        Size = UDim2.new(0.85, 0, 0.85, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1,
        TextScaled = true,
        Text = "...",
        ThemeTag = {
            OBJECTS = TabScopes[self],
            TextColor3 = "Colors.Text.Default",
            Font = "Font.Medium"
        }
    })

    NewInstance("UIPadding", valueLabel, {
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 2)
    })

    local chevronTag = {
        OBJECTS = TabScopes[self],
        Image = "Icons.Dropdown.Open",
        ImageColor3 = "Colors.Icons"
    }
    local chevron = NewInstance("ImageLabel", holder, {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(1, -8, 0.5),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        ThemeTag = chevronTag
    })

    local component = DropdownClass.new(self, row, titleLabel, descLabel, callbacks)

    local selectedSingle = nil
    local commitScheduled = false
    local isOpen = false

    local pendingDefaults = {}                 -- multi-select defaults set before the option exists
    local multiState = {}                      -- [optionName] = bool
    local optionsByName = {}                   -- [name] = option
    local dropdownOptions = {}                 -- ordered option list
    component.DROPDOWN_OPTIONS = dropdownOptions
    component.Opened = isOpen

    local function setChevron(colorKey, iconKey)
        chevronTag.ImageColor3 = colorKey
        chevronTag.Image = iconKey
        Tween(chevron, "ImageColor3", ThemePath(Library.CurrentTheme, colorKey), 0.22):Play()
        chevron.Image = ThemePath(Library.CurrentTheme, iconKey)
    end

    local function setOpen(open)
        isOpen = open
        component.Opened = open
        local colorKey = open and "Colors.Primary" or "Colors.Icons"
        local iconKey = open and "Icons.Dropdown.Close" or "Icons.Dropdown.Open"
        setChevron(colorKey, iconKey)
    end

    local function closeSelf() setOpen(false) end

    local function listSelectedNames()
        local names = {}
        for name, enabled in pairs(multiState) do
            if enabled then names[#names + 1] = name end
        end
        return names
    end

    local function renderValue(value)
        local text = type(value) == "table" and table.concat(value, ", ") or (value or "")
        if #text >= 100 then
            text = text:sub(1, 97) .. "..."
        end
        valueLabel.Text = #text ~= 0 and text or "..."
    end

    local function commitValue()
        commitScheduled = false
        local value = multiSelect and listSelectedNames() or selectedSingle and selectedSingle.Name
        FireCallbacks(callbacks, multiSelect and multiState or value)
        renderValue(value)
        if flag ~= nil then
            WindowFlags[flag] = value
        end
    end

    local function scheduleCommit()
        if not commitScheduled then
            commitScheduled = true
            task.delay(0.1, commitValue)
        end
    end

    local function onOptionClicked(option)
        if multiSelect then
            local newState = not option.Selected
            DropdownPopup.SetOptionValue(option, newState)
            multiState[option.Name] = newState
        else
            if selectedSingle == option then
                return nil
            elseif selectedSingle ~= nil then
                DropdownPopup.SetOptionValue(selectedSingle, false)
            end
            selectedSingle = option
            DropdownPopup.SetOptionValue(option, true)
        end
        scheduleCommit()
    end

    local function getOrCreateOption(name)
        name = tostring(name)
        if optionsByName[name] then return end
        local option = {
            Name = name,
            DisplayName = name,
            Selected = false
        }
        if multiSelect and multiState[name] == nil then
            multiState[name] = false
        end
        optionsByName[name] = option
        dropdownOptions[#dropdownOptions + 1] = option
        return option
    end

    local function togglePopup(open)
        if isOpen == open then return end
        if not DropdownPopup then
            DropdownPopup = BuildDropdownPopup()
        end
        if open then
            if not DropdownPopup.OpenDropdown(closeSelf) then return end
            DropdownPopup.SetHolder(holder)
            DropdownPopup.SetMultiSelect(multiSelect)
            DropdownPopup.SetOnClicked(onOptionClicked)
            DropdownPopup.SetOptions(dropdownOptions)
        else
            DropdownPopup.CloseDropdown()
        end
        setOpen(open)
    end

    local function findOption(nameOrIndex, index)
        if index and type(nameOrIndex) == "boolean" then
            return nameOrIndex == true and dropdownOptions[index]
        end
        if type(nameOrIndex) == "number" then
            return dropdownOptions[nameOrIndex]
        else
            return optionsByName[tostring(nameOrIndex)]
        end
    end

    local function selectOption(option)
        option.Selected = true
        if multiSelect then
            multiState[option.Name] = true
        else
            selectedSingle = option
        end
    end

    local function applyDefault(...)
        local option = findOption(...)
        if option then
            selectOption(option)
        elseif multiSelect and type(...) == "string" then
            pendingDefaults[select(1, ...)] = true
        end
    end

    local function applyDefaults()
        if not default then return end
        for index = 1, (multiSelect and #default or 1) do
            applyDefault(default[index], index)
        end
    end

    local function destroyOptionInstance(option)
        local index = table.find(dropdownOptions, option)
        if index then
            table.remove(dropdownOptions, index)
        end
        if option.Instance then
            option.Instance:Destroy()
        end
        optionsByName[option.Name] = nil
    end

    local function isOptionEnabled(option)
        if multiSelect then
            return (multiState[option.Name] or pendingDefaults[option.Name]) == true
        else
            return selectedSingle and selectedSingle.Name == option.Name
        end
    end

    component.ADD_DROPDOWN_OPTION = function(name)
        if type(name) == "table" then
            for index = 1, #name do
                component:Add(name[index])
            end
            return nil
        end
        local option = getOrCreateOption(name)
        if option then
            if component.Opened then
                DropdownPopup.CreateOptionTemplate(option, true)
            end
            if isOptionEnabled(option) then
                selectOption(option)
                if option.Instance then
                    DropdownPopup.SetOptionValue(option, option.Selected)
                end
            end
            scheduleCommit()
        end
    end

    component.REMOVE_DROPDOWN_OPTION = function(name)
        local option = optionsByName[tostring(name)]
        if option then
            destroyOptionInstance(option)
        end
    end

    component.CLEAR_DROPDOWN = function()
        for index = #dropdownOptions, 1, -1 do
            local option = dropdownOptions[index]
            if option.Instance then
                option.Instance:Destroy()
            end
            optionsByName[option.Name] = nil
            dropdownOptions[index] = nil
        end
        if component.Opened then
            DropdownPopup.Clear()
        end
    end

    component.SET_ENABLED_OPTIONS = function(options)
        for _, name in ipairs(options) do
            applyDefault(name)
        end
        scheduleCommit()
    end

    -- additive helper (new API): programmatically select an option by name
    function component:Select(name)
        if multiSelect then return nil end
        local option = findOption(name)
        if not option then return nil end
        if selectedSingle and selectedSingle ~= option then
            selectedSingle.Selected = false
            if selectedSingle.Instance and DropdownPopup then
                DropdownPopup.SetOptionValue(selectedSingle, false)
            end
        end
        selectOption(option)
        if option.Instance and DropdownPopup then
            DropdownPopup.SetOptionValue(option, true)
        end
        commitValue()
    end

    do
        if optionsList then
            for index = 1, #optionsList do
                getOrCreateOption(optionsList[index])
            end
        end
        if type(default) == "table" then
            applyDefaults()
        elseif type(default) == "string" or type(default) == "number" then
            local option = findOption(default)
            if option then
                selectOption(option)
            end
        end
        if multiSelect then
            local names = listSelectedNames()
            task.defer(FireCallbacks, callbacks, multiState)
            renderValue(names)
        else
            local current = selectedSingle
            local name = current and current.Name or ""
            task.defer(FireCallbacks, callbacks, name)
            renderValue(name)
        end
    end

    Connect(row.Activated, function()
        togglePopup(not isOpen)
    end)

    -- keep popup visual state of pre-selected options in sync when it opens
    if not self.IsInterfaceTab then
        RegisterOption(self, "Dropdown", title, desc, row)
    end
    return component
end

-------------------------------- Tab lifetime -------------------------------

function TabClass:Destroy()
    assert(type(self) == "table" and self.IS_A_TAB, ("\"Tab.Destroy\". " .. tostring(tostring(self)) .. " is not a tab"))
    if self.IS_DESTROYED then return end
    local index = table.find(AllTabs, self)
    assert(index, ("\"Tab.Destroy\". failed to destroy '" .. tostring(self.Title) .. "'"))

    table.remove(AllTabs, index)

    for _, element in pairs(TabVisuals[self]) do
        if typeof(element) == "Instance" then
            element:Destroy()
        end
    end

    TabScopes[self]:destroy()

    TabVisuals[self] = nil
    TabScopes[self] = nil

    setmetatable(self, nil)
end

function TabClass:SetVisible(visible)
    assert(type(visible) == "boolean", ("\"Tab.SetVisible[param 1]\". 'boolean' extected, got " .. tostring(typeof(visible))))
    for _, element in pairs(TabVisuals[self]) do
        if typeof(element) == "Instance" and element:IsA("GuiObject") then
            element.Visible = visible
        end
    end
end

function TabClass:Select()
    if SelectedTab == self then
        return nil
    end
    if SelectedTab then
        TabActions[SelectedTab].Unselect()
    end
    SelectedTab = self
    TabActions[SelectedTab].Select()
end

