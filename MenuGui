-- ═══════════════════════════════════════════════════════════════════════
-- CORE — monta a biblioteca a partir dos módulos e expõe a API pública
--
-- Recebe a tabela MODULES (nome -> função(Env)) e devolve a Expander.
-- O build (tools/build.py) preenche MODULES; em Studio usa-se o arquivo
-- final como ModuleScript (os módulos ficam embutidos).
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Core"] = function(MODULES)
	local Env = {
		Version = "1.0.0",
		Name = "ExpanderUI",
		Components = {},
		Defaults = {
			Theme = "Purple",
			Size = nil, -- UDim2.fromOffset(900, 580) montado abaixo
		},
	}

	-- ── utilidades base ───────────────────────────────────────────────
	Env.Signal = MODULES.Signal(Env)
	Env.Maid = MODULES.Maid(Env)
	Env.Util = MODULES.Layout(Env)
	Env.ThemeClass = MODULES.ThemeManager(Env)
	Env.Theme = Env.ThemeClass.new(Env.Defaults.Theme or "Purple")
	Env.Util.AnimSpeed = Env.Theme.AnimSpeed
	Env.StateClass = MODULES.StateManager(Env)
	Env.State = Env.StateClass.new()
	Env.Registry = MODULES.ComponentRegistry(Env)
	Env.Icons = MODULES.Icons(Env)

	-- ── componentes ───────────────────────────────────────────────────
	Env.Components.Support = MODULES.Support(Env)

	local COMPONENT_MODULES = {
		"Button", "Toggle", "Slider", "Dropdown", "Input",
		"Label", "Paragraph", "Keybind", "ColorPicker", "Divider",
	}
	for _, name in ipairs(COMPONENT_MODULES) do
		Env.Components[name] = MODULES[name](Env)
	end

	-- ── estrutura ─────────────────────────────────────────────────────
	Env.Notifications = MODULES.Notifications(Env)
	Env.Section = MODULES.Section(Env)
	Env.Tab = MODULES.Tab(Env)
	Env.Window = MODULES.Window(Env)

	-- ── API pública ───────────────────────────────────────────────────
	local Expander = {}
	Expander.Version = Env.Version
	Expander.Themes = Env.Theme:Names()
	Expander.Defaults = {Theme = Env.Defaults.Theme}

	local windows = {}
	local globalState = Env.State

	local function sanitize(text)
		return (tostring(text or "Window"):gsub("[^%w_%- ]", ""))
	end

	-- Procura ScreenGuis com o mesmo nome que tenham sobrado de execuções
	-- anteriores NA MESMA sessão de Roblox (outro script, F5, etc.).
	local function findStaleGuis(name)
		local found = {}
		local function scan(root)
			if not root then return end
			pcall(function()
				for _, child in ipairs(root:GetChildren()) do
					if child.Name == name and child:IsA("ScreenGui") then
						table.insert(found, child)
					end
				end
			end)
		end

		pcall(function()
			if type(gethui) == "function" then scan(gethui()) end
		end)
		pcall(function()
			local players = game:GetService("Players")
			local localPlayer = players.LocalPlayer
			if localPlayer then scan(localPlayer:FindFirstChildOfClass("PlayerGui")) end
			for _, player in ipairs(players:GetPlayers()) do
				scan(player:FindFirstChildOfClass("PlayerGui"))
			end
		end)
		pcall(function() scan(game:GetService("CoreGui")) end)
		return found
	end

	local function aliveWindows()
		local alive = {}
		for _, window in ipairs(windows) do
			if not window.Destroyed then table.insert(alive, window) end
		end
		return alive
	end

	function Expander:CreateWindow(options)
		options = options or {}

		-- reutiliza a janela viva com o mesmo título (padrão)
		if options.Reuse ~= false and options.Title then
			for _, window in ipairs(aliveWindows()) do
				if window.Title == options.Title then
					return window
				end
			end
		end

		-- remove restos de execuções anteriores para não empilhar janelas
		if options.Replace ~= false and options.Title then
			local name = "ExpanderUI_" .. sanitize(options.Title)
			for _, stale in ipairs(findStaleGuis(name)) do
				pcall(function() stale:Destroy() end)
			end
		end

		-- tema pedido nesta janela (sem afetar as outras)
		if options.Theme and options.Theme ~= Env.Theme:Name() then
			Env.Theme:Set(options.Theme)
		end
		if options.Accent then Env.Theme:SetAccent(options.Accent) end
		if options.Transparency then Env.Theme:SetTransparency(options.Transparency) end
		if options.AnimSpeed then Env.Theme:SetAnimSpeed(options.AnimSpeed) end

		local ok, window = pcall(Env.Window.new, options)
		if not ok then
			warn("[Expander] falha ao criar janela: " .. tostring(window))
			return nil, tostring(window)
		end

		-- permite que a janela se remova da lista ao ser destruída
		window.ExpanderUnregister = function()
			for index = #windows, 1, -1 do
				if windows[index] == window then
					table.remove(windows, index)
				end
			end
		end
		table.insert(windows, window)
		return window
	end

	function Expander:GetWindow(title)
		local alive = aliveWindows()
		if not title then return alive[1] end
		for _, window in ipairs(alive) do
			if window.Title == title then return window end
		end
		return nil
	end

	function Expander:GetWindows()
		return aliveWindows()
	end

	function Expander:DestroyAll()
		local alive = aliveWindows()
		windows = {}
		for _, window in ipairs(alive) do
			pcall(function() window:Destroy() end)
		end
	end

	function Expander:SetTheme(name)
		return Env.Theme:Set(name)
	end

	function Expander:SetAccent(color)
		return Env.Theme:SetAccent(color)
	end

	function Expander:SetTransparency(value)
		Env.Theme:SetTransparency(value)
	end

	function Expander:SetAnimSpeed(value)
		Env.Theme:SetAnimSpeed(value)
	end

	function Expander:GetTheme()
		return Env.Theme:Name()
	end

	function Expander:GetThemePalette()
		return Env.Theme:Get()
	end

	function Expander:Notify(config)
		local window = Expander:GetWindow()
		if window then return window:Notify(config) end
		return nil
	end

	function Expander:GetState()
		return globalState
	end

	-- Atalhos úteis para quem não quer guardar a janela inteira
	Expander.State = globalState
	Expander.Theme = Env.Theme

	Env.Expander = Expander

	return Expander
end

-- ── bootstrap ─────────────────────────────────────────────────────────
local Expander = MODULES.Core(MODULES)

-- auto-verificação: se algum módulo não carregou, o erro é claro em vez de
-- virar um "nil index" no meio do uso.
if type(Expander) ~= "table" or type(Expander.CreateWindow) ~= "function" then
	error("[Expander] build inválido: a API pública não foi montada", 0)
end

-- No executor, deixa a biblioteca acessível para scripts seguintes da sessão.
-- (getgenv é específico de executor; em jogo normal esta parte é ignorada.)
if type(getgenv) == "function" then
	local ok, env = pcall(getgenv)
	if ok and type(env) == "table" then
		env.Expander = Expander
	end
end

