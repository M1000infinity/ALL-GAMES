-- Builds the mutable runtime theme: preset copy + accent + transparency.
local function BuildRuntimeTheme(presetName)
    local config = Library.InterfaceConfig
    local runtime = DeepCopyTable(Library.Themes[presetName])

    local accentName = config and config.Accent
    local accent = accentName and AccentPresets[accentName]
    if accent then
        runtime.Colors.Primary = accent.Primary
        runtime.Colors.OnPrimary = accent.Primary:Lerp(Color3.new(0, 0, 0), 0.45)
        runtime.Colors.ScrollBar = accent.ScrollBar
        runtime.Colors.Link = accent.Link
        runtime.Colors.Slider.SliderBar = accent.Primary
    end

    local transparency = config and config.PanelTransparency
    if type(transparency) == "number" then
        runtime.BackgroundTransparency = math.clamp(transparency, 0, 0.45)
    end

    return runtime
end

function Library:SetTheme(name)
    assert(type(name) == "string", ("\"Library.SetTheme\". string extected, got " .. tostring(typeof(name))))
    assert(self.Themes[name], ("\"Library.SetTheme\". theme not found: " .. tostring(name)))

    self.CurrentTheme = BuildRuntimeTheme(name)

    if self.WindowSettings then
        self.WindowSettings.SelectedTheme = self.Themes[name].Name
    end

    GlobalThemeScope:update()
end

function Library:SetUIScale(scale)
    scale = math.clamp(tonumber(scale) or 1, LibraryConstants.MIN_SCALE, LibraryConstants.MAX_SCALE)
    self._LastUIScale = scale
    ScreenGui.Scale.Scale = ProportionalScale(scale)
end

function Library:GetMaxScale()
    return LibraryConstants.MAX_SCALE
end

function Library:GetMinScale()
    return LibraryConstants.MIN_SCALE
end

function Library:GetCurrentTheme()
    if not self.LOADED_UI_LIBRARY then
        return error("failed to get current theme: UI is not loaded", 2)
    end
    return self.CurrentTheme
end

function Library:Destroy()
    for _, connection in pairs(self.Connections) do
        connection:Disconnect()
    end

    if ScreenGui and ScreenGui:GetAttribute("UID") == self.SCREENGUI_UID then
        pcall(ScreenGui.Destroy, ScreenGui)
    end
end

--============================================================================
-- [14] INTERFACE CONFIG (settings page persistence/density/descriptions)
--============================================================================

local InterfaceDefaults = {
    Theme = nil,               -- theme name override (nil = WindowSettings.SelectedTheme/default)
    Accent = "Blue",
    UIScale = 1,
    Animations = true,
    AnimSpeed = 1,
    ReduceEffects = false,
    CompactMode = false,
    ShowDescriptions = true,
    PanelTransparency = 0
}

local function ReadInterfaceConfig()
    local stored = Library.WindowSettings and Library.WindowSettings.InterfaceConfig
    local config = {}
    for key, value in pairs(InterfaceDefaults) do
        config[key] = value
    end
    if type(stored) == "table" then
        for key, value in pairs(stored) do
            config[key] = value
        end
    end
    return config
end

local function SaveInterfaceConfig()
    if Library.WindowSettings then
        Library.WindowSettings.InterfaceConfig = Library.InterfaceConfig
    end
end

local function ApplyDensity()
    local compact = Library.InterfaceConfig.CompactMode == true
    local rowHeight = compact and 28 or 34
    local listPadding = UDim.new(0, compact and 3 or 6)

    for entry in pairs(DensityRegistry) do
        if entry.Row.Parent then
            entry.Row.Size = UDim2.new(1, 0, 0, rowHeight)
            local padding = entry.Holder and entry.Holder:FindFirstChildOfClass("UIPadding")
            if padding then
                local vertical = compact and 4 or 7
                padding.PaddingTop = UDim.new(0, vertical)
                padding.PaddingBottom = UDim.new(0, vertical)
            end
        end
    end

    for button in pairs(TabButtonRegistry) do
        if button.Parent then
            button.Size = UDim2.new(1, 0, 0, compact and 30 or 34)
        end
    end

    for _, tab in ipairs(AllTabs) do
        local visuals = TabVisuals[tab]
        if visuals and visuals.Container then
            local layout = visuals.Container:FindFirstChildOfClass("UIListLayout")
            if layout then
                layout.Padding = listPadding
            end
        end
    end
end

local function ApplyDescriptionVisibility()
    local show = Library.InterfaceConfig.ShowDescriptions ~= false
    for entry in pairs(DensityRegistry) do
        if entry.Row.Parent and entry.Holder then
            local desc = entry.Holder:FindFirstChild("Description")
            if desc then
                local visible = show and #desc.Text > 0
                if desc.Visible ~= visible then
                    local anchorY = visible and 0 or 0.5
                    desc.Visible = visible
                    entry.Holder.Position = UDim2.fromScale(0, anchorY)
                    entry.Holder.AnchorPoint = Vector2.new(0, anchorY)
                end
            end
        end
    end
end

local function ApplyMotionConfig()
    local config = Library.InterfaceConfig
    Motion.Enabled = config.Animations ~= false and config.ReduceEffects ~= true
    Motion.Speed = tonumber(config.AnimSpeed) or 1
    Motion.ReduceEffects = config.ReduceEffects == true
    for gradient in pairs(GradientRegistry) do
        if gradient.Parent then
            gradient.Enabled = not Motion.ReduceEffects
        end
    end
end

local function ApplyInterfaceConfig()
    if not Library.CurrentTheme then return end
    local themeName = Library.InterfaceConfig.Theme
    if themeName and Library.Themes[themeName] then
        Library.CurrentTheme = BuildRuntimeTheme(themeName)
    else
        local currentName = Library.CurrentTheme.Name
        Library.CurrentTheme = BuildRuntimeTheme(currentName)
    end
    GlobalThemeScope:update()
    ApplyMotionConfig()
    ApplyDensity()
    ApplyDescriptionVisibility()
end

