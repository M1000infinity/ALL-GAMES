-- SLIDER
--   Section:CreateSlider({Name, Min, Max, Default, Step, Suffix,
--                         Format, Callback, OnChange})
--   :SetValue(v, silent) · :GetValue() · :Destroy()
-- Arrasta com mouse e com dedo; segura o valor dentro de Min/Max.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Slider"] = function(Env)
	local U = Env.Util
	local Support = Env.Components.Support

	local Slider = {}
	Slider.__index = Slider
	Slider.__typename = "Slider"

	function Slider.new(section, config)
		config = config or {}
		local minimum = tonumber(config.Min) or 0
		local maximum = tonumber(config.Max) or 100
		if maximum <= minimum then maximum = minimum + 1 end
		local step = tonumber(config.Step) or 0

		local comp = setmetatable(Support.MakeComponent({
			kind = "Slider",
			name = config.Name or "Slider",
			description = config.Description,
			row = nil,
		}), Slider)

		comp.Min = minimum
		comp.Max = maximum
		comp.Step = step
		comp.Callback = config.Callback
		comp.OnChange = config.OnChange
		comp.Format = config.Format
		comp.Suffix = config.Suffix or ""

		local start = tonumber(config.Default) or minimum
		comp.Value = U.Clamp(start, minimum, maximum)
		if step > 0 then comp.Value = U.Clamp(U.Round(comp.Value, step), minimum, maximum) end

		local row = Support.Row(section.Content, 58, {Hover = false})
		comp.Row = row

		local title = U.Label(row, comp.Name, {
			Font = Enum.Font.GothamMedium, Size = 12, Color = Env.Theme:Get().Text,
		})
		title.Size = UDim2.new(1, -90, 0, 16)
		title.Position = UDim2.fromOffset(10, 10)

		local valueLabel = U.Label(row, "", {
			Font = Enum.Font.GothamBold, Size = 11, Color = Env.Theme:Get().AccentGlow,
			Align = Enum.TextXAlignment.Right,
		})
		valueLabel.Size = UDim2.new(0, 80, 0, 16)
		valueLabel.Position = UDim2.new(1, -90, 0, 10)

		local track = U.New("Frame", {
			Size = UDim2.new(1, -20, 0, 5),
			Position = UDim2.fromOffset(10, 40),
			BackgroundColor3 = Env.Theme:Get().Off,
			BorderSizePixel = 0,
			Parent = row,
		})
		U.Corner(track, 3)
		comp.Track = track

		local fill = U.New("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Env.Theme:Get().Accent,
			BorderSizePixel = 0,
			Parent = track,
		})
		U.Corner(fill, 3)
		comp.Fill = fill

		local knob = U.New("Frame", {
			Size = UDim2.fromOffset(12, 12),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = track,
		})
		U.Corner(knob, 6)
		local knobStroke = U.Stroke(knob, Env.Theme:Get().Accent, 1.5, 0)
		comp.Knob = knob
		comp:AddDim(track)
		comp:AddDim(fill)
		comp:AddDim(knob)
		comp:AddDim(valueLabel)

		local hit = U.New("TextButton", {
			Size = UDim2.new(1, -14, 0, 24),
			Position = UDim2.fromOffset(7, 30),
			BackgroundTransparency = 1,
			Text = "",
			Parent = row,
		})
		comp.Hit = hit

		local function ratio()
			return (comp.Value - minimum) / (maximum - minimum)
		end

		local function valueText()
			if type(comp.Format) == "function" then
				local ok, text = pcall(comp.Format, comp.Value)
				if ok and text ~= nil then return tostring(text) end
			end
			return U.FormatNumber(comp.Value, step > 0 and (step < 1 and 2 or 0) or (comp.Max - comp.Min <= 10 and 1 or 0)) .. comp.Suffix
		end

		local function paint()
			local r = ratio()
			fill.Size = UDim2.new(r, 0, 1, 0)
			knob.Position = UDim2.new(r, 0, 0.5, 0)
			valueLabel.Text = valueText()
		end

		function comp:Paint(palette)
			title.TextColor3 = palette.Text
			valueLabel.TextColor3 = palette.AccentGlow
			track.BackgroundColor3 = palette.Off
			track.BackgroundTransparency = U.Alpha(palette, 0)
			fill.BackgroundColor3 = palette.Accent
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
			knobStroke.Color = palette.Accent
		end

		local function commit(value, silent)
			value = U.Clamp(tonumber(value) or comp.Value, minimum, maximum)
			if step > 0 then value = U.Clamp(U.Round(value, step), minimum, maximum) end
			local changed = value ~= comp.Value
			comp.Value = value
			paint()
			if silent then return end
			if type(comp.OnChange) == "function" then
				U.SafeCall("Slider.OnChange(" .. tostring(comp.Name) .. ")", comp.OnChange, value)
			end
			if changed and type(comp.Callback) == "function" then
				U.SafeCall("Slider(" .. tostring(comp.Name) .. ")", comp.Callback, value)
			end
		end

		function comp:SetValue(value, silent)
			commit(value, silent)
			return self.Value
		end

		function comp:GetValue()
			return self.Value
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		local dragging = false
		local function applyFromX(absoluteX)
			local left = track.AbsolutePosition.X
			local width = math.max(track.AbsoluteSize.X, 1)
			commit(minimum + (maximum - minimum) * U.Clamp((absoluteX - left) / width, 0, 1), false)
		end

		comp.Maid:Add(hit.InputBegan:Connect(function(input)
			if not comp.Enabled or comp.Destroyed then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				applyFromX(input.Position.X)
			end
		end))

		if U.UserInput then
			comp.Maid:Add(U.UserInput.InputChanged:Connect(function(input)
				if not dragging then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					applyFromX(input.Position.X)
				end
			end))
			comp.Maid:Add(U.UserInput.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end))
		end

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		paint()
		section:_register(comp)
		if config.Enabled == false then comp:SetEnabled(false) end
		return comp
	end

	return Slider
end

-- ── módulo: Dropdown (src/Components/Dropdown.lua) ───────────────────────
-- ═══════════════════════════════════════════════════════════════════════
-- DROPDOWN
--   Section:CreateDropdown({Name, Options, Default, Multi, MaxHeight,
--                           Callback})
--   :SetValue(v, silent) · :GetValue() · :SetOptions(list)
--   :Open() · :Close() · :Destroy()
--
-- Multi = true recebe/produz uma tabela ({["A"] = true}). A lista é aberta
-- num popup preso à janela (não é cortada pelo ScrollingFrame da aba) e
-- fecha ao clicar fora.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Dropdown"] = function(Env)
	local U = Env.Util
	local Support = Env.Components.Support

	local Dropdown = {}
	Dropdown.__index = Dropdown
	Dropdown.__typename = "Dropdown"

	function Dropdown.new(section, config)
		config = config or {}
		local comp = setmetatable(Support.MakeComponent({
			kind = "Dropdown",
			name = config.Name or "Dropdown",
			description = config.Description,
			row = nil,
		}), Dropdown)

		comp.Callback = config.Callback
		comp.Multi = config.Multi == true
		comp.MaxHeight = tonumber(config.MaxHeight) or 190
		comp.Options = {}
		comp.Popup = nil
		comp.IsOpen = false

		for _, option in ipairs(config.Options or {}) do
			table.insert(comp.Options, tostring(option))
		end
		comp.Value = comp.Multi and {} or (comp.Options[1] or "")
		-- aplica o Default antes de existir UI (o método nasce mais abaixo)
		if comp.Multi then
			if type(config.Default) == "table" then
				for _, option in ipairs(comp.Options) do
					if config.Default[option] then comp.Value[option] = true end
				end
			end
		elseif type(config.Default) == "string" then
			comp.Value = config.Default
		end

		local row = Support.Row(section.Content, 58, {Hover = false})
		comp.Row = row

		local title = U.Label(row, comp.Name, {
			Font = Enum.Font.GothamMedium, Size = 11, Color = Env.Theme:Get().Dim,
		})
		title.Size = UDim2.new(1, -20, 0, 14)
		title.Position = UDim2.fromOffset(10, 7)

		local box = U.New("TextButton", {
			Size = UDim2.new(1, -20, 0, 28),
			Position = UDim2.fromOffset(10, 24),
			BackgroundColor3 = Env.Theme:Get().CardHover,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		U.Corner(box, 6)
		local boxStroke = U.Stroke(box, Env.Theme:Get().Border, 1, 0.15)
		comp.Box = box
		comp:AddDim(box)

		local valueLabel = U.Label(box, "", {
			Font = Enum.Font.Gotham, Size = 10, Color = Env.Theme:Get().Text,
		})
		valueLabel.Size = UDim2.new(1, -34, 1, 0)
		valueLabel.Position = UDim2.fromOffset(8, 0)
		comp.ValueLabel = valueLabel

		local chevron = Env.Icons("chevron", Env.Theme:Get().Muted, 10)
		chevron.Position = UDim2.new(1, -20, 0.5, -5)
		chevron.Parent = box
		comp.ChevronHolder = chevron

		local function display()
			if comp.Multi then
				local picked = {}
				for _, option in ipairs(comp.Options) do
					if comp.Value[option] then table.insert(picked, option) end
				end
				if #picked == 0 then
					valueLabel.Text = "Nenhum selecionado"
				elseif #picked <= 2 then
					valueLabel.Text = table.concat(picked, ", ")
				else
					valueLabel.Text = tostring(#picked) .. " selecionados"
				end
			else
				valueLabel.Text = tostring(comp.Value or "")
			end
		end

		function comp:Paint(palette)
			title.TextColor3 = palette.Dim
			box.BackgroundColor3 = palette.CardHover
			box.BackgroundTransparency = U.Alpha(palette, 0)
			boxStroke.Color = self.IsOpen and palette.Accent or palette.Border
			valueLabel.TextColor3 = palette.Text
			if self.Popup then self:_PaintPopup(palette) end
		end

		-- ── popup ──────────────────────────────────────────────────────
		function comp:_ClosePopup()
			if self.Popup then
				self.Popup.Backdrop:Destroy()
				self.Popup.Frame:Destroy()
				self.Popup = nil
			end
			self.IsOpen = false
			self:Paint(Env.Theme:Get())
		end

		function comp:Close()
			self:_ClosePopup()
		end

		function comp:_OptionClick(option)
			if self.Multi then
				self.Value[option] = not self.Value[option] or nil
				display()
				if type(self.Callback) == "function" then
					local copy = {}
					for key, value in pairs(self.Value) do copy[key] = value end
					U.SafeCall("Dropdown(" .. tostring(self.Name) .. ")", self.Callback, copy)
				end
				if self.Popup then self:_BuildOptions() end
			else
				self.Value = option
				display()
				self:_ClosePopup()
				if type(self.Callback) == "function" then
					U.SafeCall("Dropdown(" .. tostring(self.Name) .. ")", self.Callback, option)
				end
			end
		end

		function comp:_PaintPopup(palette)
			local popup = self.Popup
			if not popup then return end
			popup.Frame.BackgroundColor3 = palette.Panel
			popup.Frame.BackgroundTransparency = U.Alpha(palette, 0)
			popup.Stroke.Color = palette.Border
			for _, button in ipairs(popup.Buttons) do
				local selected = self.Multi and self.Value[button.Option] or (self.Value == button.Option)
				button.Frame.BackgroundColor3 = selected and palette.AccentSoft or palette.Card
				button.Frame.BackgroundTransparency = U.Alpha(palette, selected and 0.35 or 0.55)
				button.Label.TextColor3 = selected and palette.Text or palette.Dim
			end
		end

		function comp:_BuildOptions()
			if not self.Popup then return end
			local popup = self.Popup
			for _, button in ipairs(popup.Buttons) do
				button.Frame:Destroy()
			end
			popup.Buttons = {}

			if #self.Options == 0 then
				local empty = U.Label(popup.Content, "Sem opções", {
					Font = Enum.Font.Gotham, Size = 10, Color = Env.Theme:Get().Muted,
				})
				empty.Size = UDim2.new(1, -16, 0, 26)
				empty.Position = UDim2.fromOffset(8, 2)
				popup.Buttons = {}
				popup.Empty = empty
				return
			end

			local height = math.min(#self.Options * 28 + 8, self.MaxHeight)
			popup.Frame.Size = UDim2.fromOffset(popup.Width, height)
			popup.Content.Size = UDim2.new(1, -4, 1, 0)
			popup.Content.CanvasSize = UDim2.new(0, 0, 0, #self.Options * 28 + 8)

			for index, option in ipairs(self.Options) do
				local item = U.New("TextButton", {
					Size = UDim2.new(1, -10, 0, 26),
					Position = UDim2.fromOffset(5, 4 + (index - 1) * 28),
					BackgroundColor3 = Env.Theme:Get().Card,
					BackgroundTransparency = 0.55,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					LayoutOrder = index,
					Parent = popup.Content,
				})
				U.Corner(item, 5)
				local label = U.Label(item, option, {
					Font = Enum.Font.Gotham, Size = 10, Color = Env.Theme:Get().Dim,
				})
				label.Size = UDim2.new(1, -12, 1, 0)
				label.Position = UDim2.fromOffset(6, 0)
				item.MouseEnter:Connect(function()
					U.Tween(item, 0.1, {BackgroundTransparency = 0.3})
				end)
				item.MouseLeave:Connect(function()
					if not (self.Multi and self.Value[option]) and self.Value ~= option then
						U.Tween(item, 0.1, {BackgroundTransparency = 0.55})
					end
				end)
				item.MouseButton1Click:Connect(function() self:_OptionClick(option) end)
				table.insert(popup.Buttons, {Frame = item, Label = label, Option = option})
			end
			self:_PaintPopup(Env.Theme:Get())
		end

		function comp:Open()
			if self.IsOpen or not self.Enabled or self.Destroyed then return end
			local overlay = self.Section.Window and self.Section.Window.Overlay
			if not overlay then return end

			self.IsOpen = true

			local backdrop = U.New("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 600,
				Parent = overlay,
			})
			backdrop.MouseButton1Click:Connect(function() self:_ClosePopup() end)

			local win = self.Section.Window
			local scaleValue = win:GetScale()
			local space = win:ToOverlaySpace(box.AbsolutePosition)
			local boxWidth = box.AbsoluteSize.X / scaleValue
			local boxHeight = box.AbsoluteSize.Y / scaleValue
			local overlayHeight = win:OverlayHeight()

			local width = math.max(160, boxWidth)
			local rows = math.max(1, #self.Options)
			local desired = math.min(rows * 28 + 8, self.MaxHeight)
			local belowY = space.Y + boxHeight + 4
			local aboveY = space.Y - desired - 4
			local y = belowY
			if belowY + desired > overlayHeight - 8 and aboveY > 8 then
				y = aboveY
			end

			local frame = U.New("Frame", {
				Size = UDim2.fromOffset(width, desired),
				Position = UDim2.fromOffset(space.X, y),
				BackgroundColor3 = Env.Theme:Get().Panel,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				ZIndex = 601,
				Parent = overlay,
			})
			U.Corner(frame, 8)

			local stroke = U.Stroke(frame, Env.Theme:Get().Border, 1, 0)

			local content = U.New("ScrollingFrame", {
				Size = UDim2.new(1, -4, 1, 0),
				Position = UDim2.fromOffset(2, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				CanvasSize = UDim2.new(0, 0, 0, rows * 28 + 8),
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = Env.Theme:Get().AccentSoft,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ZIndex = 602,
				Parent = frame,
			})

			self.Popup = {
				Backdrop = backdrop,
				Frame = frame,
				Stroke = stroke,
				Content = content,
				Buttons = {},
				Width = width,
			}

			local ok, err = pcall(function() self:_BuildOptions() end)
			if not ok then
				warn("[Expander] dropdown: " .. tostring(err))
				self:_ClosePopup()
				return
			end

			frame.Size = UDim2.fromOffset(width, 0)
			U.Tween(frame, 0.14, {Size = UDim2.fromOffset(width, desired)})
			self:Paint(Env.Theme:Get())
		end

		function comp:ToggleMenu()
			if not self.Enabled or self.Destroyed then return end
			if self.IsOpen then self:_ClosePopup() else self:Open() end
		end

		-- desativar fecha o menu aberto e bloqueia cliques
		function comp:ApplyEnabled(value)
			if not value and self.IsOpen then self:_ClosePopup() end
		end

		-- ── valores ────────────────────────────────────────────────────
		function comp:_ApplyDefault(value)
			if comp.Multi then
				comp.Value = {}
				if type(value) == "table" then
					for _, option in ipairs(comp.Options) do
						if value[option] then comp.Value[option] = true end
					end
				end
			else
				if type(value) == "string" then
					comp.Value = value
				else
					comp.Value = comp.Options[1] or ""
				end
			end
		end

		local function sameSet(a, b)
			for key in pairs(a or {}) do if not (b or {})[key] then return false end end
			for key in pairs(b or {}) do if not (a or {})[key] then return false end end
			return true
		end

		function comp:SetValue(value, silent)
			if self.Multi then
				local nextValue = {}
				if type(value) == "table" then
					for _, option in ipairs(self.Options) do
						if value[option] then nextValue[option] = true end
					end
				end
				local changed = not sameSet(self.Value, nextValue)
				self.Value = nextValue
				display()
				if changed and not silent and type(self.Callback) == "function" then
					U.SafeCall("Dropdown(" .. tostring(self.Name) .. ")", self.Callback, nextValue)
				end
				return nextValue
			end

			local candidate = value ~= nil and tostring(value) or ""
			local exists = false
			for _, option in ipairs(self.Options) do
				if option == candidate then exists = true break end
			end
			if not exists then
				-- opção que não existe (ou removida em runtime): não inventa estado
				if candidate ~= "" then
					warn("[Expander] Dropdown(" .. tostring(self.Name) .. "): opção inexistente '" .. candidate .. "'")
				end
				candidate = self.Options[1] or ""
				if self.Value == candidate or (self.Value == nil and candidate == "") then
					display()
					return self.Value
				end
			end

			local changed = self.Value ~= candidate
			self.Value = candidate
			display()
			if changed and not silent and type(self.Callback) == "function" then
				U.SafeCall("Dropdown(" .. tostring(self.Name) .. ")", self.Callback, self.Value)
			end
			return self.Value
		end

		function comp:GetValue()
			return self.Value
		end

		function comp:SetOptions(options, keepValue)
			local list = {}
			for _, option in ipairs(options or {}) do table.insert(list, tostring(option)) end
			self.Options = list

			if self.Multi then
				local filtered = {}
				for option in pairs(self.Value) do
					local stillThere = false
					for _, candidate in ipairs(list) do
						if candidate == option then stillThere = true break end
					end
					if stillThere then filtered[option] = true end
				end
				self.Value = filtered
			else
				local found = false
				for _, candidate in ipairs(list) do
					if candidate == self.Value then found = true break end
				end
				if not found then self.Value = list[1] or "" end
			end
			display()
			if self.IsOpen then self:_BuildOptions() end
		end

		function comp:GetOptions()
			local copy = {}
			for index, option in ipairs(self.Options) do copy[index] = option end
			return copy
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
			if not self.Visible then self:_ClosePopup() end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			self:_ClosePopup()
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		comp.Maid:Add(box.MouseButton1Click:Connect(function() comp:ToggleMenu() end))

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		if config.Enabled == false then comp:SetEnabled(false) end
		display()
		section:_register(comp)
		return comp
	end

	return Dropdown
end

