	-- ── container da GUI: gethui → PlayerGui → CoreGui ────────────────
	local function findParent()
		local function probe(container)
			if not container then return false end
			return pcall(function()
				local test = Instance.new("ScreenGui")
				test.Name = "_ExpanderProbe"
				test.Parent = container
				test:Destroy()
			end)
		end

		local okHui, hui = pcall(function()
			if type(gethui) == "function" then return gethui() end
			return nil
		end)
		if okHui and hui and probe(hui) then return hui, "gethui" end

		local players = game:GetService("Players")
		local localPlayer = players.LocalPlayer
		if localPlayer then
			local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
			if not playerGui then
				local okWait, waited = pcall(function() return localPlayer:WaitForChild("PlayerGui", 5) end)
				if okWait then playerGui = waited end
			end
			if playerGui and probe(playerGui) then return playerGui, "PlayerGui" end
		end

		local okCore, core = pcall(function() return game:GetService("CoreGui") end)
		if okCore and core and probe(core) then return core, "CoreGui" end

		-- servidor: qualquer PlayerGui existente serve (GUI replicada)
		local playersList = players:GetPlayers()
		for _, candidate in ipairs(playersList) do
			local gui = candidate:FindFirstChildOfClass("PlayerGui")
			if gui and probe(gui) then return gui, "PlayerGui(" .. candidate.Name .. ")" end
		end

		return nil, nil
	end

	local function sanitize(text)
		return (tostring(text or "Window"):gsub("[^%w_%- ]", ""))
	end

	function Window.new(options)
		options = options or {}
		local palette = Env.Theme:Get()

		-- aceita UDim2, {largura, altura} ou {Width =, Height =} em pixels
		local size = options.Size
		if type(size) == "table" then
			local width = tonumber(size[1] or size.Width or (type(size.X) == "number" and size.X))
			local height = tonumber(size[2] or size.Height or (type(size.Y) == "number" and size.Y))
			if width and height then
				size = UDim2.fromOffset(width, height)
			end
		end

		local self = setmetatable({
			Title = options.Title or "EXPANDER",
			Subtitle = options.Subtitle or "",
			Size = size or UDim2.fromOffset(900, 580),
			Tabs = {},
			SelectedTab = nil,
			Minimized = false,
			Destroyed = false,
			Maid = Env.Maid.new(),
			Registry = Env.Registry.new(),
			OnCloseCallback = options.OnClose,
			_CloseCallbackSet = type(options.OnClose) == "function",
			_Order = 0,
		}, Window)

		self.Width = math.max(self.Size.X.Offset, 640)
		self.Height = math.max(self.Size.Y.Offset, 220)

		local parent, parentName = findParent()
		if not parent then
			error("nenhum container de GUI acessível (gethui, PlayerGui, CoreGui)")
		end
		self.ParentName = parentName

		local guiName = "ExpanderUI_" .. sanitize(self.Title)
		self.GuiName = guiName

		self.ScreenGui = U.New("ScreenGui", {
