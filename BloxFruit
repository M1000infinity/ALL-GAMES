--============================================================================
-- [10] DROPDOWN POPUP (shared singleton — created lazily on first open)
--============================================================================

local DropdownPopup = nil

local function BuildDropdownPopup()
    local POPUP_WIDTH  = 200
    local OPTION_HEIGHT = 30
    local SEARCH_ROW    = 34
    local MAX_LIST      = 280
    local SCREEN_MARGIN = 6

    local blocker = NewInstance("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Active = true,
        Text = "",
        AutoButtonColor = false
    })

    local popup = NewInstance("Frame", "Dropdown", blocker, {
        Size = UDim2.fromOffset(POPUP_WIDTH, 100),
        Position = UDim2.fromOffset(50, 50),
        Active = true,
        Elements = {
            Corner = UDim.new(0, 8),
            Stroke = {
                ThemeTag = { Color = "Colors.Border.Default" }
            },
            Gradient = {
                Rotation = 45,
                ThemeTag = { Color = "Colors.Background" }
            }
        },
        ThemeTag = {
            BackgroundTransparency = "BackgroundTransparency"
        }
    })

    local searchBox = NewInstance("TextBox", "SearchBox", popup, {
        Position = UDim2.new(0, 8, 0, 7),
        Size = UDim2.new(1, -16, 0, 24),
        PlaceholderText = "Search...",
        ClearTextOnFocus = false,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "",
        Elements = {
            Corner = UDim.new(0, 6),
            Padding = {
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8),
                PaddingTop = UDim.new(0, 0),
                PaddingBottom = UDim.new(0, 0)
            }
        },
        ThemeTag = {
            BackgroundColor3 = "Colors.Stroke",
            TextColor3 = "Colors.Text.Default",
            PlaceholderColor3 = "Colors.Text.Darker",
            Font = "Font.Medium"
        }
    })

    local emptyLabel = NewInstance("TextLabel", popup, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 0, 24),
        Position = UDim2.new(0, 8, 0, SEARCH_ROW + 8),
        Text = "No options",
        TextSize = 11,
        Visible = false,
        ThemeTag = {
            TextColor3 = "Colors.Text.Darker",
            Font = "Font.Normal"
        }
    })

    local listScroll = NewInstance("ScrollingFrame", popup, {
        Size = UDim2.new(1, -8, 1, -(SEARCH_ROW + 10)),
        Position = UDim2.new(0.5, 0, 1, -5),
        AnchorPoint = Vector2.new(0.5, 1),
        ScrollBarThickness = 3,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Active = true,
        ThemeTag = {
            OBJECTS = GlobalThemeScope,
            ScrollBarImageColor3 = "Colors.ScrollBar"
        },
        Elements = {
            Padding = {
                PaddingLeft   = UDim.new(0, 8),
                PaddingRight  = UDim.new(0, 8),
                PaddingTop    = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4)
            },
            ListLayout = {
                Padding = UDim.new(0, 4)
            }
        }
    })

    local registeredRows = {}
    local isOpen = false
    local multiSelect = false
    local holderFrame = nil
    local onOptionClicked = nil
    local currentOptions = nil
    local onClosed = nil
    local searchGraceTick = 0

    local function listHeight(count)
        local screenH = ScreenGui.AbsoluteSize.Y / WindowUIScale.Scale
        return math.min((OPTION_HEIGHT * math.max(count, 0.5)) + 8, MAX_LIST, screenH / 2.2)
    end

    local function popupHeight(count)
        return SEARCH_ROW + 10 + listHeight(count)
    end

    local function isMouseOverPopup()
        local pos, size = popup.AbsolutePosition, popup.AbsoluteSize
        local mouse = Vector2.new(PlayerMouse.X, PlayerMouse.Y)
        return mouse.X >= pos.X and mouse.X <= (pos.X + size.X)
           and mouse.Y >= pos.Y and mouse.Y <= (pos.Y + size.Y)
    end

    local function positionPopup(optionCount)
        local holderPos  = holderFrame.AbsolutePosition
        local holderSize = holderFrame.AbsoluteSize
        local screen     = ScreenGui.AbsoluteSize
        local scale      = WindowUIScale.Scale

        local screenW, screenH = screen.X / scale, screen.Y / scale
        local hX, hY = holderPos.X / scale, holderPos.Y / scale
        local hW, hH = holderSize.X / scale, holderSize.Y / scale

        local height = popupHeight(optionCount)
        local centerY = hY + (hH / 2)
        local y = math.clamp(centerY - (height / 2), SCREEN_MARGIN, screenH - height - SCREEN_MARGIN)

        local anchor = Vector2.new(0, 0)
        if y > (screenH * 0.7) then
            anchor = Vector2.new(0, 1)
            y = math.min(centerY + (height / 2), screenH - SCREEN_MARGIN)
        end

        local x = math.clamp(hX, SCREEN_MARGIN, math.max(SCREEN_MARGIN, screenW - popup.Size.X.Offset - SCREEN_MARGIN))
        popup.AnchorPoint = anchor
        popup.Position = UDim2.fromOffset(x, y)
    end

    local function filterMatches(option, firstChar, query)
        local include = true
        if firstChar == "+" or firstChar == "-" then
            include = option.Selected == (firstChar == "+")
            query = query:sub(2, -1)
        end
        return include and option.SearchText:find(query, 1, true) ~= nil
    end

    local function applySearchFilter()
        local rawText = searchBox.Text
        local firstChar = string.sub(rawText, 1, 1)
        local query = SanitizeSearchText(rawText)
        local visibleCount = 0
        if currentOptions then
            for _, option in ipairs(currentOptions) do
                local visible = #query == 0 or filterMatches(option, firstChar, query)
                if option.Instance then
                    option.Instance.Visible = visible
                end
                if visible then
                    visibleCount = visibleCount + 1
                end
            end
        end
        emptyLabel.Visible = visibleCount == 0
        emptyLabel.Text = currentOptions and #currentOptions == 0 and "No options" or "No results found"
        popup.Size = UDim2.fromOffset(POPUP_WIDTH, popupHeight(math.max(visibleCount, 1)))
        if holderFrame then positionPopup(math.max(visibleCount, 1)) end
    end

    local closePopup -- forward

    -- option button factory
    local function createOptionButton(option, fromRefresh)
        local row = NewInstance("TextButton", {
            Size = UDim2.new(1, 0, 0, OPTION_HEIGHT),
            AutoButtonColor = false,
            Text = "",
            Elements = {
                Corner = UDim.new(0, 6)
            },
            ThemeTag = {
                BackgroundColor3 = "Colors.Buttons.Default"
            },
            Childs = {
                NewInstance("Frame", {
                    Position = UDim2.new(0, 2, 0.5),
                    Size = UDim2.new(0, 6, 0, 6),
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Elements = {
                        Corner = UDim.new(0.5, 0)
                    },
                    ThemeTag = {
                        BackgroundColor3 = "Colors.Primary"
                    }
                }),
                NewInstance("TextLabel", {
                    Size = UDim2.fromScale(1, 1),
                    Position = UDim2.fromOffset(14, 0),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    TextTransparency = 0.4,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Text = option.DisplayName,
                    TextSize = 11,
                    ThemeTag = {
                        Font = "Font.Bold",
                        TextColor3 = "Colors.Text.Default"
                    }
                }),
                NewInstance("TextLabel", "Check", {
                    Size = UDim2.new(0, 16, 1, 0),
                    Position = UDim2.new(1, -8, 0, 0),
                    AnchorPoint = Vector2.new(1, 0),
                    BackgroundTransparency = 1,
                    Text = "✓",
                    TextSize = 12,
                    Visible = false,
                    ThemeTag = {
                        Font = "Font.Bold",
                        TextColor3 = "Colors.Primary"
                    }
                })
            }
        })

        local clickDebounce = 0
        Connect(row.Activated, function()
            if (tick() - clickDebounce) < 0 then return end
            if blocker.Parent and isOpen then
                clickDebounce = tick() + 0.2
                if onOptionClicked then
                    onOptionClicked(option)
                end
            end
        end)

        option.SearchText = SanitizeSearchText(option.DisplayName)
        option.Instance = row

        if fromRefresh then
            local rawText = searchBox.Text
            if #rawText > 0 then
                local firstChar = string.sub(rawText, 1, 1)
                local query = SanitizeSearchText(rawText)
                row.Visible = filterMatches(option, firstChar, query)
            end
            row.Parent = listScroll
        end

        DropdownPopup.SetOptionValue(option, option.Selected)
        return row
    end

    -- visual state of a single option row
    local function setOptionValue(option, selected)
        option.Selected = selected
        if option.Instance then
            local row = option.Instance
            local label = row.TextLabel
            local dot = row.Frame
            local check = row.Check
            local dotTransparency = selected and 0 or (multiSelect and 0.8 or 1)
            local textTransparency = selected and 0 or 0.4
            local dotSize = UDim2.fromOffset(6, selected and 14 or 6)
            if row.Parent then
                Tween(dot, "BackgroundTransparency", dotTransparency, 0.22):Play()
                Tween(label, "TextTransparency", textTransparency, 0.22):Play()
                Tween(dot, "Size", dotSize, 0.22):Play()
                check.Visible = selected and multiSelect or false
            else
                label.TextTransparency = textTransparency
                dot.BackgroundTransparency = dotTransparency
                dot.Size = dotSize
                check.Visible = selected and multiSelect or false
            end
        end
    end

    local function detachOptions()
        for row in pairs(registeredRows) do
            row.Parent = nil
            registeredRows[row] = nil
        end
    end

    closePopup = function()
        if not isOpen then return end
        isOpen = false
        searchBox.Text = ""
        local shrink = Tween(popup, "Size", UDim2.fromOffset(POPUP_WIDTH, 0), 0.14)
        shrink:Play()
        shrink.Completed:Wait()
        if blocker.Parent == DropdownsFolder then
            blocker.Parent = nil
        end
        if onClosed then
            local handler = onClosed
            onClosed = nil
            task.defer(handler)
        end
    end

    local function openPopup(closeHandler)
        if not isOpen then
            onClosed = closeHandler
            isOpen = true
            blocker.Parent = DropdownsFolder
            return true
        end
        return false
    end

    local function setOptions(options)
        detachOptions()
        currentOptions = options
        for _, option in ipairs(options) do
            if option.Instance == nil then
                createOptionButton(option)
            end
            option.Instance.Parent = listScroll
            registeredRows[option.Instance] = true
        end
        searchBox.Text = ""
        emptyLabel.Visible = #options == 0
        emptyLabel.Text = "No options"
        positionPopup(#options)
        Tween(popup, "Size", UDim2.fromOffset(POPUP_WIDTH, popupHeight(#options)), 0.2):Play()
    end

    -- outside interactions close the popup (same contract as the legacy lib)
    local function considerClosing()
        if searchBox:IsFocused() then
            searchGraceTick = tick()
            return nil
        end
        if (tick() - searchGraceTick) >= 0.3 and not isMouseOverPopup() then
            closePopup()
        end
    end

    Connect(WindowMainFrame:GetPropertyChangedSignal("Visible"), considerClosing)
    Connect(WindowMainFrame:GetPropertyChangedSignal("Size"), considerClosing)
    Connect(blocker.MouseButton1Down, considerClosing)
    Connect(blocker.Activated, considerClosing)
    Connect(searchBox:GetPropertyChangedSignal("Text"), applySearchFilter)

    DropdownPopup = table.freeze({
        CreateOptionTemplate = createOptionButton,
        SetOptionValue = setOptionValue,
        CloseDropdown = closePopup,
        OpenDropdown = openPopup,
        SetOptions = setOptions,
        Clear = detachOptions,
        SetOnClicked = function(handler) onOptionClicked = handler end,
        SetMultiSelect = function(enabled) multiSelect = enabled end,
        SetHolder = function(holder) holderFrame = holder end
    })

    return DropdownPopup
end

