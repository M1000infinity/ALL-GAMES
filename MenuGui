local function loadLibrary()
	-- injeção direta (usada pelos testes automatizados)
	if type(ExpanderLibrary) == "table" and type(ExpanderLibrary.CreateWindow) == "function" then
		return ExpanderLibrary
	end
	-- executor: a biblioteca se registrou em getgenv() quando foi executada
	if type(getgenv) == "function" then
		local ok, env = pcall(getgenv)
		if ok and type(env) == "table" and type(env.Expander) == "table" then
			return env.Expander
		end
	end
	-- Studio: ModuleScript irmão chamado "ExpanderUI"
	if script and script.Parent then
		local module = script.Parent:FindFirstChild("ExpanderUI")
		if module then
			local ok, lib = pcall(require, module)
