		if not section then return nil end
		return section:CreateColorPicker(config)
	end
	function Tab:CreateDivider()
		local section = self:_EnsureDefaultSection()
		if not section then return nil end
		return section:CreateDivider()
	end

	function Tab:SetName(name)
		self.Name = tostring(name or self.Name)
		self.Page.Name = "Tab_" .. self.Name
		if self.Window then self.Window:_RefreshNav() end
		return self
	end

	function Tab:Select()
		if self.Window then self.Window:SelectTab(self) end
	end

	function Tab:IsSelected()
		return self.Selected == true
	end

	function Tab:Show(value)
		local visible = value ~= false
		self.Page.Visible = visible
		self.Selected = visible
	end

	function Tab:GetComponents()
		local list = {}
		for _, section in ipairs(self.Sections) do
			for _, component in ipairs(section:GetComponents()) do
				table.insert(list, component)
			end
		end
		return list
	end

	function Tab:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true

		local sections = {}
		for index, section in ipairs(self.Sections) do sections[index] = section end
		for _, section in ipairs(sections) do
			pcall(function() section:Destroy() end)
		end
		self.Sections = {}

		if self.Window then self.Window:_ForgetTab(self) end
		self.Maid:Clean()
		if self.Page then self.Page:Destroy() end
		self.Page = nil
	end

	return Tab
end

