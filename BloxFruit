    return self
end

function TextBoxClass:SetTextFilter(filter)
    if filter ~= nil then
        assert(type(filter) == "function", ("\"TextBox.SetTextFilter[param 1]\". 'function', or 'nil' expected, got " .. tostring(typeof(filter))))
    end
    self.TEXTBOX_TEXT_FILTER = filter
    return self
