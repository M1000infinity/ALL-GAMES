-- ── encerramento limpo ────────────────────────────────────────────────
function Example.Destroy()
	if Example.Window then
		Example.Window:Destroy()
	end
	Example.Window = nil
	Example.Tabs = {}
	Example.Controls = {}
	Example.TempSection = nil
end

function Example.IsRunning()
	return Example.Window ~= nil and Example.Window.Destroyed == false
end

