local function _xor(a,b)
 if bit32 and bit32.bxor then return bit32.bxor(a,b) end
 local v,p=0,1
 while a>0 or b>0 do
  local x,y=a%2,b%2
  if x~=y then v=v+p end
  a=(a-x)/2 b=(b-y)/2 p=p*2
 end
 return v
end
local function _b64(s)
 local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
 local map={} for i=1,64 do map[string.byte(alphabet,i)]=i-1 end
 local out={} local acc,bits=0,0
 for i=1,#s do
  local c=string.byte(s,i)
  if c==61 then break end
  local v=map[c]
  if v==nil then error("Luau Cryptor: Base64 invalido",0) end
  acc=acc*64+v bits=bits+6
  if bits>=8 then
   bits=bits-8 local factor=2^bits
   out[#out+1]=string.char(math.floor(acc/factor))
   acc=acc%factor
  end
 end
 return table.concat(out)
end
local function _decode(s,k)
 local out={}
 for i=1,#s do out[i]=string.char(_xor(string.byte(s,i),string.byte(k,(i-1)%#k+1))) end
 return table.concat(out)
end
local function _unpack(s)
 local out={} local i=1
 while i<=#s do
  local b=string.byte(s,i) i=i+1
  if b~=254 then out[#out+1]=string.char(b)
  else
   local n=string.byte(s,i) i=i+1
   if n==nil then error("Luau Cryptor: RLE incompleto",0) end
   if n==0 then out[#out+1]=string.char(254)
   else
    local v=string.byte(s,i) i=i+1
    if v==nil then error("Luau Cryptor: RLE incompleto",0) end
    out[#out+1]=string.rep(string.char(v),n)
   end
  end
 end
 return table.concat(out)
end
local function _check(s)
