---------------------------------- Dialog -----------------------------------

local function CloseDialogImmediate()
    if CurrentDialog then
        CurrentDialog.Closed = true
        CurrentDialog.Closing = false
        setmetatable(CurrentDialog, nil)
        CurrentDialog = nil
        DialogRefs.OutBox.Parent = nil
    end
end

function DialogClass:NewOption(config)
    local title = config[1] or config.Name or config.Title
    local callbacks = PackCallback(config[2] or config.Callback)
    table.insert(callbacks, function()
        if CurrentDialog then
            CurrentDialog:Close()
        end
    end)
    assert(type(title) == "string", ("\"Dialog.NewOption.Name\". 'string' expected, got " .. tostring(typeof(title))))

    local button = NewInstance("TextButton", {
        AutoButtonColor = false,
        Size = UDim2.fromScale(0.2, 1),
        BackgroundTransparency = 1,
        TextSize = 10,
        Text = title,
        Elements = {
            Corner = UDim.new(1, 0)
        },
        ThemeTag = {
            BackgroundColor3 = "Colors.Buttons.Default",
            TextColor3 = "Colors.Text.Dark",
            Font = "Font.Normal"
        }
    })

    local fadeIn  = Tween(button, "BackgroundTransparency", 0, 0.16)
    local fadeOut = Tween(button, "BackgroundTransparency", 1, 0.16)

    Connect(button.MouseLeave, function() fadeOut:Play() end)
    Connect(button.MouseEnter, function() fadeIn:Play()  end)
    Connect(button.Activated,  function() FireCallbacks(callbacks) end)

    -- press feedback: quick shrink via UIScale
    local pressScale = NewInstance("UIScale", button)
    Connect(button.MouseButton1Down, function()
        Tween(pressScale, "Scale", 0.94, 0.08):Play()
    end)
    Connect(button.MouseButton1Up, function()
        Tween(pressScale, "Scale", 1, 0.12):Play()
    end)

    button.Parent = DialogRefs.Template.Options
end

function DialogClass:Close(wait)
    if self.Closed or self.Closing or CurrentDialog ~= self then
        return nil
    end
    self.Closing = true
    local shrink = Tween(self.TEMPLATE, "Size", self.NEW_SIZE, 0.18)
    shrink:Play()
    if wait then
        shrink.Completed:Wait()
        CloseDialogImmediate()
    else
        Connect(shrink.Completed, CloseDialogImmediate)
        if not Motion.Enabled then CloseDialogImmediate() end
    end
end

function DialogClass.new(descriptionLabel, titleLabel)
    return setmetatable({
        TITLE_LABEL = titleLabel,
        DESCRIPTION_LABEL = descriptionLabel,
        Content = descriptionLabel.Text,
        Title = titleLabel.Text,
        Closed = false,
        Closing = false,
        Kind = "Dialog"
    }, DialogClass)
end

