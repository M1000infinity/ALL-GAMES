-- STATE MANAGER — valores nomeados, observáveis e tipados
--
--   local state = State.new()
--   state:Set("autoFarm", true)
--   state:Get("autoFarm")            --> true
--   state:Watch("autoFarm", fn)      --> conexão
--   state:Toggle("autoFarm")
--   state:Snapshot()                 --> cópia de tudo
-- ═══════════════════════════════════════════════════════════════════════
MODULES["StateManager"] = function(Env)
	local Signal = Env.Signal

	local State = {}
	State.__index = State

	function State.new(initial)
		local self = setmetatable({
			_values = {},
			_defaults = {},
			_watchers = {},
			_changed = Signal.new(),
		}, State)

		if type(initial) == "table" then
			for key, value in pairs(initial) do
				self._values[key] = value
				self._defaults[key] = value
			end
		end
		return self
	end

	function State:Set(key, value, silent)
		assert(type(key) == "string" and key ~= "", "State:Set precisa de uma chave de texto")
		local previous = self._values[key]
		self._values[key] = value
		if not silent then
			local list = self._watchers[key]
			if list then
				for index = #list, 1, -1 do
					if list[index] then
						local ok, err = pcall(list[index].fn, value, previous)
						if not ok then
							warn("[Expander] erro em watcher de '" .. key .. "': " .. tostring(err))
						end
					end
				end
			end
			self._changed:Fire(key, value, previous)
		end
		return value
	end

	function State:Get(key, fallback)
		local value = self._values[key]
		if value == nil then return fallback end
		return value
	end

	function State:Has(key)
		return self._values[key] ~= nil
	end

	function State:Toggle(key)
		return self:Set(key, not self:Get(key))
	end

	function State:Watch(key, fn)
		self._watchers[key] = self._watchers[key] or {}
		local entry = {fn = fn, alive = true}
		table.insert(self._watchers[key], entry)

		local owner = self
		local connection = {Connected = true}
		function connection:Disconnect()
			if not self.Connected then return end
			self.Connected = false
			entry.alive = false
			local list = owner._watchers[key]
			for index = #list, 1, -1 do
				if list[index] == entry then table.remove(list, index) break end
			end
		end
		return connection
	end

	function State:OnChanged(fn)
		return self._changed:Connect(fn)
	end

	function State:Snapshot()
		local out = {}
		for key, value in pairs(self._values) do out[key] = value end
		return out
	end

	function State:Reset()
		self._values = {}
		for key, value in pairs(self._defaults) do self._values[key] = value end
		self._changed:Fire(nil, nil, nil)
	end

	return State
end

