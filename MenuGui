-- ── módulo: Signal (src/Utilities/Signal.lua) ────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════
-- SIGNAL — emissor de eventos mínimo (sem dependências)
--   local s = Signal.new()
--   local conn = s:Connect(fn)   -- conn:Disconnect()
--   s:Fire(...)                  -- dispara cópia segura da lista
--   s:DisconnectAll()
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Signal"] = function(Env)
	local Signal = {}
	Signal.__index = Signal

	function Signal.new()
		return setmetatable({_handlers = {}, _count = 0}, Signal)
	end

	function Signal:Connect(fn)
		assert(type(fn) == "function", "Signal:Connect espera uma função")
		local entry = {fn = fn, alive = true}
		table.insert(self._handlers, entry)
		self._count = self._count + 1

		local owner = self
		local connection = {Connected = true}
		function connection:Disconnect()
			if not self.Connected then return end
			self.Connected = false
			entry.alive = false
			for index = #owner._handlers, 1, -1 do
				if owner._handlers[index] == entry then
					table.remove(owner._handlers, index)
					break
				end
			end
		end
		function connection:Fire(...)
			owner:Fire(...)
		end
		return connection
	end

	function Signal:Fire(...)
		-- cópia: um handler pode desconectar outro durante o disparo
		local snapshot = {}
		for index, entry in ipairs(self._handlers) do
			snapshot[index] = entry
		end
		for _, entry in ipairs(snapshot) do
			if entry.alive then
				local ok, err = pcall(entry.fn, ...)
				if not ok then
					warn("[Expander] erro em listener: " .. tostring(err))
				end
			end
		end
	end

	function Signal:DisconnectAll()
		for _, entry in ipairs(self._handlers) do
			entry.alive = false
		end
		self._handlers = {}
		self._count = 0
	end

	function Signal:Count()
		return #self._handlers
	end

	return Signal
end

-- ── módulo: Maid (src/Utilities/Maid.lua) ────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════
-- MAID — limpeza determinística de tudo que um objeto cria
--   maid:Add(instância | conexão | função | thread)
--   maid:Clean()  /  maid:Destroy()
-- Aceita qualquer coisa com método Destroy, Disconnect ou Cancel.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Maid"] = function(Env)
	local Maid = {}
	Maid.__index = Maid

	function Maid.new()
		return setmetatable({_tasks = {}, _cleaning = false}, Maid)
	end

	local function release(item)
		if item == nil then return end
		local kind = typeof and typeof(item) or type(item)
		if kind == "Instance" then
			pcall(function() item:Destroy() end)
		elseif kind == "RBXScriptConnection" or (type(item) == "table" and type(item.Disconnect) == "function") then
			pcall(function() item:Disconnect() end)
		elseif type(item) == "table" and type(item.Destroy) == "function" then
			pcall(function() item:Destroy() end)
		elseif type(item) == "table" and type(item.Clean) == "function" then
			pcall(function() item:Clean() end)
		elseif type(item) == "function" then
			pcall(item)
		elseif type(item) == "thread" then
			pcall(function() coroutine.close(item) end)
		end
	end

	function Maid:Add(item)
		if item == nil then return item end
		if self._cleaning then
			release(item)
			return item
		end
		table.insert(self._tasks, item)
		return item
	end

	function Maid:Clean()
		self._cleaning = true
		local tasks = self._tasks
		self._tasks = {}
		for index = #tasks, 1, -1 do
			release(tasks[index])
			tasks[index] = nil
		end
		self._cleaning = false
	end

	Maid.Destroy = Maid.Clean
	Maid.GiveTask = Maid.Add

	return Maid
end

-- ── módulo: Layout (src/Utilities/Layout.lua) ────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════
-- LAYOUT — criação de instâncias e utilidades visuais
-- Tudo aqui é "burro": não conhece componentes, só facilita a vida.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Layout"] = function(Env)
	local U = {}

	-- ── Serviços / ambiente ────────────────────────────────────────────
	local TweenService = game:GetService("TweenService")
	local RunService = game:GetService("RunService")

	U.TweenService = TweenService
	U.RunService = RunService

	local okInput, userInput = pcall(function() return game:GetService("UserInputService") end)
	U.UserInput = okInput and userInput or nil

	-- task com fallback para ambientes 5.1 puros
	local Task = task
	if not Task then
		Task = {
			spawn = function(fn, ...)
				local co = coroutine.create(fn)
				coroutine.resume(co, ...)
				return co
			end,
			delay = function(seconds, fn, ...)
				local args = {...}
				local co = coroutine.create(function()
					if type(wait) == "function" then wait(seconds) end
					fn(table.unpack(args))
				end)
				coroutine.resume(co)
				return co
			end,
			wait = function(seconds)
				if type(wait) == "function" then return wait(seconds) end
				return 0
			end,
		}
	end
	U.Task = Task

	if not table.unpack and unpack then table.unpack = unpack end
	if not table.pack then table.pack = function(...) return {n = select("#", ...), ...} end end

	-- ── Números ────────────────────────────────────────────────────────
	function U.Clamp(value, low, high)
		if value < low then return low end
		if value > high then return high end
		return value
	end

	function U.Round(value, step)
		if not step or step <= 0 then return value end
		return math.floor(value / step + 0.5) * step
	end

	function U.Lerp(a, b, alpha)
		return a + (b - a) * alpha
	end

	function U.FormatNumber(value, decimals)
		if decimals and decimals > 0 then
			return string.format("%." .. tostring(decimals) .. "f", value)
		end
		return tostring(math.floor(value + 0.5))
	end

	-- ── Instâncias ─────────────────────────────────────────────────────
	function U.New(class, props)
		local instance = Instance.new(class)
		if props then
			local parent = nil
			for key, value in pairs(props) do
				if key == "Parent" then
					parent = value
				else
					instance[key] = value
				end
			end
			if parent then instance.Parent = parent end
		end
		return instance
	end

	function U.Corner(instance, radius)
		return U.New("UICorner", {
			CornerRadius = UDim.new(0, radius or 8),
			Parent = instance,
		})
	end

	function U.Stroke(instance, color, thickness, transparency)
		return U.New("UIStroke", {
			Color = color or Color3.fromRGB(40, 40, 60),
			Thickness = thickness or 1,
			Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = instance,
		})
	end

	function U.Gradient(instance, colorA, colorB, rotation)
		return U.New("UIGradient", {
			Color = ColorSequence.new(colorA, colorB),
			Rotation = rotation or 0,
			Parent = instance,
		})
	end

	function U.Padding(instance, top, right, bottom, left)
		return U.New("UIPadding", {
			PaddingTop = UDim.new(0, top or 0),
			PaddingRight = UDim.new(0, right or 0),
			PaddingBottom = UDim.new(0, bottom or 0),
			PaddingLeft = UDim.new(0, left or 0),
			Parent = instance,
		})
	end

	-- opts: Padding, Horizontal, Align, Order
	function U.List(parent, opts)
		opts = opts or {}
		return U.New("UIListLayout", {
			Padding = UDim.new(0, opts.Padding or 8),
			FillDirection = opts.Horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
			HorizontalAlignment = opts.Align or Enum.HorizontalAlignment.Left,
			VerticalAlignment = opts.VerticalAlign or Enum.VerticalAlignment.Top,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = parent,
		})
	end

	-- TextLabel curto. opts: Font, Size, Color, X, Y, Align, Wrap, Truncate
	function U.Label(parent, text, opts)
		opts = opts or {}
		return U.New("TextLabel", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = opts.Font or Enum.Font.Gotham,
			TextSize = opts.Size or 12,
			TextColor3 = opts.Color or Color3.new(1, 1, 1),
			Text = text or "",
			TextXAlignment = opts.Align or Enum.TextXAlignment.Left,
			TextYAlignment = opts.VAlign or Enum.TextYAlignment.Center,
			TextWrapped = opts.Wrap == true,
			TextTruncate = opts.Truncate or Enum.TextTruncate.AtEnd,
			RichText = false,
			Parent = parent,
		})
	end

	-- ── Animação ───────────────────────────────────────────────────────
	-- Velocidade global: Theme.AnimSpeed (0 desliga animações)
	U.AnimSpeed = 1

	function U.Tween(instance, duration, props, style, direction)
		if not instance then return nil end
		local speed = U.AnimSpeed or 1
		if speed <= 0 or not duration or duration <= 0 then
			pcall(function()
				for key, value in pairs(props or {}) do instance[key] = value end
			end)
			return nil
		end
		local info = TweenInfo.new(duration / speed, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
		local ok, tween = pcall(function()
			return TweenService:Create(instance, info, props)
		end)
		if not ok or not tween then return nil end
		tween:Play()
		return tween
	end

	U.Delay = function(seconds, fn, ...)
		return Task.delay(seconds, fn, ...)
	end

	U.Spawn = function(fn, ...)
		return Task.spawn(fn, ...)
	end

	function U.Wait(seconds)
		return Task.wait(seconds)
	end

	-- ── Chamadas seguras ──────────────────────────────────────────────
	-- Nunca deixa um callback do usuário derrubar a interface.
	function U.SafeCall(label, fn, ...)
		if type(fn) ~= "function" then return false end
		-- Os argumentos são capturados na closure: xpcall com varargs só
		-- existe em Lua 5.2+, e o alvo aqui é 5.1/Roblox.
		local args = {...}
		local ok, err = xpcall(function()
			return fn(table.unpack(args))
		end, function(message)
			return tostring(message) .. "\n" .. debug.traceback("", 2)
		end)
		if not ok then
			warn("[Expander] erro em " .. tostring(label or "callback") .. ": " .. tostring(err))
			U.LastError = tostring(err)
			if U.OnError then
				pcall(U.OnError, label, err)
			end
		end
		return ok
	end

	-- ── Texto ──────────────────────────────────────────────────────────
	function U.FormatClock(seconds)
		seconds = math.max(0, math.floor(seconds or 0))
		local hours = math.floor(seconds / 3600)
		local minutes = math.floor((seconds % 3600) / 60)
		local secs = seconds % 60
		if hours > 0 then
			return string.format("%02d:%02d:%02d", hours, minutes, secs)
		end
		return string.format("%02d:%02d", minutes, secs)
	end

	-- cor -> "#RRGGBB" (para documentação/notificações)
	function U.Hex(color)
		if not color then return "#000000" end
		return string.format("#%02X%02X%02X",
			math.floor(color.R * 255 + 0.5),
			math.floor(color.G * 255 + 0.5),
			math.floor(color.B * 255 + 0.5))
	end

	-- alfa visual: 0 = opaco, 1 = invisível
	function U.Alpha(theme, base)
		return U.Clamp(base + (theme.Transparency or 0), 0, 1)
	end

	return U
end

