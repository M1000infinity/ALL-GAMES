function ToggleClass:SetValue(value)
    assert(type(value) == "boolean", ("\"Toggle.SetValue\". 'boolean' expected, got " .. tostring(typeof(value))))
    if self.Value ~= value then
        self.Value = value
        self.WHEN_VALUE_CHANGED(value)
    end
end

function ToggleClass.new(parent, row, titleLabel, descLabel, onChanged, callbacks)
