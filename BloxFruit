CreateDynamicStub = function(parentObj, childName)
    local noopConn = { Disconnect = function() end, Connected = true }
    local noopSignal = {
        Connect = function() return noopConn end,
        Once = function() return noopConn end,
        Wait = function() task.wait(1) return nil end
    }
    local resolveReal = function()
        if parentObj and type(parentObj) ~= "table" then
            local ok, found = pcall(rawFindFirstChild, parentObj, childName)
            if ok and found then
                return found
            end
        end
        return nil
    end
    local stub = {
        __isStub = true,
        Name = childName or "Stub",
        ClassName = "Folder",
        Value = 0,
        Visible = false,
        Enabled = false,
        Text = "",
        Position = Vector3.zero,
        CFrame = CFrame.new(),
        Parent = parentObj,
        ChildAdded = noopSignal,
        ChildRemoved = noopSignal,
        DescendantAdded = noopSignal,
        DescendantRemoving = noopSignal,
        AncestryChanged = noopSignal,
        Changed = noopSignal,
        Activated = noopSignal,
        MouseButton1Click = noopSignal,
        TouchEnded = noopSignal,
        Touched = noopSignal,
        GetPropertyChangedSignal = function() return noopSignal end,
        GetAttributeChangedSignal = function() return noopSignal end,
        GetAttribute = function(self, attr)
            local real = resolveReal()
            if real then return GetAttribute(real, attr) end
            return nil
        end,
        SetAttribute = function(self, attr, val)
            local real = resolveReal()
            if real then SetAttribute(real, attr, val) end
        end,
        GetChildren = function()
            local real = resolveReal()
            if real then
                local ok, ch = pcall(real.GetChildren, real)
                if ok and ch then return ch end
            end
            return {}
        end,
        GetDescendants = function()
            local real = resolveReal()
            if real then
                local ok, ch = pcall(real.GetDescendants, real)
                if ok and ch then return ch end
            end
            return {}
        end,
        FindFirstChild = function(self, name, rec)
            local real = resolveReal()
            if real then
                return FindFirstChild(real, name, rec)
            end
            return nil
        end,
        WaitForChild = function(self, name, timeout)
            local real = resolveReal()
            if real then
                local found = FindFirstChild(real, name)
                if found then return found end
                local ok, w = pcall(rawWaitForChild, real, name, timeout or 2)
                if ok and w then return w end
                return CreateDynamicStub(real, name)
            end
            return CreateDynamicStub(self, name)
        end,
        InvokeServer = function(self, ...)
            local real = resolveReal()
            if real and real.InvokeServer then
                return real:InvokeServer(...)
            end
            return nil
        end,
        FireServer = function(self, ...)
            local real = resolveReal()
            if real and real.FireServer then
                return real:FireServer(...)
            end
        end,
        Destroy = function() end,
        Clone = function(self) return self end,
        IsA = function() return false end,
        GetPivot = function() return CFrame.new() end
    }
    return setmetatable(stub, {
        __index = function(t, k)
            local real = resolveReal()
            if real then
                local ok, val = pcall(function() return real[k] end)
                if ok and val ~= nil then
                    if type(val) == "function" then
                        return function(_, ...)
                            return val(real, ...)
                        end
                    end
                    return val
                end
            end
            local childStub = CreateDynamicStub(nil, tostring(k))
            rawset(t, k, childStub)
            return childStub
        end,
        __newindex = function(t, k, v)
            local real = resolveReal()
            if real then
                pcall(function() real[k] = v end)
            else
                rawset(t, k, v)
            end
        end
    })
end

local WaitForChild = function(parentObj, childName, timeout)
    if not parentObj then
        return CreateDynamicStub(nil, childName)
    end
    if type(parentObj) == "table" then
        if type(parentObj.WaitForChild) == "function" then
            return parentObj:WaitForChild(childName, timeout)
        end
        return CreateDynamicStub(parentObj, childName)
    end
    local fast = FindFirstChild(parentObj, childName)
    if fast then
        return fast
    end
    local ok, res = pcall(rawWaitForChild, parentObj, childName, timeout or 3)
    if ok and res then
        return res
    end
    return CreateDynamicStub(parentObj, childName)
end

