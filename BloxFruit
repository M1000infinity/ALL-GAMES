-- MakeOptionRow(tab, titleText, descText, holderSize)
-- -> rowButton, titleLabel, descLabel  (standard "option card")
local function MakeOptionRow(tab, titleText, descText, holderSize)
    local tabScope = TabScopes[tab]
    local container = TabVisuals[tab].Container

    local backgroundTag = {
        OBJECTS = tabScope,
        BackgroundColor3 = "Colors.Buttons.Default"
    }
    local strokeTag = {
        OBJECTS = tabScope,
        Color = "Colors.Border.Default"
    }

    local titleLabel = NewInstance("TextLabel", {
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -20),
        Position = UDim2.fromScale(0, 0.5),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        TextSize = 12,
        ThemeTag = {
            OBJECTS = tabScope,
            TextColor3 = "Colors.Text.Default",
            Font = "Font.Medium"
        }
    })

    local descLabel = NewInstance("TextLabel", "Description", {
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -20),
        Position = UDim2.new(0, 12, 0, 15),
        BackgroundTransparency = 1,
        TextWrapped = true,
        TextSize = 9,
        RichText = true,
        ThemeTag = {
            OBJECTS = tabScope,
            TextColor3 = "Colors.Text.Dark",
            Font = "Font.Normal"
        }
    })

    local row = NewInstance("TextButton", "Option", {
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 34),
        AutoButtonColor = false,
        Text = "",
        ThemeTag = backgroundTag,
        Elements = {
            Corner = UDim.new(0, 8),
            Stroke = { ThemeTag = strokeTag }
        },
        Childs = {
            NewInstance("Frame", "Holder", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Size = holderSize,
                Elements = {
                    ListLayout = {
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        VerticalAlignment = Enum.VerticalAlignment.Center,
                        Padding = UDim.new(0, 2)
                    },
                    Padding = {
                        PaddingBottom = UDim.new(0, 7),
                        PaddingTop    = UDim.new(0, 7)
                    }
                },
                Childs = { titleLabel, descLabel }
            })
        }
    })

    local holder = row.Holder

    -- single-row hover manager (also restores the previous row)
    local function applyRowState(themeKey, isEntering)
        if isEntering then
            local previous = HoveredOptionRow
            if previous and previous ~= row and previous.Button.Parent then
                previous.Tag.BackgroundColor3 = "Colors.Buttons.Default"
                previous.Stroke.Color = ThemePath(Library.CurrentTheme, "Colors.Border.Default")
                Tween(previous.Button, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.Buttons.Default"), 0.16):Play()
            end
            HoveredOptionRow = { Button = row, Tag = backgroundTag, Stroke = row.UIStroke }
        end
        backgroundTag.BackgroundColor3 = themeKey
        local borderKey = isEntering and "Colors.Border.Holding" or "Colors.Border.Default"
        strokeTag.Color = borderKey
        Tween(row, "BackgroundColor3", ThemePath(Library.CurrentTheme, themeKey), 0.16):Play()
        Tween(row.UIStroke, "Color", ThemePath(Library.CurrentTheme, borderKey), 0.16):Play()
    end

    Connect(row.MouseLeave, function() applyRowState("Colors.Buttons.Default", false) end)
    Connect(row.MouseEnter, function() applyRowState("Colors.Buttons.Holding", true) end)

    -- auto show/hide the description label when its text changes
    Connect(descLabel:GetPropertyChangedSignal("Text"), function()
        local hasText = #descLabel.Text > 0
        if descLabel.Visible ~= hasText then
            if Library and Library.InterfaceConfig and Library.InterfaceConfig.ShowDescriptions == false then
                hasText = false
            end
            local anchorY = hasText and 0 or 0.5
            descLabel.Visible = hasText
            holder.Position = UDim2.fromScale(0, anchorY)
            holder.AnchorPoint = Vector2.new(0, anchorY)
        end
    end)

    descLabel.Text = descText or ""
    titleLabel.Text = titleText

    -- density registry: lets Compact Mode restyle every card live
    local densityEntry = { Row = row, Holder = holder }
    DensityRegistry[densityEntry] = true
    Connect(row.Destroying, function()
        DensityRegistry[densityEntry] = nil
        if HoveredOptionRow and HoveredOptionRow.Button == row then
            HoveredOptionRow = nil
        end
    end)

    row.Parent = container
    return row, titleLabel, descLabel
end

-- Config validators (identical contracts/messages as the legacy library)
local function ValidateOptionConfig(kind, config)
    if type(config) ~= "table" then
        error(("\"Tab.Add" .. tostring(kind) .. "[Configs]\". 'table' expected, got " .. tostring(typeof(config))), 2)
    end
    local title = config[1] or config.Name or config.Title
    local desc = config.Desc or config.Description
    assert(type(title) == "string", ("\"Tab.Add" .. tostring(kind) .. ".Title\". 'string' expected, got " .. tostring(typeof(title))))
    if desc ~= nil and type(desc) ~= "string" then
        error(("\"Tab.Add" .. tostring(kind) .. ".Description\". 'string', or 'nil' expected, got " .. tostring(typeof(desc))), 2)
    end
    return title, desc or ""
end

local function ValidateFlag(kind, flag)
    if flag ~= nil and type(flag) ~= "string" then
        error(("\"Tab.Add" .. tostring(kind) .. ".Flag\". 'nil', or 'string' expected, got " .. tostring(typeof(flag))), 2)
    end
    return flag
end

-- Registers an option row into the global search index.
local function RegisterOption(tab, kind, titleText, descText, row)
    table.insert(OptionIndex, {
        Tab = tab,
        Kind = kind,
        Title = titleText,
        SearchText = SanitizeSearchText(tostring(titleText)),
        SearchDesc = SanitizeSearchText(tostring(descText or "")),
        Row = row
    })
    Connect(row.Destroying, function()
        for index, entry in ipairs(OptionIndex) do
            if entry.Row == row then
                table.remove(OptionIndex, index)
                break
            end
        end
    end)
end

