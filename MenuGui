-- COMPONENT REGISTRY — índice de tudo que existe na janela
-- Usado pela busca e por DestroyAll. Cada componente entra ao ser criado
-- e sai ao ser destruído, sem duplicar entradas.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["ComponentRegistry"] = function(Env)
	local Signal = Env.Signal

	local Registry = {}
	Registry.__index = Registry

	function Registry.new()
		return setmetatable({
			_entries = {},
			_byId = {},
			_changed = Signal.new(),
			_nextId = 0,
		}, Registry)
	end

	function Registry:Add(component, meta)
		self._nextId = self._nextId + 1
		local id = "cmp_" .. tostring(self._nextId)
		local entry = {
			id = id,
			component = component,
			name = meta.name or "",
			description = meta.description or "",
			kind = meta.kind or "Component",
			tab = meta.tab,
			section = meta.section,
			searchText = string.lower((meta.name or "") .. " " .. (meta.description or "") .. " " .. (meta.kind or "")),
		}
		table.insert(self._entries, entry)
		self._byId[id] = entry
		self._changed:Fire(#self._entries)
		return id
	end

	function Registry:Remove(id)
		if not id or not self._byId[id] then return end
		self._byId[id] = nil
		for index = #self._entries, 1, -1 do
			if self._entries[index].id == id then
				table.remove(self._entries, index)
				break
			end
		end
		self._changed:Fire(#self._entries)
	end

	function Registry:Count()
		return #self._entries
	end

	function Registry:All()
		return self._entries
	end

	-- Busca por nome/descrição/tipo. Devolve lista de entradas (até limit).
	function Registry:Search(query, limit)
		query = string.lower(tostring(query or ""))
		if query == "" then return {} end
		local results = {}
		for _, entry in ipairs(self._entries) do
			if string.find(entry.searchText, query, 1, true) then
				table.insert(results, entry)
				if limit and #results >= limit then break end
			end
		end
		return results
	end

	function Registry:OnChanged(fn)
		return self._changed:Connect(fn)
	end

	function Registry:Clear()
		self._entries = {}
		self._byId = {}
		self._changed:Fire(0)
	end

	return Registry
end

