                    Flag = flagName
                })
                optionsMap[flagName] = toggleObj
                return toggleObj
            end
            return plugin
        end)

        ax("TweenManager", function()
            local tm = {}
            tm.__index = tm
            local activeTweens = {}
            local linearStyle = Enum.EasingStyle.Linear

            function tm.new(inst, duration, propName, targetVal)
                local selfObj = setmetatable({}, tm)
                selfObj.tween = k:Create(inst, TweenInfo.new(duration, linearStyle), { [propName] = targetVal })
                selfObj.tween:Play()
                selfObj.value = targetVal
                selfObj.object = inst
                if activeTweens[inst] then
                    activeTweens[inst]:destroy()
                end
                activeTweens[inst] = selfObj
                return selfObj
            end

            function tm:destroy()
                self.tween:Pause()
                self.tween:Destroy()
                activeTweens[self.object] = nil
                setmetatable(self, nil)
            end

            function tm:stopTween(inst)
                if inst and activeTweens[inst] then
                    activeTweens[inst]:destroy()
                end
            end

            return tm
        end)

