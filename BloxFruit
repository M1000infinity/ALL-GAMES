function SliderClass:SetValue(value)
    assert(type(value) == "number", ("\"Slider.SetValue\". 'number' expected, got " .. tostring(typeof(value))))
    if self.Value ~= value then
        self.WHEN_VALUE_CHANGED(value)
    end
end

function SliderClass.new(parent, row, titleLabel, descLabel, callbacks)
    return setmetatable({
        CALLBACKS = callbacks,
        DESTROY_ELEMENT = row,
