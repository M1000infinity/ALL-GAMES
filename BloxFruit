        if resizingTick and (tick() - resizingTick) <= 0.1 then
            return nil
        end

        Tween(resizer, "BackgroundTransparency", 0.5, 0.18):Play()
        while tick() - resizer:GetAttribute("Resizing") <= 0.1 do task.wait() end
        Tween(resizer, "BackgroundTransparency", 1, 0.22):Play()
    end

