local TabClass = {}
TabClass.__index = TabClass

local VALID_FLAG_TYPES do
    local set = {}
    for _, typeName in ipairs({ "number", "string", "nil", "boolean", "table" }) do
        set[typeName] = true
    end
    VALID_FLAG_TYPES = set
end

local KeyCodeSet = nil
local function IsKeyCode(value)
    if KeyCodeSet == nil then
        local set = {}
        for _, enumItem in ipairs(Enum.KeyCode:GetEnumItems()) do
            set[enumItem] = true
        end
        KeyCodeSet = set
    end
    return typeof(value) == "EnumItem" and KeyCodeSet[value] or false
end

function TabClass:GetNoSelfCall(methodName)
    assert(type(methodName) == "string", ("\"Tab.GetNoSelfCall\". 'string' expected, got " .. tostring(typeof(methodName))))
    local method = self[methodName]
    assert(type(method) == "function", ("\"Tab.GetNoSelfCall\". '" .. tostring(method) .. "' is not a 'function'-" .. tostring(methodName)))
    return function(...)
        return method(self, ...)
    end
end

