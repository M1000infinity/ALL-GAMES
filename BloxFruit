function Library:MakeWindow(config)
    if self.LOADED_UI_LIBRARY then
        return error("you can create only 1 Window", 2)
    end

    local screenUID = math.random()
    ScreenGui:SetAttribute("UID", screenUID)
    self.SCREENGUI_UID = screenUID
    ScreenGui:ClearAllChildren()

    local uiScale = NewInstance("UIScale", "Scale", ScreenGui, {
        Scale = ProportionalScale(1)
    })
    WindowUIScale = uiScale

    local windowConfig = {
        Title = config[1] or config.Name or config.Title,
        SubTitle = config[2] or config.SubName or config.SubTitle,
        ScriptFolder = config[3] or config.ScriptFolder or config.FolderName
    }

    assert(type(windowConfig.Title) == "string", ("\"Window.Title\". 'string' expected, got " .. tostring(typeof(windowConfig.Title))))
    assert(type(windowConfig.SubTitle) == "string", ("\"Window.SubTitle\". 'string' expected, got " .. tostring(typeof(windowConfig.SubTitle))))

    if windowConfig.ScriptFolder ~= nil and type(windowConfig.ScriptFolder) ~= "string" then
        return error(("\"Window.ScriptFolder\". 'string', or nil expected, got " .. tostring(typeof(windowConfig.ScriptFolder))), 2)
    end

    if windowConfig.ScriptFolder ~= nil and string.find(windowConfig.ScriptFolder, "/") then
        return error("\"Window.ScriptFolder\" is not valid, unexpected char \"/\"", 2)
    end

    -- LibrarySettings.json proxy (debounced writes; legacy-compatible format)
    local windowSettings = (function()
        local folder = windowConfig.ScriptFolder
        local saveScheduled = false

        local ok, stored = pcall(function()
            return folder and HttpService:JSONDecode(readFileFn((tostring(folder) .. "/LibrarySettings.json")))
        end)

        if type(stored) ~= "table" then
            stored = {}
        end

        local function scheduleSave()
            saveScheduled = false
            return pcall(function()
                return SafeWriteFile((tostring(folder) .. "/LibrarySettings.json"), HttpService:JSONEncode(stored))
            end)
        end

        local function onNewIndex(_, key, value)
            rawset(stored, key, value)
            if folder and not saveScheduled then
                saveScheduled = true
                task.delay(0.5, scheduleSave)
            end
        end

        return setmetatable({}, {
            __newindex = onNewIndex,
            __index = stored
        })
    end)()

    -- ScriptFlags.json proxy (legacy-compatible; __call deletes the file)
    local flags = (function()
        local folder = windowConfig.ScriptFolder
        local saveScheduled = false

        local ok, stored = pcall(function()
            return folder and HttpService:JSONDecode(readFileFn((tostring(folder) .. "/ScriptFlags.json")))
        end)

        if type(stored) ~= "table" then
            stored = {}
        end

        local function scheduleSave()
            saveScheduled = false
            return pcall(function()
                SafeWriteFile((tostring(folder) .. "/ScriptFlags.json"), HttpService:JSONEncode(stored))
            end)
        end

        local function onNewIndex(_, key, value)
            rawset(stored, key, value)
            if folder and not saveScheduled then
                saveScheduled = true
                task.delay(0.5, scheduleSave)
            end
        end

        local function deleteAll()
            table.clear(stored)
            return pcall(function()
                return folder and deleteFileFn((tostring(folder) .. "/ScriptFlags.json"))
            end)
        end

        return setmetatable({}, {
            __newindex = onNewIndex,
            __call = deleteAll,
            __index = stored
        })
    end)()

    self.ThemesObjects = GlobalThemeScope
    self.WindowSettings = windowSettings
    self.Flags = flags
    WindowFlags = flags

    -- icon table: built-in fallback first; cache/remote loaded afterwards
    self.Icons = {
        info = 10723415903,
        home = 10723407389,
        waves = 10747376931,
        fish = 127664059821666,
        palmtree = 10734910680,
        swords = 10734975692,
        cherry = 10709790875,
        gem = 10723396000,
        signal = 10734961133,
        locate = 10723434557,
        scroll = 10734943448,
        user = 10747373176,
        shoppingcart = 10734952479,
        settings = 10734950309,
        laptop = 10723423881,
        filecheck = 10723356210
    }

    local function mergeIcons(newIcons)
        for name, id in pairs(newIcons) do
            self.Icons[name] = id
        end
    end

    local function refreshTabIcons()
        for entry in pairs(TabIconRegistry) do
            if entry.Image.Parent and entry.IconName then
                local resolved = self:GetIconByName(entry.IconName)
                if resolved then
                    entry.Image.Image = resolved
                end
            end
        end
    end

    -- cached icons are cheap to read; the network fetch runs async so the
    -- window is never blocked by game:HttpGet (legacy startup bottleneck).
    task.spawn(function()
        local folder = windowConfig.ScriptFolder

        if folder then
            local okCache, cached = pcall(function()
                return loadstring(readFileFn((tostring(folder) .. "/Icons.lua")))()
            end)
            if okCache and type(cached) == "table" then
                mergeIcons(cached)
                refreshTabIcons()
            end
        end

        local repo = ("https://raw.githubusercontent.com/" .. tostring(self.Information.GitHubOwner))
        local url = (tostring(repo) .. "/Library/refs/heads/main/redz-V5-remake/Utils/Icons.lua")
        local source

        local okFetch, fetched = pcall(function()
            source = game:HttpGet(url)
            return loadstring(source)()
        end)

        if okFetch and type(fetched) == "table" then
            mergeIcons(fetched)
            refreshTabIcons()
            if folder and type(source) == "string" then
                pcall(function()
                    SafeWriteFile((tostring(folder) .. "/Icons.lua"), source)
                end)
            end
        end
    end)

    -- interface settings (theme/accent/animations/density...)
    self.InterfaceConfig = ReadInterfaceConfig()

    -- theme resolution: saved theme wins; fall back to the default one
    local savedTheme = type(windowSettings.SelectedTheme) == "string" and windowSettings.SelectedTheme or nil
    if not (savedTheme and self:IsValidTheme(savedTheme)) then
        savedTheme = self.Default.Theme
    end
    if self.InterfaceConfig.Theme and self.Themes[self.InterfaceConfig.Theme] then
        savedTheme = self.InterfaceConfig.Theme
    end

    self.LOADED_UI_LIBRARY = true
    self:SetTheme(savedTheme)

    -- window size (persisted, clamped like the legacy library)
    local windowSize = self.Default.UISize
    if windowSettings and type(windowSettings.UISize) == "table" then
        local width, height = unpack(windowSettings.UISize)
        if type(width) == "number" and type(height) == "number" then
            width = math.clamp(width, 430, 1000)
            height = math.clamp(height, 200, 500)
            windowSize = UDim2.fromOffset(width, height)
