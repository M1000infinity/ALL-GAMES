-- THEME MANAGER — paletas, troca em tempo real e velocidade de animação
--
--   local theme = Theme.new("Purple")
--   theme:Get()                 -- tabela de cores atual (somente leitura)
--   theme:Set("Cyan")           -- troca a paleta inteira
--   theme:SetAccent(Color3)     -- troca só o destaque
--   theme:SetTransparency(0.1)  -- 0 = sólido, 1 = transparente
--   theme:SetAnimSpeed(1.5)     -- 0 desliga animações
