-- SECTION — cartão com título e pilha automática de componentes
--
--   local sec = Tab:CreateSection({Name = "Combate", Description = "..."})
--   sec:CreateToggle({...})            -- todos os Create* disponíveis
--   sec:Destroy()                      -- some com a seção e seus componentes
--
-- Altura é calculada pelo UIListLayout + AutomaticSize: nada de números
-- mágicos por componente.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Section"] = function(Env)
	local U = Env.Util

	local Section = {}
	Section.__index = Section

	function Section.new(tab, config)
		config = config or {}
		local palette = Env.Theme:Get()

		local self = setmetatable({
			Name = config.Name or "",
			Description = config.Description,
			Tab = tab,
			Window = tab.Window,
			_Title = config.Name or "",
			_Items = {},
			_Order = 0,
			Maid = Env.Maid.new(),
			Destroyed = false,
		}, Section)

		local card = U.New("Frame", {
			Name = "Section_" .. tostring(self.Name ~= "" and self.Name or "semTitulo"),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = palette.Card,
			BorderSizePixel = 0,
			ClipsDescendants = false,
			Parent = tab:_ColumnFor(config.Column),
		})
		U.Corner(card, 10)
		local stroke = U.Stroke(card, palette.Border, 1, 0.35)
		local padding = U.Padding(card, 12, 12, 12, 12)
		-- empilha cabeçalho/espaçador/conteúdo; sem isto tudo cai em (0,0)
		U.List(card, {Padding = 0})
		self.Frame = card
		self.Stroke = stroke

		-- seção implícita (atalhos tab:CreateX) vira lista "nua": sem cartão,
		-- sem borda e sem padding — os componentes caem direto na coluna.
		local bare = (self.Name == "" and (self.Description == nil or self.Description == ""))
		if bare then
			card.BackgroundTransparency = 1
			stroke.Transparency = 1
			padding.PaddingTop = UDim.new(0, 0)
			padding.PaddingBottom = UDim.new(0, 0)
			padding.PaddingLeft = UDim.new(0, 0)
			padding.PaddingRight = UDim.new(0, 0)
		end
		self.Bare = bare

		local header = nil
		if self.Name ~= "" or (self.Description and self.Description ~= "") then
			header = U.New("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = card,
			})
			U.List(header, {Padding = 2})

			header.LayoutOrder = 1
			if self.Name ~= "" then
				local title = U.Label(header, self.Name, {
					Font = Enum.Font.GothamBold, Size = 13, Color = palette.Text,
				})
				title.Size = UDim2.new(1, 0, 0, 18)
				self.TitleLabel = title
			end
			if self.Description and self.Description ~= "" then
				local desc = U.Label(header, self.Description, {
					Font = Enum.Font.Gotham, Size = 10, Color = palette.Muted, Wrap = true,
					Truncate = Enum.TextTruncate.None,
				})
				desc.Size = UDim2.new(1, 0, 0, 0)
				desc.AutomaticSize = Enum.AutomaticSize.Y
				self.DescLabel = desc
			end
		end

		local content = U.New("Frame", {
			Name = "Content",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = card,
		})
		U.List(content, {Padding = 4})
		self.Content = content

		content.LayoutOrder = 3
		if header then
			U.New("Frame", {
				Size = UDim2.new(1, 0, 0, 6),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = 2,
				Parent = card,
			})
		end

		self.Maid:Add(Env.Theme:OnChanged(function(nextPalette)
			card.BackgroundColor3 = nextPalette.Card
			card.BackgroundTransparency = U.Alpha(nextPalette, self.Bare and 1 or 0)
			stroke.Color = nextPalette.Border
			if self.TitleLabel then self.TitleLabel.TextColor3 = nextPalette.Text end
			if self.DescLabel then self.DescLabel.TextColor3 = nextPalette.Muted end
		end))

		return self
	end

	-- ── registro interno ───────────────────────────────────────────────
	function Section:_register(component)
		self._Order = self._Order + 1
		component.Row.LayoutOrder = self._Order
		component.Section = self
		component.Window = self.Window
		table.insert(self._Items, component)
		component.RegistryId = self.Window.Registry:Add(component, {
			name = component.Name,
			description = component.Description,
			kind = component.Type,
			tab = self.Tab,
			section = self,
		})
		return component
	end

	function Section:_unregister(component)
		for index = #self._Items, 1, -1 do
			if self._Items[index] == component then
				table.remove(self._Items, index)
				break
			end
		end
		if component.RegistryId then
			self.Window.Registry:Remove(component.RegistryId)
			component.RegistryId = nil
		end
	end

	-- ── componentes ────────────────────────────────────────────────────
	function Section:CreateButton(config)
		if self.Destroyed then return nil end
		return Env.Components.Button.new(self, config)
	end

	function Section:CreateToggle(config)
		if self.Destroyed then return nil end
		return Env.Components.Toggle.new(self, config)
	end

	function Section:CreateSlider(config)
		if self.Destroyed then return nil end
		return Env.Components.Slider.new(self, config)
	end

	function Section:CreateDropdown(config)
		if self.Destroyed then return nil end
		return Env.Components.Dropdown.new(self, config)
	end

	function Section:CreateInput(config)
		if self.Destroyed then return nil end
		return Env.Components.Input.new(self, config)
	end

	function Section:CreateLabel(config)
		if self.Destroyed then return nil end
		return Env.Components.Label.new(self, config)
	end

	function Section:CreateParagraph(config)
		if self.Destroyed then return nil end
		return Env.Components.Paragraph.new(self, config)
	end

	function Section:CreateKeybind(config)
		if self.Destroyed then return nil end
		return Env.Components.Keybind.new(self, config)
	end

	function Section:CreateColorPicker(config)
		if self.Destroyed then return nil end
		return Env.Components.ColorPicker.new(self, config)
	end

	function Section:CreateDivider()
		if self.Destroyed then return nil end
		return Env.Components.Divider.new(self, {})
	end

	-- ── estado ─────────────────────────────────────────────────────────
	function Section:SetName(name)
		self.Name = tostring(name or "")
		self._Title = self.Name
		if self.TitleLabel then self.TitleLabel.Text = self.Name end
		return self
	end

	function Section:GetName()
		return self.Name
	end

	function Section:GetComponents()
		local copy = {}
		for index, component in ipairs(self._Items) do copy[index] = component end
		return copy
	end

	function Section:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true

		local items = {}
		for index, item in ipairs(self._Items) do items[index] = item end
		for _, item in ipairs(items) do
			pcall(function() item:Destroy() end)
		end
		self._Items = {}

		if self.Tab then self.Tab:_ForgetSection(self) end
		self.Maid:Clean()
		if self.Frame then self.Frame:Destroy() end
		self.Frame = nil
	end

	return Section
end

-- ── módulo: Tab (src/Tab.lua) ────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════
-- TAB — página com rolagem própria e seções
--
--   local tab = Window:CreateTab({Name = "Principal", Icon = "home"})
--   local sec = tab:CreateSection({Name = "Geral"})
--   tab:CreateToggle({...})   -- atalho: usa uma seção implícita "sem cartão"
--
-- Cada aba tem seu próprio contêiner; trocar de aba só alterna Visible —
-- nada é recriado.
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Tab"] = function(Env)
	local U = Env.Util
	local Section = Env.Section

	local Tab = {}
	Tab.__index = Tab

	function Tab.new(window, config)
		config = config or {}
		local palette = Env.Theme:Get()

		local self = setmetatable({
			Name = config.Name or "Aba",
			Icon = config.Icon,
			Window = window,
			Columns = tonumber(config.Columns) or 1,
			Sections = {},
			Selected = false,
			Destroyed = false,
			Maid = Env.Maid.new(),
			_DefaultSection = nil,
		}, Tab)

		-- contêiner da aba dentro da área de conteúdo
		local page = U.New("Frame", {
			Name = "Tab_" .. tostring(self.Name),
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			Parent = window.Content,
		})
		self.Page = page

		local scroller = U.New("ScrollingFrame", {
			Name = "Scroll",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = palette.AccentSoft,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = page,
		})
		U.Padding(scroller, 2, 6, 12, 2)
		self.Scroller = scroller

		local holder = U.New("Frame", {
			Name = "Holder",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = scroller,
		})
		U.List(holder, {Padding = 10, Horizontal = self.Columns > 1})
		self.Holder = holder

		self._Columns = {}
		local columnCount = self.Columns > 1 and 2 or 1
		for index = 1, columnCount do
			local width = columnCount == 1 and UDim2.new(1, 0, 0, 0) or UDim2.new(0.5, -5, 0, 0)
			local column = U.New("Frame", {
				Name = "Column" .. tostring(index),
				Size = width,
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Parent = holder,
			})
			U.List(column, {Padding = 10})
			self._Columns[index] = column
		end

		self.Maid:Add(Env.Theme:OnChanged(function(nextPalette)
			scroller.ScrollBarImageColor3 = nextPalette.AccentSoft
		end))

		return self
	end

	function Tab:_ColumnFor(index)
		if self.Columns <= 1 then return self._Columns[1] end
		return self._Columns[tonumber(index) == 2 and 2 or 1]
	end

	function Tab:CreateSection(config)
		if self.Destroyed then return nil end
		local section = Section.new(self, config)
		table.insert(self.Sections, section)
		return section
	end

	function Tab:_ForgetSection(section)
		for index = #self.Sections, 1, -1 do
			if self.Sections[index] == section then
				table.remove(self.Sections, index)
				break
			end
		end
	end

	-- seção implícita para os atalhos tab:CreateToggle(...)
	function Tab:_EnsureDefaultSection()
		if self.Destroyed then return nil end
		if not self._DefaultSection or self._DefaultSection.Destroyed then
			self._DefaultSection = Section.new(self, {Name = "", Column = 1})
			table.insert(self.Sections, self._DefaultSection)
		end
		return self._DefaultSection
	end

	function Tab:GetDefaultSection()
		return self:_EnsureDefaultSection()
	end

	function Tab:CreateButton(config)
		local section = self:_EnsureDefaultSection()
		if not section then return nil end
		return section:CreateButton(config)
	end
	function Tab:CreateToggle(config)
		local section = self:_EnsureDefaultSection()
		if not section then return nil end
		return section:CreateToggle(config)
