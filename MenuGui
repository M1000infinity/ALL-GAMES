-- SUPPORT — peças comuns a todos os componentes
-- (linha, título, descrição, hover, vínculo com o tema)
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Support"] = function(Env)
	local U = Env.Util
	local Support = {}

	function Support.Row(parent, height, opts)
		opts = opts or {}
		local palette = Env.Theme:Get()
		local row = U.New("Frame", {
			Size = UDim2.new(1, 0, 0, height or 44),
			BackgroundColor3 = palette.Card,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = false,
			Parent = parent,
		})
		U.Corner(row, 8)
		if opts.Hover ~= false then
			row.MouseEnter:Connect(function()
				U.Tween(row, 0.12, {BackgroundTransparency = 0.55})
			end)
			row.MouseLeave:Connect(function()
				U.Tween(row, 0.12, {BackgroundTransparency = 1})
			end)
		end
		return row
	end

	-- Título + descrição dentro da linha. Devolve os dois labels.
	function Support.Title(row, name, description, rightPad, topPad)
		local palette = Env.Theme:Get()
		local pad = rightPad or 60
		local top = topPad or 8
		local title = U.Label(row, name or "", {
			Font = Enum.Font.GothamMedium,
			Size = 12,
			Color = palette.Text,
		})
		title.Size = UDim2.new(1, -pad, 0, 16)
		title.Position = UDim2.fromOffset(10, top)

		local desc = nil
		if description and description ~= "" then
			desc = U.Label(row, description, {
				Font = Enum.Font.Gotham,
				Size = 10,
				Color = palette.Muted,
			})
			desc.Size = UDim2.new(1, -pad, 0, 14)
			desc.Position = UDim2.fromOffset(10, top + 16)
		end

		local function paint(themePalette)
			title.TextColor3 = themePalette.Text
			if desc then desc.TextColor3 = themePalette.Muted end
		end
		return title, desc, paint
	end

	function Support.RowPaint(row, palette, hovered)
		row.BackgroundColor3 = hovered and palette.CardHover or palette.Card
	end

	-- Liga o componente ao tema: chama painter(palette) agora e a cada troca.
	function Support.BindTheme(comp, painter)
		comp.Maid:Add(Env.Theme:OnChanged(function(palette)
			pcall(painter, palette)
			if comp.RefreshDim then pcall(comp.RefreshDim, comp) end
		end))
		local ok, err = pcall(painter, Env.Theme:Get())
		if not ok then
			warn("[Expander] falha ao pintar " .. tostring(comp.Type) .. ": " .. tostring(err))
		end
	end

	function Support.MakeComponent(meta)
		local comp = {
			Type = meta.kind or "Component",
			Name = meta.name or "",
			Description = meta.description or "",
			Row = meta.row,
			Maid = Env.Maid.new(),
			Visible = true,
			Enabled = meta.enabled ~= false,
			Destroyed = false,
			_Dim = {},
			_DimBase = {},
		}

		-- Registra um objeto que escurece junto com o componente. Guardamos a
		-- transparência original para poder restaurar exatamente como era.
		function comp:AddDim(object)
			if not object or self._DimBase[object] then return end
			local base = {background = object.BackgroundTransparency, text = nil}
			if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
				base.text = object.TextTransparency
			end
			self._DimBase[object] = base
			table.insert(self._Dim, object)
		end

		-- Reaplica o "escurecido" DEPOIS do Paint, senão a pintura do tema
		-- sobrescreve a transparência e o componente desativado parece ativo.
		function comp:RefreshDim()
			if self.Destroyed then return end
			for _, object in ipairs(self._Dim) do
				local base = self._DimBase[object]
				if base then
					if self.Enabled then
						object.BackgroundTransparency = base.background
						if base.text ~= nil then object.TextTransparency = base.text end
					else
						base.background = object.BackgroundTransparency
						object.BackgroundTransparency = math.min(1, base.background + 0.4)
						if base.text ~= nil then
							base.text = object.TextTransparency
							object.TextTransparency = math.min(1, base.text + 0.35)
						end
					end
				end
			end
		end

		function comp:SetEnabled(value)
			value = value ~= false
			if self.Enabled == value then return value end
			self.Enabled = value
			if self.ApplyEnabled then pcall(self.ApplyEnabled, self, value) end
			if self.Paint then pcall(self.Paint, self, Env.Theme:Get()) end
			self:RefreshDim()
			return value
		end

		function comp:IsEnabled()
			return self.Enabled == true
		end

		return comp
	end

	-- Botão transparente que cobre a linha (área de clique). Recebe o comp
	-- para registrar a conexão no Maid.
	function Support.ClickArea(comp, row)
		local area = U.New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = row.ZIndex + 1,
			Parent = row,
		})
		comp.Maid:Add(area.MouseButton1Click:Connect(function()
			if comp.Enabled == false or comp.Destroyed then return end
			if comp.OnClick then comp:OnClick() end
		end))
		return area
	end

	return Support
end

