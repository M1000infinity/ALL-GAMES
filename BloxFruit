---------------------------------- Toggle -----------------------------------

function TabClass:AddToggle(config)
    local title, desc = ValidateOptionConfig("Toggle", config)
    local flag = ValidateFlag("Toggle", config[4] or config.Flag)

    local default = config[2] or config.Default or false
    local callbacks = PackCallback(config[3] or config.Callback)

    if type(default) ~= "boolean" then
        error(("\"Tab.AddToggle.Default\". 'boolean' expected, got " .. tostring(typeof(default))), 2)
    end

    -- legacy flag encoding: number flags -> 0 = ON, 1 = OFF (do not change!)
    if flag ~= nil and type(WindowFlags[flag]) == "number" then
        default = WindowFlags[flag] == 0
    end

    local row, titleLabel, descLabel = MakeOptionRow(self, title, desc, UDim2.new(1, -56, 0, 0))

    local trackTag = {
        OBJECTS = TabScopes[self],
        BackgroundColor3 = "Colors.Stroke"
    }
    local track = NewInstance("Frame", row, {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -12, 0.5),
        AnchorPoint = Vector2.new(1, 0.5),
        Elements = {
            Corner = UDim.new(0.5, 0)
        },
        ThemeTag = trackTag
    })

    local knobHolder = NewInstance("Frame", track, {
        BackgroundTransparency = 1,
        Size = UDim2.new(0.8, 0, 0.8, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5)
    })

    local knobTag = {
        OBJECTS = TabScopes[self],
        BackgroundColor3 = "Colors.Text.Darker"
    }
    local knob = NewInstance("Frame", knobHolder, {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 0, 0.5),
        AnchorPoint = Vector2.new(0, 0.5),
        Elements = {
            Corner = UDim.new(0.5, 0)
        },
        ThemeTag = knobTag
    })

    local CLICK_COOLDOWN = 0.2
    local lastAnimated = tick()
    local activeTweens = {}

    local function playTweens(tweens)
        activeTweens = {}
        for index = 1, #tweens do
            tweens[index]:Play()
            activeTweens[index] = tweens[index]
        end
    end

    local function cancelActive()
        for index = #activeTweens, 1, -1 do
            local tween = activeTweens[index]
            if tween.PlaybackState == Enum.PlaybackState.Playing then
                tween:Cancel()
            end
            activeTweens[index] = nil
        end
    end

    local function applyValue(value)
        if flag ~= nil then
            WindowFlags[flag] = value and 0 or 1 -- legacy inverted encoding
        end
        FireCallbacks(callbacks, value)

        local knobPosition = UDim2.new(value and 1 or 0, 0, 0.5, 0)
        local knobAnchor   = Vector2.new(value and 1 or 0, 0.5)
        local knobColorKey = value and "Colors.OnAccent" or "Colors.Text.Darker"
        local trackColorKey = value and "Colors.Primary" or "Colors.Stroke"
        local knobColor  = ThemePath(Library.CurrentTheme, knobColorKey)
        local trackColor = ThemePath(Library.CurrentTheme, trackColorKey)

        knobTag.BackgroundColor3 = knobColorKey
        trackTag.BackgroundColor3 = trackColorKey

        if self.Selected and (tick() - lastAnimated) >= CLICK_COOLDOWN and Motion.Enabled then
            playTweens({
                Tween(knob, "Position", knobPosition, 0.20),
                Tween(knob, "AnchorPoint", knobAnchor, 0.20),
                Tween(knob, "BackgroundColor3", knobColor, 0.20),
                Tween(track, "BackgroundColor3", trackColor, 0.20)
            })
        else
            cancelActive()
            knob.Position = knobPosition
            knob.AnchorPoint = knobAnchor
            knob.BackgroundColor3 = knobColor
            track.BackgroundColor3 = trackColor
        end

        lastAnimated = tick()
    end

    local toggle = ToggleClass.new(self, row, titleLabel, descLabel, applyValue, callbacks)
    toggle:SetValue(default)

    local clickTick = 0
    Connect(row.Activated, function()
        if (tick() - clickTick) >= CLICK_COOLDOWN then
            clickTick = tick()
            toggle:SetValue(not toggle.Value)
        end
    end)

    if not self.IsInterfaceTab then
        RegisterOption(self, "Toggle", title, desc, row)
    end
    return toggle
end

---------------------------------- Button -----------------------------------

function TabClass:AddButton(config)
    local title, desc = ValidateOptionConfig("Button", config)
    local callbacks = PackCallback(config[2] or config.Callback)
    local cooldown = config.Debounce or config.Cooldown

    local row, titleLabel, descLabel = MakeOptionRow(self, title, desc, UDim2.new(1, -24, 0, 0))

    local icon = NewInstance("ImageLabel", row, {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(1, -12, 0.5),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        ThemeTag = {
            OBJECTS = TabScopes[self],
            Image = "Icons.Button",
            ImageColor3 = "Colors.Icons"
        }
    })

    local pressScale = NewInstance("UIScale", row, { Scale = 1 })
    local lastClick = 0

    Connect(row.MouseEnter, function()
        Tween(icon, "Rotation", 10, 0.12):Play()
    end)
    Connect(row.MouseLeave, function()
        Tween(icon, "Rotation", 0, 0.16):Play()
    end)
    Connect(row.MouseButton1Down, function()
        Tween(pressScale, "Scale", 0.985, 0.07):Play()
    end)
    Connect(row.MouseButton1Up, function()
        Tween(pressScale, "Scale", 1, 0.12):Play()
    end)

    Connect(row.Activated, function()
        if cooldown ~= nil and (tick() - lastClick) < 0 then return end
        if cooldown ~= nil then
            lastClick = tick() + cooldown
        end
        FireCallbacks(callbacks)
    end)

    local button = setmetatable({
        CALLBACKS = callbacks,
        DESTROY_ELEMENT = row,
        VISIBLE_ELEMENT = row,
        TITLE_LABEL = titleLabel,
        DESCRIPTION_LABEL = descLabel,
        Title = title,
        Description = desc,
        Parent = self,
        Kind = "Button"
    }, OptionBase)

    if not self.IsInterfaceTab then
        RegisterOption(self, "Button", title, desc, row)
    end
    return button
end

---------------------------------- TextBox ----------------------------------

function TabClass:AddTextBox(config)
    -- positional form: { Name, Default, ClearOnFocus(bool), Callback, Flag }
    if type(config) == "table" and type(config[3]) == "boolean" then
        config = {
            Name = config[1],
            Description = config[2],
            ClearOnFocus = config[3],
            Callback = config[4],
            Flag = config[5],
            PlaceholderText = config.PlaceholderText or config.Placeholder
        }
    end
    local title, desc = ValidateOptionConfig("TextBox", config)
    local flag = ValidateFlag("TextBox", config[4] or config.Flag)

    local default = config[2] or config.Default
    local callbacks = PackCallback(config[3] or config.Callback)

    local placeholder = config.Placeholder or config.PlaceholderText
    local clearOnFocus = config.ClearOnFocus or config.ClearTextOnFocus

    if default ~= nil and type(default) ~= "string" then
        error(("\"Tab.AddTextBox.Default\". 'string', or 'nil' expected, got " .. tostring(typeof(default))), 2)
    end

    if flag and type(WindowFlags[flag]) == "string" then
        default = WindowFlags[flag]
    end

    local row, titleLabel, descLabel = MakeOptionRow(self, title, desc, UDim2.new(1, -182, 0, 0))

    local boxFrameTag = {
        OBJECTS = TabScopes[self],
        BackgroundColor3 = "Colors.Stroke"
    }
    local boxFrame = NewInstance("Frame", row, {
        Size = UDim2.new(0, 168, 0, 28),
        Position = UDim2.new(1, -12, 0.5),
        AnchorPoint = Vector2.new(1, 0.5),
        ThemeTag = boxFrameTag,
        Elements = {
            Corner = UDim.new(0, 6),
            Stroke = { Thickness = 1, ThemeTag = { OBJECTS = TabScopes[self], Color = "Colors.Border.Default" } }
        }
    })

    local textbox = NewInstance("TextBox", boxFrame, {
        Size = UDim2.new(0.85, 0, 0.85, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1,
        TextScaled = true,
        Active = true,
        Text = "",
        PlaceholderText = LibraryConstants.TEXTBOX.PLACEHOLDER_TEXT,
        PlaceholderColor3 = Color3.fromRGB(140, 150, 166),
        ThemeTag = {
            OBJECTS = TabScopes[self],
            TextColor3 = "Colors.Text.Default",
            Font = "Font.Medium"
        }
    })

    -- inner padding via UITextSizeConstraint-free padding frame substitute:
    NewInstance("UIPadding", textbox, {
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 2)
    })

    local iconTag = {
        OBJECTS = TabScopes[self],
        Image = "Icons.TextBox",
        ImageColor3 = "Colors.Icons"
    }
    local icon = NewInstance("ImageLabel", boxFrame, {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, -6, 0.5),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        ThemeTag = iconTag
    })

    if default ~= nil then
        textbox.Text = default
    end
    if clearOnFocus ~= nil then
        textbox.ClearTextOnFocus = clearOnFocus
    end
    if placeholder ~= nil then
        textbox.PlaceholderText = placeholder
    end

    local component = TextBoxClass.new(self, titleLabel, descLabel, row, textbox, callbacks)

    local function setIconColor(themeKey)
        iconTag.ImageColor3 = themeKey
        Tween(icon, "ImageColor3", ThemePath(Library.CurrentTheme, themeKey), 0.22):Play()
    end

    if flag ~= nil then
        Connect(textbox:GetPropertyChangedSignal("Text"), function()
            WindowFlags[flag] = textbox.Text
        end)
    end

    Connect(textbox.Focused, function()
        setIconColor("Colors.Primary")
        Tween(boxFrame, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.OnPrimary"), 0.18):Play()
        boxFrameTag.BackgroundColor3 = "Colors.OnPrimary"
        Tween(boxFrame.UIStroke, "Color", ThemePath(Library.CurrentTheme, "Colors.Primary"), 0.18):Play()
    end)

    Connect(textbox.FocusLost, function()
        setIconColor("Colors.Icons")
        Tween(boxFrame, "BackgroundColor3", ThemePath(Library.CurrentTheme, "Colors.Stroke"), 0.18):Play()
        boxFrameTag.BackgroundColor3 = "Colors.Stroke"
        Tween(boxFrame.UIStroke, "Color", ThemePath(Library.CurrentTheme, "Colors.Border.Default"), 0.18):Play()

        local filter = component.TEXTBOX_TEXT_FILTER or component.OnChanging
        if filter then
            local filtered = filter(textbox.Text)
            if type(filtered) == "string" then
                textbox.Text = filtered
            end
        end

        FireCallbacks(callbacks, textbox.Text)
    end)

    Connect(row.Activated, function()
        textbox:CaptureFocus()
    end)

    if not self.IsInterfaceTab then
        RegisterOption(self, "TextBox", title, desc, row)
    end
    return component
end

