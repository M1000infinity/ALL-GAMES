		})
		self.DragArea = dragArea

		local drag = {active = false, startX = 0, startY = 0, startPos = nil}
		self.Maid:Add(dragArea.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				drag.active = true
				drag.startX = input.Position.X
				drag.startY = input.Position.Y
				drag.startPos = root.Position
			end
		end))
		if U.UserInput then
			self.Maid:Add(U.UserInput.InputChanged:Connect(function(input)
				if not drag.active or not drag.startPos then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					root.Position = UDim2.new(
						drag.startPos.X.Scale, drag.startPos.X.Offset + (input.Position.X - drag.startX),
						drag.startPos.Y.Scale, drag.startPos.Y.Offset + (input.Position.Y - drag.startY)
					)
				end
			end))
			self.Maid:Add(U.UserInput.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					drag.active = false
				end
			end))
		end

		-- ── ações fixas ───────────────────────────────────────────────
		self.Maid:Add(closeButton.MouseButton1Click:Connect(function() self:Destroy() end))
		self.Maid:Add(minimizeButton.MouseButton1Click:Connect(function() self:Minimize(not self.Minimized) end))
		self.Maid:Add(themeButton.MouseButton1Click:Connect(function() self:CycleTheme() end))

		self.Maid:Add(searchInput:GetPropertyChangedSignal("Text"):Connect(function()
			self:_UpdateSearch(searchInput.Text)
		end))
		self.Maid:Add(searchInput.Focused:Connect(function()
			searchStroke.Color = Env.Theme:Get().Accent
		end))
		self.Maid:Add(searchInput.FocusLost:Connect(function()
			searchStroke.Color = Env.Theme:Get().Border
		end))

		-- tema: repinta o "chrome" da janela
		self.Maid:Add(Env.Theme:OnChanged(function(nextPalette)
			root.BackgroundColor3 = nextPalette.Bg
			root.BackgroundTransparency = U.Alpha(nextPalette, 0)
			rootStroke.Color = nextPalette.AccentSoft
			divider.BackgroundColor3 = nextPalette.Border
			title.TextColor3 = nextPalette.Text
			subtitle.TextColor3 = nextPalette.Muted
			searchBox.BackgroundColor3 = nextPalette.Card
			searchStroke.Color = nextPalette.Border
			searchInput.TextColor3 = nextPalette.Text
			searchInput.PlaceholderColor3 = nextPalette.Muted
			sidebar.ScrollBarImageColor3 = nextPalette.Border
			for _, bar in ipairs(self._MarkBars) do bar.BackgroundColor3 = nextPalette.AccentGlow end
			self:_PaintNav(nextPalette)
		end))

		self:_LayoutChrome()
		self:_ApplyScale()
		self:_PaintNav(Env.Theme:Get())

		self.Maid:Add((function()
			local camera = workspace.CurrentCamera
			if not camera then return {Disconnect = function() end} end
			return camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() self:_ApplyScale() end)
		end)())

		return self
	end

	-- ── escala responsiva ─────────────────────────────────────────────
	function Window:ViewportSize()
		local camera = workspace.CurrentCamera
		if camera then return camera.ViewportSize end
		return Vector2.new(1280, 720)
	end

	function Window:_ApplyScale()
		local viewport = self:ViewportSize()
		local fit = math.min(
			(viewport.X - 24) / self.Width,
			(viewport.Y - 24) / (self.Minimized and HEADER or self.Height)
		)
		self.Scale.Scale = U.Clamp(fit, 0.4, 1)
	end

	-- reposiciona o "chrome" do cabeçalho e as colunas quando o tamanho muda
	function Window:_LayoutChrome()
		local width, height = self.Width, self.Height
		if self.Root then self.Root.Size = UDim2.fromOffset(width, height) end
		if self.CloseButton then self.CloseButton.Position = UDim2.fromOffset(width - 48, 17) end
		if self.MinimizeButton then self.MinimizeButton.Position = UDim2.fromOffset(width - 86, 17) end
		if self.ThemeButton then self.ThemeButton.Position = UDim2.fromOffset(width - 124, 17) end
		if self.SearchBox then self.SearchBox.Position = UDim2.fromOffset(width - 358, 17) end
		if self.Sidebar then self.Sidebar.Size = UDim2.fromOffset(SIDEBAR, height - HEADER - PAD) end
		if self.Content then
			self.Content.Size = UDim2.new(1, -((PAD + SIDEBAR + 12) + PAD), 1, -(HEADER + PAD + 2))
		end
	end

	function Window:GetScale()
		local value = (self.Scale and self.Scale.Scale) or 1
		if type(value) ~= "number" or value <= 0 then return 1 end
		return value
	end

	-- converte uma posição absoluta (tela) para o espaço interno do Overlay,
	-- que vive dentro do Root escalado — por isso a divisão pela escala.
	function Window:ToOverlaySpace(absPosition)
		local origin = self.Overlay.AbsolutePosition
		local scaleValue = self:GetScale()
		return Vector2.new(
			((absPosition.X or 0) - origin.X) / scaleValue,
			((absPosition.Y or 0) - origin.Y) / scaleValue
		)
	end

	function Window:OverlayHeight()
		return self.Overlay.AbsoluteSize.Y / self:GetScale()
	end

	-- ── navegação ─────────────────────────────────────────────────────
	function Window:_CreateNavButton(tab)
		local palette = Env.Theme:Get()
		local button = U.New("TextButton", {
			Name = "Nav_" .. tostring(tab.Name),
			Size = UDim2.fromOffset(SIDEBAR, 42),
			BackgroundColor3 = palette.Card,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = self.Sidebar,
		})
		U.Corner(button, 8)

		local gradient = U.New("UIGradient", {
			Color = ColorSequence.new(palette.Accent, palette.AccentDeep),
			Enabled = false,
			Parent = button,
		})

		local glyph = Env.Icons(tab.Icon or "dot", palette.Muted, 16)
		glyph.Position = UDim2.fromOffset(13, 13)
		glyph.Parent = button

		local label = U.Label(button, tab.Name, {
			Font = Enum.Font.GothamMedium, Size = 12, Color = palette.Dim,
		})
		label.Size = UDim2.new(1, -50, 1, 0)
		label.Position = UDim2.fromOffset(40, 0)

		local entry = {
			Tab = tab,
			Button = button,
			Label = label,
			Icon = glyph,
			Gradient = gradient,
			Active = false,
		}
		tab._Nav = entry

		self.Maid:Add(button.MouseButton1Click:Connect(function()
			self:SelectTab(tab)
		end))
		self.Maid:Add(button.MouseEnter:Connect(function()
			if not entry.Active then
				U.Tween(button, 0.1, {BackgroundTransparency = 0.55})
			end
		end))
		self.Maid:Add(button.MouseLeave:Connect(function()
			if not entry.Active then
				U.Tween(button, 0.1, {BackgroundTransparency = 1})
			end
		end))

		return entry
	end

	local function paintGlyph(holder, color)
		for _, part in ipairs(holder:GetChildren()) do
			if part:IsA("Frame") then
				if part.BackgroundTransparency == 1 then
					for _, child in ipairs(part:GetChildren()) do
						if child:IsA("UIStroke") then child.Color = color end
					end
				else
					part.BackgroundColor3 = color
				end
			end
		end
	end

	function Window:_PaintNav(palette)
		for _, tab in ipairs(self.Tabs) do
			local entry = tab._Nav
			if entry then
				local active = self.SelectedTab == tab
				entry.Active = active
				entry.Button.BackgroundColor3 = active and palette.AccentDeep or palette.Card
				entry.Button.BackgroundTransparency = active and 0 or 1
				entry.Gradient.Color = ColorSequence.new(palette.Accent, palette.AccentDeep)
				entry.Gradient.Enabled = active
				entry.Label.TextColor3 = active and palette.Text or palette.Dim
				entry.Label.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
				paintGlyph(entry.Icon, active and palette.Text or palette.Muted)
			end
		end
	end

	function Window:_RefreshNav()
		for _, tab in ipairs(self.Tabs) do
			local entry = tab._Nav
			if entry then
				entry.Label.Text = tab.Name
				entry.Button.Name = "Nav_" .. tostring(tab.Name)
			end
		end
	end

	function Window:CreateTab(config)
		config = config or {}
		if self.Destroyed then return nil end
		self._Order = self._Order + 1

		local tab = Tab.new(self, config)
		table.insert(self.Tabs, tab)
		self:_CreateNavButton(tab)
		self:_PaintNav(Env.Theme:Get())

		-- primeira aba já selecionada (sem exigir clique)
		if not self.SelectedTab then
			self:SelectTab(tab)
		end
		return tab
	end

	function Window:SelectTab(tab)
		if type(tab) == "string" then
			for _, candidate in ipairs(self.Tabs) do
				if candidate.Name == tab then tab = candidate break end
			end
		end
		if not tab or tab.Destroyed then return false end

		for _, candidate in ipairs(self.Tabs) do
			local selected = candidate == tab
			candidate.Page.Visible = selected
			candidate.Selected = selected
		end
		self.SelectedTab = tab
		self:_PaintNav(Env.Theme:Get())
		return true
	end

	function Window:GetTab(name)
		for _, tab in ipairs(self.Tabs) do
			if tab.Name == name then return tab end
		end
		return nil
	end

	function Window:GetTabs()
		local copy = {}
		for index, tab in ipairs(self.Tabs) do copy[index] = tab end
		return copy
	end

	function Window:_ForgetTab(tab)
		for index = #self.Tabs, 1, -1 do
			if self.Tabs[index] == tab then table.remove(self.Tabs, index) break end
		end
		if tab._Nav then
			tab._Nav.Button:Destroy()
			tab._Nav = nil
		end
		if self.SelectedTab == tab then
			self.SelectedTab = nil
			local nextTab = self.Tabs[1]
			if nextTab then self:SelectTab(nextTab) end
		end
		self:_PaintNav(Env.Theme:Get())
	end

	-- ── tema ──────────────────────────────────────────────────────────
	function Window:SetTheme(name)
		return Env.Theme:Set(name)
	end

	function Window:CycleTheme()
		local names = Env.Theme:Names()
		local current = Env.Theme:Name()
		local index = 1
		for i, name in ipairs(names) do
			if name == current then index = i break end
		end
		local nextName = names[(index % #names) + 1]
		Env.Theme:Set(nextName)
		self:Notify({Title = "Tema", Content = nextName, Duration = 1.6, Type = "info"})
	end

	function Window:SetAccent(color)
		return Env.Theme:SetAccent(color)
	end

	function Window:SetTransparency(value)
		Env.Theme:SetTransparency(value)
	end

	function Window:SetAnimSpeed(value)
		Env.Theme:SetAnimSpeed(value)
	end

	-- ── notificações ──────────────────────────────────────────────────
	function Window:Notify(config)
		return self.Notifier:Push(config)
	end

	-- ── minimizar ─────────────────────────────────────────────────────
	function Window:Minimize(value)
		value = value == true
		if self.Minimized == value then return end
		self.Minimized = value

		if value then
			U.Tween(self.Root, 0.18, {Size = UDim2.fromOffset(self.Width, HEADER)})
		else
			U.Tween(self.Root, 0.18, {Size = UDim2.fromOffset(self.Width, self.Height)})
		end
		self.Sidebar.Visible = not value
		self.Content.Visible = not value
		self:_ApplyScale()
	end

	function Window:IsMinimized()
		return self.Minimized
	end

	function Window:SetSize(size)
		if type(size) == "table" then
			local width = tonumber(size[1] or size.Width)
			local height = tonumber(size[2] or size.Height)
			if width and height then size = UDim2.fromOffset(width, height) end
		end
		local okW, widthValue = pcall(function() return size.X.Offset end)
		local okH, heightValue = pcall(function() return size.Y.Offset end)
		if not okW or not okH or type(widthValue) ~= "number" or type(heightValue) ~= "number" then
			return false
		end
		self.Size = size
		self.Width = math.max(size.X.Offset, 640)
		self.Height = math.max(size.Y.Offset, 220)
		self:_LayoutChrome()
		self:_ApplyScale()
		return true
	end

	function Window:OnClose(fn)
		self.OnCloseCallback = fn
		self._CloseCallbackSet = type(fn) == "function"
	end

	-- ── busca ─────────────────────────────────────────────────────────
	function Window:Search(query)
		return self.Registry:Search(query, 30)
	end

	function Window:_HideSearchResults()
		if self._SearchPanel then
			self._SearchPanel:Destroy()
			self._SearchPanel = nil
		end
	end

	function Window:_Flash(component)
		local row = component and component.Row
		if not row then return end
		local palette = Env.Theme:Get()
		U.Tween(row, 0.12, {BackgroundTransparency = 0, BackgroundColor3 = palette.AccentSoft})
		U.Delay(0.45, function()
			if row and row.Parent then
				U.Tween(row, 0.25, {BackgroundTransparency = 1})
			end
		end)
	end

	function Window:_UpdateSearch(text)
		self:_HideSearchResults()
		text = tostring(text or "")
		if text == "" then return end

		local results = self:Search(text)
		if #results == 0 then return end

		local palette = Env.Theme:Get()
		local panel = U.New("Frame", {
			Name = "SearchResults",
			Size = UDim2.fromOffset(260, math.min(#results, 6) * 34 + 8),
			Position = (function()
				local space = self:ToOverlaySpace(self.SearchBox.AbsolutePosition)
				return UDim2.fromOffset(space.X, space.Y + 36)
			end)(),
			BackgroundColor3 = palette.Panel,
			BackgroundTransparency = U.Alpha(palette, 0),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 900,
			Parent = self.Overlay,
		})
		U.Corner(panel, 8)
		U.Stroke(panel, palette.Border, 1, 0)
		self._SearchPanel = panel

		for index, entry in ipairs(results) do
			if index > 6 then break end
			local button = U.New("TextButton", {
				Size = UDim2.new(1, -8, 0, 30),
				Position = UDim2.fromOffset(4, 4 + (index - 1) * 34),
				BackgroundColor3 = palette.Card,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 901,
				Parent = panel,
			})
			U.Corner(button, 6)
			local label = U.Label(button, entry.name, {
				Font = Enum.Font.GothamMedium, Size = 10, Color = palette.Text,
			})
			label.Size = UDim2.new(1, -12, 0, 14)
			label.Position = UDim2.fromOffset(8, 3)
			local sub = U.Label(button, (entry.tab and entry.tab.Name or "?") .. " · " .. entry.kind, {
				Font = Enum.Font.Gotham, Size = 8, Color = palette.Muted,
			})
			sub.Size = UDim2.new(1, -12, 0, 12)
			sub.Position = UDim2.fromOffset(8, 16)

			button.MouseButton1Click:Connect(function()
				if entry.tab then self:SelectTab(entry.tab) end
				self:_Flash(entry.component)
				self.SearchInput.Text = ""
				self:_HideSearchResults()
			end)
		end
	end

	-- ── destruição ────────────────────────────────────────────────────
	function Window:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true

		if type(self.ExpanderUnregister) == "function" then
			pcall(self.ExpanderUnregister)
		end

		if self._CloseCallbackSet and type(self.OnCloseCallback) == "function" then
			U.SafeCall("Window.OnClose", self.OnCloseCallback)
		end

		self:_HideSearchResults()

		local tabs = {}
		for index, tab in ipairs(self.Tabs) do tabs[index] = tab end
		for _, tab in ipairs(tabs) do
			pcall(function() tab:Destroy() end)
		end
		self.Tabs = {}
		self.SelectedTab = nil

		if self.Notifier then
			pcall(function() self.Notifier:Destroy() end)
			self.Notifier = nil
		end

		self.Registry:Clear()
		self.Maid:Clean()
	end

	Window.Close = Window.Destroy

	return Window
end

