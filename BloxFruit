                PaddingRight  = UDim.new(0, 10)
            }
        }
    })

    local titleLabel = NewInstance("TextLabel", holder, {
        Size = UDim2.new(1, 0, 0, 20),
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Bottom,
        BackgroundTransparency = 1,
        TextSize = 13,
        ThemeTag = {
            TextColor3 = "Colors.Text.Default",
            Font = "Font.Bold"
        }
    })

    local contentLabel = NewInstance("TextLabel", holder, {
        Size = UDim2.new(1, 0, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        TextWrapped = true,
        TextSize = 11,
        ThemeTag = {
            TextColor3 = "Colors.Text.Dark",
            Font = "Font.Normal"
        }
    })

    local iconImage = NewInstance("ImageLabel", body, {
        Size = UDim2.fromOffset(22, 22),
        Position = UDim2.new(0, 10, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        ThemeTag = {
            ImageColor3 = "Colors.Primary"
        }
    })

    -- accent edge bar (identity detail)
    NewInstance("Frame", body, {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Elements = { Corner = UDim.new(0.5, 0) },
        ThemeTag = { BackgroundColor3 = "Colors.Primary" }
    })

    local countdownLabel = NewInstance("TextLabel", body, {
        Size = UDim2.new(0, 40, 0, 16),
        Position = UDim2.new(1, -12, 0, 8),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        TextSize = 10,
        ThemeTag = {
            TextColor3 = "Colors.Text.Darker",
            Font = "Font.Normal"
        }
    })

    local holding = false

    local pressIn  = Tween(popScale, "Scale", 1.05, 0.16)
    local pressOut = Tween(popScale, "Scale", 1.00, 0.14)

    local notification = setmetatable({
        TITLE_LABEL = titleLabel,
        DESCRIPTION_LABEL = contentLabel,
        VISIBLE_ELEMENT = card,
        DESTROY_ELEMENT = card,
        NOTIFICATION = body,
        Kind = "Notification",
        Closed = false,
        Parent = self
    }, OptionBase)

    function notification:Close()
        if self.Closed == true then return end
        self.Closed = true
        local slideOut = Tween(body, "Position", UDim2.fromScale(3, 0), 0.24)
        slideOut:Play()
        slideOut.Completed:Wait()
        card:Destroy()
        setmetatable(self, nil)
    end

    local function runCountdown()
        icon = Library:GetIconByName(icon or NotifyDefaultIcon) or ""
        iconImage.Image = icon

        if not IsAssetId(icon) then
            iconImage.Visible = false
            holder.UIPadding.PaddingLeft = UDim.new(0, 16)
        end

        body.Position = UDim2.fromScale(3, 0)
        Tween(body, "Position", UDim2.fromScale(0, 0), 0.24):Play()

        titleLabel.Text = title
        contentLabel.Text = content

        local mouseLeave = body.MouseLeave

        while duration > 0 do
            countdownLabel.Text = FormatCountdown(duration)
            if holding == true then
                mouseLeave:Wait()
            end
            duration = duration - (task.wait())
        end

        notification:Close()
    end

    Connect(body.MouseButton1Down, function() pressIn:Play()  holding = true  end)
    Connect(body.MouseLeave,       function() pressOut:Play() holding = false end)

    task.defer(runCountdown)

    return notification
end

