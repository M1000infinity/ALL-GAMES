function TabClass:AddSlider(config)
    local title, desc = ValidateOptionConfig("Slider", config)
    local flag = ValidateFlag("Slider", config[7] or config.Flag)

    local minimum   = config[2] or config.Min
    local maximum   = config[3] or config.Max
    local increment = config[4] or config.Increment
    local default   = config[5] or config.Default
    local callbacks = PackCallback(config[6] or config.Callback)

    if increment ~= nil and type(increment) ~= "number" then
        error(("\"Tab.AddSlider.Increment\". 'number', or 'nil' expected, got " .. tostring(typeof(increment))), 2)
    end
    if default ~= nil and type(default) ~= "number" then
        error(("\"Tab.AddSlider.Default\". 'number', or 'nil' expected, got " .. tostring(typeof(default))), 2)
    end
    assert(type(minimum) == "number", ("\"Tab.AddSlider.Min\", 'number' expected, got " .. tostring(typeof(minimum))))
    assert(type(maximum) == "number", ("\"Tab.AddSlider.Max\", 'number' expected, got " .. tostring(typeof(maximum))))

    local container = TabVisuals[self].Container
    local row, titleLabel, descLabel = MakeOptionRow(self, title, desc, UDim2.new(0.5, 0, 0, 0))

    if default == nil then default = minimum end
    if increment == nil then increment = 1 end
    if flag ~= nil and type(WindowFlags[flag]) == "number" then
        default = WindowFlags[flag]
    end

    local hitArea = NewInstance("TextButton", row, {
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        AnchorPoint = Vector2.new(1, 0),
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Text = ""
    })

    local rail = NewInstance("Frame", hitArea, {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ThemeTag = {
            OBJECTS = TabScopes[self],
            BackgroundColor3 = "Colors.Stroke"
        },
        Elements = {
            Corner = UDim.new(0.5, 0)
        }
    })

    local fill = NewInstance("Frame", rail, {
        Size = UDim2.fromScale(0, 1),
        BorderSizePixel = 0,
        ThemeTag = {
            OBJECTS = TabScopes[self],
            BackgroundColor3 = "Colors.Primary"
        },
        Elements = {
            Corner = UDim.new(0.5, 0)
        }
    })

    local knob = NewInstance("Frame", rail, {
        Size = UDim2.new(0, 14, 0, 14),
        BackgroundTransparency = 0,
        Position = UDim2.fromScale(0, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ThemeTag = {
            OBJECTS = TabScopes[self],
            BackgroundColor3 = "Colors.OnAccent"
        },
        Elements = {
            Corner = UDim.new(0.5, 0),
            Stroke = { Thickness = 2, ThemeTag = { OBJECTS = TabScopes[self], Color = "Colors.Primary" } }
        }
    })

    local valueLabel = NewInstance("TextLabel", hitArea, {
        Size = UDim2.new(0, 52, 0, 14),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(0, -4, 0.5, 0),
        BackgroundTransparency = 1,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        ThemeTag = {
            OBJECTS = TabScopes[self],
            TextColor3 = "Colors.Slider.SliderNumber",
            Font = "Font.SliderValue"
        }
    })

    local valueScale = NewInstance("UIScale", valueLabel)

    local slider = SliderClass.new(self, row, titleLabel, descLabel, callbacks)
    slider.Min = minimum
    slider.Max = maximum
    slider.Increment = increment

    local function toAlpha(value) return (value - minimum) / (maximum - minimum) end
    local function toValue(alpha) return (alpha * (maximum - minimum)) + minimum end
    local function snapToIncrement(value) return math.round(value / increment) * increment end

    local function renderValue(value, alpha, animate)
        valueLabel.Text = tostring(math.floor(value * 1000) / 1000)
        local knobPos = UDim2.fromScale(alpha, 0.5)
        local fillSize = UDim2.fromScale(alpha, 1)
        if animate and self.Selected then
            Tween(knob, "Position", knobPos, 0.18):Play()
            Tween(fill, "Size", fillSize, 0.18):Play()
        else
            knob.Position = knobPos
            fill.Size = fillSize
        end
    end

    local function commitValue(value, alpha)
        if value == slider.Value then return end
        if flag ~= nil then
            WindowFlags[flag] = value
        end
        task.defer(FireCallbacks, callbacks, value)
        slider.Value = value
        renderValue(value, alpha, true)
    end

    local function setValueSafe(value)
        local snapped = math.clamp(snapToIncrement(value), minimum, maximum)
        commitValue(snapped, toAlpha(snapped))
    end

    slider.WHEN_VALUE_CHANGED = setValueSafe

    local function applyCursor(barPos, barSize)
        local alpha = math.clamp((PlayerMouse.X - barPos.X) / barSize.X, 0, 1)
        setValueSafe(toValue(alpha))
    end

    setValueSafe(default)
    renderValue(slider.Value, toAlpha(slider.Value), false)

    Connect(hitArea.MouseButton1Down, function()
        if SharedDragBusy ~= false then return end

        Tween(knob, "Size", UDim2.new(0, 17, 0, 17), 0.15):Play()
        container.ScrollingEnabled = false
        SharedDragBusy = true

        local barPos  = rail.AbsolutePosition
        local barSize = rail.AbsoluteSize

        while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
            applyCursor(barPos, barSize)
            task.wait()
        end

        SharedDragBusy = false
        Tween(knob, "Size", UDim2.new(0, 14, 0, 14), 0.15):Play()
        container.ScrollingEnabled = true
    end)

    -- subtle value pop when the number changes (scale only, no distortion)
    local popDebounce = 0
    Connect(valueLabel:GetPropertyChangedSignal("Text"), function()
        if not self.Selected or not Motion.Enabled then return end
        if (tick() - popDebounce) < 0.12 then return end
        popDebounce = tick()
        valueScale.Scale = 0.6
        Tween(valueScale, "Scale", 1, 0.18):Play()
    end)

    if not self.IsInterfaceTab then
        RegisterOption(self, "Slider", title, desc, row)
    end
    return slider
end

