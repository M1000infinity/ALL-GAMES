-- TOGGLE
--   Section:CreateToggle({Name, Description, Default, Callback})
--   :SetValue(v, silent) · :GetValue() · :Toggle() · :Destroy()
-- ═══════════════════════════════════════════════════════════════════════
MODULES["Toggle"] = function(Env)
	local U = Env.Util
	local Support = Env.Components.Support

	local Toggle = {}
	Toggle.__index = Toggle
	Toggle.__typename = "Toggle"

	function Toggle.new(section, config)
		config = config or {}
		local hasDesc = type(config.Description) == "string" and config.Description ~= ""
		local comp = setmetatable(Support.MakeComponent({
			kind = "Toggle",
			name = config.Name or "Toggle",
			description = config.Description,
			row = nil,
		}), Toggle)

		comp.Callback = config.Callback
		comp.Value = config.Default == true

		local row = Support.Row(section.Content, hasDesc and 54 or 44)
		comp.Row = row

		local title, desc, paintText = Support.Title(row, config.Name or "Toggle", config.Description, 62, hasDesc and 7 or 12)

		local track = U.New("TextButton", {
			Size = UDim2.fromOffset(40, 22),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = Env.Theme:Get().Off or Color3.fromRGB(35, 40, 61),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		U.Corner(track, 11)
		comp.Track = track
		comp:AddDim(track)

		local knob = U.New("Frame", {
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.fromOffset(comp.Value and 21 or 3, 3),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = track,
		})
		U.Corner(knob, 8)
		comp.Knob = knob

		local function position(silent)
			local target = comp.Value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
			if silent then
				knob.Position = target
			else
				U.Tween(knob, 0.14, {Position = target})
			end
		end

		function comp:Paint(palette)
			paintText(palette)
			track.BackgroundColor3 = comp.Value and palette.Accent or (palette.Off or palette.CardHover)
			track.BackgroundTransparency = U.Alpha(palette, 0)
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
		end

		function comp:SetValue(value, silent)
			value = value == true
			local changed = value ~= self.Value
			self.Value = value
			position(silent)
			self:Paint(Env.Theme:Get())
			if changed and not silent and type(self.Callback) == "function" then
				U.SafeCall("Toggle(" .. tostring(self.Name) .. ")", self.Callback, value)
			end
			return value
		end

		function comp:GetValue()
			return self.Value
		end

		function comp:Toggle(silent)
			return self:SetValue(not self.Value, silent)
		end

		function comp:SetVisible(value)
			if self.Destroyed then return end
			self.Visible = value ~= false
			if row then row.Visible = self.Visible end
		end

		function comp:Destroy()
			if self.Destroyed then return end
			self.Destroyed = true
			section:_unregister(self)
			self.Maid:Clean()
			if row then row:Destroy() end
			row = nil
			self.Row = nil
		end

		local connection = track.MouseButton1Click:Connect(function()
			if not comp.Enabled or comp.Destroyed then return end
			comp:Toggle(false)
		end)
		comp.Maid:Add(connection)

		Support.BindTheme(comp, function(palette) comp:Paint(palette) end)
		position(true)
		section:_register(comp)
		if config.Enabled == false then comp:SetEnabled(false) end
		return comp
	end

	return Toggle
end

